 decisions#📝 Benim Notlarım#{2}":[29,30],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟡 Genel Bilgiler (Sarı)":[31,33],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔴 Bulgular (Kırmızı)":[37,39],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/3M8BCKUV","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/75R55Z7B?page=1&annotation=H8T8UWEB","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/75R55Z7B?page=1&annotation=P7GCLE3U","line":38},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/75R55Z7B?page=10&annotation=3WRHNW2Z","line":41},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/75R55Z7B?page=10&annotation=6KCJDM58","line":41}],"metadata":{"Title":"Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions","Authors":"Yi-Tang Chu, Ru-Yi Huang, Tara Tai-Wen Chen, Wei-Hsuan Lin, James TaoQian Tang, Chi-Wei Lin, Chi-Hsien Huang, Chung-Ying Lin, Jung-Sheng Chen, Sabrina Kurtz-Rossi, Kristine Sørensen","Year":2022,"DOI":"10.1177/20552076221136372","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We developed an AI robot intervention prototype with a health literacy-friendly interface that uses interactive voice response (IVR) surveying to assist in decision-making for weight loss.","Findings":"After interacting with the AI robot, 78% of the study population made the decision to lose weight.","Conclusions":"Our findings indicated that our prototype AI Robot can encourage individuals to adopt a healthier lifestyle.In a clinical setting, our AI robot can be used to assist healthcare professionals in patient health education and involve patients in SDM","Limitations":"","User_Notes":"weight-specific health literacy instrument (WSHLI) and Shared Decision-Making Questionnaire (SDMQ) were used to measure factors influencing weight-loss decisions.  prompt ve dyt karşılaştırması yok, gerekli mi doğrulanacak"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"69q5q2","at":1774939656609}},"smart_blocks:chuEffectHealthLiteracy2022a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03343711,-0.00651326,0.00550054,0.02236955,-0.07757303,0.04056757,0.01743781,0.10899673,0.03282788,-0.01096501,-0.00740601,-0.05381316,0.03290647,0.06601653,0.01316805,0.00745848,-0.01839438,0.05555909,-0.03818413,0.04304361,0.06151141,-0.03129881,0.01285218,0.00819324,-0.03204523,-0.01410653,-0.00145664,-0.05287486,-0.03405836,-0.17941244,0.06339304,-0.03790317,0.09396029,-0.04008165,-0.07157348,0.05353106,-0.00891834,0.04144905,-0.04892204,0.02455406,-0.02186804,0.00310696,0.04154175,-0.01618289,0.03329284,-0.02046159,-0.02347095,-0.02888363,-0.09194574,0.01833289,-0.01991589,-0.04562914,0.05475785,0.06400052,0.04998782,0.03745971,0.03469513,0.07905206,0.04856674,0.00921841,0.02787164,0.08900428,-0.19951208,0.09465968,0.028071,0.03094446,-0.07462677,-0.02384941,0.0740837,-0.02917062,0.00173465,0.00339831,0.05947281,0.05459971,0.01075907,0.03347671,0.06636304,-0.07088826,0.04067624,-0.04372338,0.01785126,0.03983873,-0.02739697,-0.00848194,-0.03368286,-0.0100132,0.01325267,-0.09803423,0.00235757,-0.04506429,-0.02195803,-0.02502353,-0.05353732,0.03646836,-0.05151835,-0.02078127,-0.01726428,-0.02946365,-0.11898205,0.12530901,-0.07230623,-0.05485322,-0.00052631,-0.01719516,0.03466059,-0.04184805,-0.02791235,-0.10247963,0.01269509,0.03731808,-0.00248251,-0.02366169,0.06062882,0.02087812,-0.04312479,0.07504831,0.05775446,0.07056239,0.0282088,0.00993048,-0.02933861,0.03874183,0.05885261,0.01841263,-0.00256815,-0.00995561,0.03838226,0.11555122,-0.02308498,-0.03177947,0.13206087,-0.0182875,-0.07937373,0.01067054,-0.0289657,-0.00917387,-0.02358661,-0.01362994