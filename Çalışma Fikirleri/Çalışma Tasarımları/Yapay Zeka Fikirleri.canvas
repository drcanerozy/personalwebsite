		{
			"id":"9d1c9c4954e41391",
			"type":"text",
			"text":"R tabanlı klinik karar verme sistemi. Özellikle yetişkin ve çocuk derslerinde kullanılabilir.",
			"styleAttributes":{"textAlign":"center"},
