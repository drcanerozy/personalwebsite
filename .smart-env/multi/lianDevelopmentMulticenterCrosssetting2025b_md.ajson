,-0.05464104,0.0670758,-0.09312806,0.01941182,0.04202982,0.17111076,-0.06064251,-0.01297025,0.05482522,0.00793634,-0.01818196,0.05216853,-0.01325878,0.01209289,0.00206099,0.09819677,-0.00944383,0.00753573,0.11632183,-0.00377199,0.00606207,-0.02976373,-0.0545895,0.1104242,0.0067626,-0.01637738,-0.04517066,0.11241385,0.00085188,0.01721976,-0.00105129,-0.01916499,-0.01075018,0.05200979,-0.02396763,0.00648199,-0.01267551,0.01508417,-0.04435797,-0.01766402,-0.02304236,-0.02521567,-0.04104707,0.02792252,0.0215577,-0.02078418,0.0576511,-0.04039181],"last_embed":{"hash":"74nhmh","tokens":440}}},"last_read":{"hash":"74nhmh","at":1774939663463},"class_name":"SmartSource","last_import":{"mtime":1774939638564,"size":3693,"at":1774939651574,"hash":"74nhmh"},"blocks":{"#---frontmatter---":[1,18],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features":[20,42],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#{1}":[21,25],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#📝 Benim Notlarım":[26,28],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🟡 Genel Bilgiler (Sarı)":[29,31],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🔴 Bulgular (Kırmızı)":[35,37],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/MT2VZX9M","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FQPNQ3SV?page=1&annotation=BWMJAMZE","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FQPNQ3SV?page=1&annotation=SDL7GBZ8","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FQPNQ3SV?page=1&annotation=6I7VHLIC","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FQPNQ3SV?page=1&annotation=UVMLZCT9","line":39}],"metadata":{"Title":"Development and multi-center cross-setting validation of an explainable prediction model for sarcopenic obesity: a machine learning approach based on readily available clinical features","Authors":"Rongna Lian, Huiyu Tang, Zecong Chen, Xiaoyan Chen, Shuyue Luo, Wenhua Jiang, Jiaojiao Jiang, Ming Yang","Year":2025,"DOI":"10.1007/s40520-025-02975-z","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"Sarcopenic obesity (SO), characterized by the coexistence of obesity and sarcopenia, is an increasingly prevalent condition in aging populations, associated with numerous adverse health outcomes. We aimed to identify and validate an explainable prediction model of SO using easily available clinical characteristics.Five machine learning models (support vector machine, logistic regression, random forest, light gradient boosting machine, and extreme gradient boosting) were used to predict SO. The performance of these models was assessed by the area under the receiver operating characteristic curve (AUC). The SHapley Additive exPlanations (SHAP) approach was used for model interpretation.","Findings":"After feature reduction, an 8-feature model demonstrated good predictive ability. Among the five models tested, the support vector machine (SVM) model performed best in SO prediction in both internal (AUC=0.862) and external (AUC=0.785) validation sets","Conclusions":"This model offers a novel, accessible, and interpretable approach to SO prediction with potential to enhance early detection and intervention strategies.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"74nhmh","at":1774939663322}},"smart_blocks:lianDevelopmentMulticenterCrosssetting2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02825652,-0.03178528,0.00235086,0.03887997,-0.00263945,0.04743921,-0.05666389,0.04663865,0.00651853,-0.01185752,0.05137837,-0.09032525,-0.02885761,0.01378488,0.06983566,0.01138296,0.00966106,0.04087835,-0.03658187,-0.00321558,0.02740088,0.01402131,-0.01161158,-0.00729591,0.06599329,0.00084778,0.02632861,0.00317593,-0.08531842,-0.26109129,0.03398937,-0.059