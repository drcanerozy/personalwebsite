-0.0520741,0.03911514,0.04550466,-0.25582814,0.07734286,-0.04210524,-0.0098352,0.00301961,-0.03129581,0.00527113,-0.02633432,-0.02357598,-0.01795389,0.0530513,-0.01229918,0.09616709,-0.05612034,-0.00603285,0.00650532,0.01408814,-0.03440895,0.0060039,-0.0822768,0.04503991,-0.01842818,0.17578064,-0.02574045,0.0179921,0.01523673,-0.04067393,-0.04403569,-0.0014689,0.01584987,0.0116209,0.01331331,0.10742689,0.00542784,0.03263983,0.00778902,-0.0209512,-0.02306379,-0.0251327,-0.01070356,0.03313604,-0.00957173,-0.0420114,-0.03405004,0.08646627,0.0020503,-0.00787332,-0.08479749,0.00103714,0.00104579,-0.00046629,0.02422579,-0.01066661,0.00789375,0.06058896,-0.04530158,-0.01523664,0.00992696,0.03155035,-0.00450556,0.02205959,0.0336803,-0.00240646,0.06217518,-0.04045537],"last_embed":{"hash":"q474b2","tokens":462}}},"last_read":{"hash":"q474b2","at":1773768758587},"class_name":"SmartSource","last_import":{"mtime":1773768745469,"size":5137,"at":1773768758477,"hash":"q474b2"},"blocks":{"#---frontmatter---":[1,18],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation":[20,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#{1}":[21,25],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#📝 Benim Notlarım":[26,28],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)":[35,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)":[41,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RWZCNDZU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=S7R4IZHN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=6DKKWP9Z","line":36},{"title":"Sayfa 4","target":"zotero://open-pdf/library/items/RKBFCLYY?page=4&annotation=9LFSML73","line":42}],"metadata":{"Title":"Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation","Authors":"Lin-Chun Wang, Hanjie Zhang, Nancy Ginsberg, Andrea Nandorine Ban, Jeroen P. Kooman, Peter Kotanko","Year":2024,"DOI":"10.1053/j.jrn.2024.09.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We tasked ChatGPT-4 with generating a personalized daily meal plan, including nutritional information. Virtual ‘‘patients’’ were generated through Monte Carlo simulation; data from a randomly selected virtual patient were presented to ChatGPT. We provided to ChatGPT patient demographics, food preferences, laboratory data, clinical characteristics, and available budget, to generate a oneday sample menu with recipes and nutritional analyses. The resulting daily recipe recommendations, cooking instructions, and nutritional analyses were reviewed and rated on a five-point Likert scale by an experienced renal dietitian. In addition, the generated content was rated by a renal dietitian and compared with a U. S. Department of Agriculture–approved nutrient analysis software. ChatGPT also analyzed nutrition information of two recipes published online. We also requested a translation of the output into Spanish, Mandarin, Hungarian, German, and Dutch.","Findings":"The renal dietitian rated the recipes at 3 (3, 3) [median (Q1, Q3)], the cooking instructions at 5 (5,5), and the nutritional analysis at 2 (2, 2) on the five-point Likert scale. ChatGPT’s nutritional analysis underestimated calories by 36% (95% CI: 44-88%), protein by 28% (25-167%), fat 48% (29-81%), phosphorus 54% (15-102%), potassium 49% (40-68%), and sodium 53% (14-139%). The nutritional analysis of online available recipes differed only by 0 to 35%. The translations were rated as reliable by native speakers (4 on the five-point Likert scale).","Conclusions":"","Limitations":"LLMs like ChatGPT show promise for providing personalized nutritional guidance to dialysis patients, but significant improvements are necessary. At present, ChatGPT’s nutritional recommendations are not a substitute for personalized medical advice. However, it can be a useful tool for generating meal plans that renal dietitians can then evaluate and adjust according to reference values from validated sources.","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"q474b2","at":1773768758482},"key":"Augmented Dietitian Okunmuşlar/Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation.md"},
