-0.02398775,0.06542788,-0.10101222,-0.00198296,0.03287368,0.18424515,-0.10238036,-0.05922252,0.03342462,0.02825063,-0.09636325,0.02447606,0.02426811,0.0380163,0.0011113,0.09776918,0.02047974,0.01168976,0.07699614,-0.00831946,-0.02019602,-0.03735205,-0.00373427,0.06761406,-0.00481431,-0.0268837,-0.00842434,0.08668108,-0.0341085,0.0370672,-0.02169118,-0.00218915,-0.03933828,0.01175625,-0.00941708,-0.02517901,0.03019895,0.05872602,0.02463728,-0.01317391,-0.02400437,-0.03006558,-0.0016024,0.01377667,-0.0122833,-0.01936493,0.0690973,-0.0384865],"last_embed":{"hash":"o8yp6x","tokens":418}}},"last_read":{"hash":"o8yp6x","at":1778067900968},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3332,"at":1778067900969,"hash":"o8yp6x"},"blocks":{"#---frontmatter---":[1,18],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living":[20,42],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#{1}":[21,25],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#📝 Benim Notlarım":[26,28],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🟡 Genel Bilgiler (Sarı)":[29,31],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🔴 Bulgular (Kırmızı)":[35,37],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/FLWY2RH3","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/DEH77L6B?page=1&annotation=SQERZ8MS","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/DEH77L6B?page=1&annotation=BJ7KC4Y2","line":36},{"title":"Sayfa 11","target":"zotero://open-pdf/library/items/DEH77L6B?page=11&annotation=TQKVM425","line":39}],"metadata":{"Title":"FVEstimator: A novel food volume estimator Wellness model for calorie measurement and healthy living","Authors":"Prachi Kadam, Sharnil Pandya, Shraddha Phansalkar, Mayur Sarangdhar, Nayana Petkar, Ketan Kotecha, Deepak Garg","Year":2022,"DOI":"10.1016/j.measurement.2022.111294","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"background. In this work, mask-based RCNN is employed that helps accurate segmentation of food images with regular and irregular shapes in multi-food dish scenarios. The RCNN based food segmentation is applied as a volume estimator model. It is developed by fine-tuning the pre-trained ResNet model and trained over a dataset of 8 different classes of Indian breakfast food images in all shape","Findings":"The estimator model yields a precision of 90.9% for convex-shaped food images, 90.46% for amorphous food images in regular serving containers, and 98.5% to 98.9% for regular shaped (square and circle) food items.","Conclusions":"The work opens the research opportunities in images-based automated food volume estimation using deep learning methods. This will help enhance automatic image-based dietary monitoring systems, which will help the patients, athletes, weight-watchers, etc., to record their diet and maintain a healthy lifestyle by tracking the calorie count by correctly identifying and estimating the portion size of the food they are eating.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"o8yp6x","at":1774939755404},"key":"Augmented Dietitian/kadamFVEstimatorNovelFood2022a.md"},
