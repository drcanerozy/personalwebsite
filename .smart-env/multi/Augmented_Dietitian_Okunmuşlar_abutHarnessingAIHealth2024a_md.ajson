6165399,-0.02455764,0.00569863,-0.0692473,0.01569128,0.03772183,0.16134979,-0.09286053,0.01786951,0.05782957,0.02650601,-0.03568686,0.0561403,-0.01177504,0.03804253,-0.00680256,0.0966818,0.00823733,0.06529444,0.13425574,-0.03663263,-0.04186559,0.0327927,-0.0265014,0.061069,-0.01085476,-0.00301692,0.00446993,0.08856019,-0.01919383,-0.00382183,-0.04540652,-0.06290425,0.01605382,-0.00561584,0.02078801,-0.00327411,-0.00787965,0.02546835,0.00034536,-0.00063628,-0.03469622,-0.05363227,-0.03680024,0.05502394,0.00055836,0.0061946,0.03384477,-0.07699173],"last_embed":{"hash":"1vqd94g","tokens":398}}},"last_read":{"hash":"1vqd94g","at":1774939537002},"class_name":"SmartSource","last_import":{"mtime":1774939523240,"size":3280,"at":1774939536665,"hash":"1vqd94g"},"blocks":{"#---frontmatter---":[1,18],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction":[20,42],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#{1}":[21,25],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#📝 Benim Notlarım":[26,28],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟡 Genel Bilgiler (Sarı)":[29,31],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔴 Bulgular (Kırmızı)":[35,37],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/ES4E88FQ","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CHWKEDVN?page=1&annotation=2IVUFX9Y","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CHWKEDVN?page=1&annotation=7MASVE96","line":36},{"title":"Sayfa 13","target":"zotero://open-pdf/library/items/CHWKEDVN?page=13&annotation=P9YDWCLS","line":39}],"metadata":{"Title":"Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction","Authors":"Fatih Abut, Ezgi Akça, Mehmet Fatih Akay, Mustafa Irmak, Müzda Irmak, Yildirim Adigüzel","Year":2024,"DOI":"10.1109/ACCESS.2024.3477326","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aims to develop new models for predicting RMR using General Regression Neural Network (GRNN). Additionally, prediction models based on Multi-Layer Perceptron (MLP) will be created for comparison purposes","Findings":"prediction. The GRNN-based models performed better than the ones built by MLP, demonstrating its feasibility as a tool for predicting RMR accurately. The results have also been compared with up-to-date prediction equations from related literature, and our optimized models perform significantly better than those. The proposed best performing GRNN model achieved an R value of 0.85, RMSE of 134.91 kcal/day, and MAPE of 10.20%, significantly outperforming traditional predictive equations such as the Harris-Benedict and Mifflin-St Jeor equations, which showed RMSE values above 400 kcal/day and MAPE values exceeding 12.5%.","Conclusions":"Consequently, the developed software offers dietitians a valuable tool for accurately calculating the RMR of their patients, thereby enhancing personalized dietary planning and wellness management.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1vqd94g","at":1774939536776}},"smart_blocks:Augmented Dietitian Okunmuşlar/abutHarnessingAIHealth2024a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04525864,0.00192685,-0.02050857,0.01896713,0.01294057,0.02420585,-0.04149045,0.05146259,0.03796468,-0.02100092,-0.0156971,-0.09093305,0.00908521,0.06994166,0.02971746,-0.03560605,0.01435057,0.02115254,0.02424353,-0.03753265,0.05910107,-0.02134051,0.02128112,-0.04453137,0.04779356,-0.00643827,-0.02350924,-0.01282888,-0.06239194,-0.23802327,0.02210793,-0.05304042,0.0650558,-0.009037,-0.07896684,0.03237536,0.02018107,0.03800094,-0.06057916,0.06726003,0.01115446,0.01854305,0.01555667,-0.00943838,0.07434598,0.00918346,-0.03528726,-0.04324726,-0.06499325,-0.02533262,-0.02191881,-0.01902412,0.04148966,0.033991,0.02387471,0.00641402,0.02563436,0.06299151,0.01302659,0.07874421,-0.01657589,0.07250174,-0.22363427,0.03696453,-0.00238135,0.03231001,-0.06963102,-0.00309757,0.00328195,0.01867613,-0.02257738,-0.00053503,0.01230223,-0.01788457,-0.02577545,0.04459228,0.08126933,-0.00776906,-0.00828759,0.00562612,0.03682445,0.06715485,-0.02777384,-0.0560005,0.02872284,0.00469938,-0.00810067,-0.04481565,0.01722635,-0.03999756,-0.03298751,-0.03304885,0.00161267,0.01879991,-0.00922154,0.01709405,0.03477535,0.0053691,-0.10717829,0.10165345,-0.01957021,0.00741357,-0.01293206,-0.00572226,0.0485575,-0.05228355,-0.06926414,-0.00227612,-0.01934109,-0.00493451,-0.01811359,0.00463526,0.00618311,-0.01151371,0.00630805,0.01950245,0.08894511,0.04032196,0.0116955,0.00950156,-0.04538313,-0.03212173,0.05430872,0.05289065,0.00408659,-0.00336606,-0.02181137,0.09693275,0.01015099,0.01166083,0.07303829,0.01286205,-0.06799571,-0.02695922,0.02292765,-0.03066402,0.06906629,-0.01543732,-0.0187051,0.00049914,-0.06081