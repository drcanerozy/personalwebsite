1,0.04480812,0.16590062,-0.06764407,-0.04881704,0.03252162,0.00820471,-0.06972369,0.04710208,0.03575031,0.02040147,-0.00607388,0.10117435,-0.01086106,-0.00545679,0.13269098,-0.02826388,-0.05641384,0.00878951,0.01770955,0.04349212,-0.01895406,-0.03822912,-0.04447877,0.08893035,-0.02108014,0.05431651,-0.04397221,-0.01516091,-0.00841358,-0.01192647,-0.06186125,-0.02917129,0.01214753,0.06949946,-0.00757946,-0.0107251,-0.0121214,-0.04733624,-0.02065579,0.04729507,-0.03994004,0.00409227,0.05813492,-0.07330498],"last_embed":{"hash":"gdz2f7","tokens":462}}},"last_read":{"hash":"gdz2f7","at":1774939658757},"class_name":"SmartSource","last_import":{"mtime":1774939638480,"size":3270,"at":1774939651558,"hash":"gdz2f7"},"blocks":{"#---frontmatter---":[1,18],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS":[20,42],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#{1}":[21,25],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#📝 Benim Notlarım":[26,28],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🟡 Genel Bilgiler (Sarı)":[29,31],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🔴 Bulgular (Kırmızı)":[35,37],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/N8J6S5TC","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CZCB9Z53?page=1&annotation=74HS5754","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CZCB9Z53?page=1&annotation=AHZI3RGX","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CZCB9Z53?page=1&annotation=SMGTDBDU","line":39}],"metadata":{"Title":"FOOD RECOGNITION AND NUTRITION FACTS DETERMINATION WITH DEEP CONVOLUTION NEURAL NETWORK MODELS","Authors":"","Year":2023,"DOI":"10.34302/SI/236","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"preferences. The objective of this research was to develop software capable of recognizing and predicting the nutritional information of commonly consumed fruits and vegetables in Turkey. Basic nutrition data for each food item was collected and organized. A dataset comprising 9,000 food images was gathered, encompassing 200 images for each food item.  To train the images, deep learning (DL) algorithms such as GoogleNet, ResNet-50, and Inception-v3 were utilized on platforms like Matlab and .NET Core. Additionally, 900 food images were reserved for external validation purposes.","Findings":"The DL algorithms achieved excellent accuracy, with all models surpassing 98.3% accuracy in predicting food categories.  Notably, the Inception-v3 algorithm outperformed the others, achieving an accuracy of 99.1% during the testing phase. Consequently, the Inception-v3 algorithm was chosen to develop software for food recognition and nutrition analysis, intended for both computers and smartphones.","Conclusions":"The system can effectively track the types and quantities of foods consumed, providing personalized feedback to both patients and healthcare providers","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"gdz2f7","at":1774939658618}},"smart_blocks:FOODRECOGNITIONNUTRITION2023.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04593802,-0.00833563,-0.00709649,-0.01255691,0.06066202,0.03096468,0.00697839,0.00794653,0.00109057,-0.00989112,-0.00076097,-0.12018958,0.03320849,0.01754748,0.05325677,-0.04096124,0.04675056,0.02414539,-0.02547839,-0.02362086,0.07872885,-0.02090708,-0.01833549,-0.02365503,0.0778512,0.00478069,-0.01613566,-0.04646679,-0.05951414,-0.23355161,0.06382746,-0.05242844,0.10481381,-0.03489295,-0.01617994,-0.00759711,0.01670257,0.02964743,-0.07532204,0.00022634,0.04702653,-0.01042613,0.02422927,-0.008091,-0.0284461,-0.0445159,-0.06515453,-0.02639081,-0.01912699,-0.04558829,-0.02003123,-0.02132396,-0.00493534,0.04093711,0.01416814,0.05654052,0.0435229,0.01611832,0.08787793,0.05222286,0.06041776,0.06957908,-0.18566494,0.0547074,0.02417135,0.03013129,-0.03442362,-0.01200372,0.00362242,-0.02360905,-0.00310206,0.04724179,0.05677294,0.02009263,0.00559285,0.00416102,0.06603862,-0.01531375,-0.0515051,-0.04561606,-0.00564034,0.1080054,-0.00107912,-0.02512385,-0.02403069,-0.03984597,-0.00876992,-0.00907656,0.03609283,-0.03294434,-0.01998182,-0.0348678,-0.00674388,0.0091658,-0.02454081,-0.01791042,-0.02958673,-0.05544117,-0.05183158,0.10283601,-0.05297839,-0.01065779,-0.00783496,-0.04370685,0.02668484,-0.02720359,-0.05464005,-0.03078879,-0.02406605,0.08692628,-0.03845966,0.004709,-0.026401,0.01844608,0.00702654,0.03783102,0.07390883,0.01039172,0.02387945,-0.02696345,-0.03472507,0.01156517,0.04998421,-0.01263035,0.03020634,0.02833728,-0.01258313,0.08173528,0.01267184,0.0439914,0.0981466,-0.00138248,-0.11016386,-0.02150168,0.00710751,0.05361076,0.08911916,-0.00265604,-0.05817812,0.01948301,-0.04848886,0.03509916,0.04854899,-0.0808022,-0.08090392,0.16001385,0.00286277,0.02613695,-0.