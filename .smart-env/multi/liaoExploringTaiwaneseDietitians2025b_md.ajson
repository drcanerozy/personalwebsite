1834,0.01736758,0.00887163,0.17609945,-0.01926554,0.02593245,0.03811731,-0.00699793,-0.05652504,0.05654701,-0.00625337,-0.01796695,-0.00330014,0.13952756,-0.01729564,0.04710824,0.01823665,-0.01220463,-0.03449914,-0.05118778,-0.0437733,0.06420824,0.01976123,-0.02168362,-0.05776733,0.10240958,-0.02103949,0.00096643,-0.04982003,-0.0052724,0.00078135,0.0114334,0.01824042,0.01492201,-0.00730275,0.01867024,-0.028327,-0.00593369,0.00238407,-0.02971499,-0.04851946,0.03190851,-0.01852492,-0.01650553,0.09740936,0.01309542],"last_embed":{"hash":"upys66","tokens":502}}},"last_read":{"hash":"upys66","at":1774939664100},"class_name":"SmartSource","last_import":{"mtime":1774939638566,"size":3439,"at":1774939651577,"hash":"upys66"},"blocks":{"#---frontmatter---":[1,18],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey":[20,42],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#{1}":[21,25],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#📝 Benim Notlarım":[26,28],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟡 Genel Bilgiler (Sarı)":[29,31],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔴 Bulgular (Kırmızı)":[35,37],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/GKG5VPAE","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FC9GM34J?page=1&annotation=7BG8WWCF","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FC9GM34J?page=1&annotation=SR3VQ7EL","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FC9GM34J?page=1&annotation=PUFF46B3","line":39},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/FC9GM34J?page=9&annotation=GG792AJU","line":39}],"metadata":{"Title":"Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey","Authors":"Li‐Ling Liao, I‐Ju Lai, Li‐Chun Chang","Year":2025,"DOI":"10.1111/jhn.70108","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We investigated Taiwanese dietitians' attitudes and usage of ChatGPT using the technology acceptance model (TAM) and identified factors influencing intention and behaviour.","Findings":"Of the 497 respondents (mean age = 38.5 years; 88.6% female), 59.8% had used ChatGPT, primarily for administrative documentation. Younger dietitians with higher educational levels and hospital‐based roles were more likely to use ChatGPT. Among non‐users, subjective norms and technology or social influence significantly predicted the intention to adopt ChatGPT. Among users, job relevance, self‐efficacy, and perceived risk were key predictors of usage frequency.","Conclusions":"The study highlights the necessity to amplify positive environmental influences through awareness campaigns, societal endorsements, and institutional support to enhance ChatGPT integration in dietetic practice.practice. Its findings indicate that although a significant percentage of dietitians have experience using ChatGPT, adoption for professional tasks remains limited, primarily because of concerns regarding AI‐generated information's accuracy and trustworthiness","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"upys66","at":1774939663943}},"smart_blocks:liaoExploringTaiwaneseDietitians2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[0.00861156,0.04670963,-0.00201976,-0.04653499,0.00109103,0.02286685,0.05865934,0.06101246,0.02635518,-0.02789411,0.021869,-0.08991508,0.01996071,0.01191614,0.0447423,0.02161522,-0.00258185,-0.04473848,0.00227862,0.00233199,0.00246621,-0.06007949,0.08526646,-0.02293131,0.02606769,-0.00568344,-0.03358109,-0.04130946,-0.0381436,-0.19333282,0.02130226,0.01333124,0.06380624,-0.01741733,-0.10518339,0.02618137,-0.03643763,0.00571338,-0.03356129,0.00264497,-0.01508888,0.03233884,0.01500873,-0.00032841,-0.04873086,-0.06655358,-0.01748424,-0.02667188,-0.11516672,0.00226912,0.00288952,-0.03074017,0.03925294,0.04771138,0.00732976,0.04878901,0.02548046,0.03904319,-0.02726148,0.0389513,0.02616511,0.05333912,-0.2371127,0.10393493,0.00285424,0.050139,-0.0603068,0.06046631,0.01516332,-0.05493002,-0.05969239,0.01580035,-0.01064266,0.07075839,0.0533815,0.02997519,0.04396183,-0.05867366,0.01818536,-0.05684926,0.00883616,0.10587905,0.00684325,-0.0199061,-0.03200999,-0.01936419,0.00420973,-0.02884273,0.02250243,-0.01025393,-0.01010938,-0.03352657,-0.01091848,-0.02670937,-0.00670935,-0.00849518,0.00725012,0.01692209,-0.07603581,0.09873687,-0.0671052,0.0104803,-0.0302028,0.05360238,0.0282205,-0.03554035,0.00895067,-0.05665042,0.00903095,0.06630243,-0.03836169,-0.00011063,0.01586724,0.00560814,-0.02860184,0.07664452,0.06097417,0.00097178,0.04711845,0.00550254,-0.04890111,0.057