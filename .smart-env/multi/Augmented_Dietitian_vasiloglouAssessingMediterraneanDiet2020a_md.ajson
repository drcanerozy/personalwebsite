8,0.00180921,0.02928819,-0.00413817,0.03196035,-0.10986166,0.02048808,0.01664931,0.17342035,-0.1153665,-0.08083866,0.06600913,-0.00191985,-0.05528501,0.00851076,0.02371779,-0.02502646,0.0219247,0.08669449,0.02852463,0.02074472,0.059515,-0.05527334,-0.01905915,-0.02009347,-0.02730493,0.04296991,0.0034924,-0.00798497,-0.01600132,0.092365,-0.01895387,0.03837207,-0.03505874,-0.01808742,0.03223271,-0.00521303,-0.06394117,-0.02457206,0.02810165,0.01956156,-0.00536581,-0.01804753,-0.0126503,-0.0044086,-0.00630196,0.04001981,0.00523495,0.00329092,0.02819824,-0.04360444],"last_embed":{"hash":"gbdbq8","tokens":426}}},"last_read":{"hash":"gbdbq8","at":1778067901016},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3032,"at":1778067901016,"hash":"gbdbq8"},"blocks":{"#---frontmatter---":[1,18],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project":[20,42],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#{1}":[21,25],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#📝 Benim Notlarım":[26,28],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🟡 Genel Bilgiler (Sarı)":[29,31],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🔴 Bulgular (Kırmızı)":[35,37],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/6CSAJRJL","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/JWEM33B4?page=1&annotation=H5WTQXKN","line":33},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/JWEM33B4?page=10&annotation=XS87QF4J","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/JWEM33B4?page=1&annotation=GVQ5BINI","line":36}],"metadata":{"Title":"Assessing Mediterranean Diet Adherence with the Smartphone: The Medipiatto Project","Authors":"Maria F. Vasiloglou, Ya Lu, Thomai Stathopoulou, Ioannis Papathanail, David Faeh, Arindam Ghosh, Manuel Baumann, Stavroula Mougiakakou","Year":2020,"DOI":"10.3390/nu12123763","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"In the current manuscript, we propose an automated smartphone application which monitors and evaluates the user’s adherence to MD using images of the food and drinks that they consume.  We define a set of rules for automatic adherence estimation, which focuses on the main MD food groups. We use a combination of a convolutional neural network (CNN) and a graph convolutional network to detect the types of foods and quantities from the users’ food images and the defined set of rules to evaluate the adherence to MD.In this paper, we present a novel system that can be used to monitor the user’s diet, quantify their intake, and assess their adherence to MD","Findings":"Our experiments show that our system outperforms a basic CNN in terms of recognizing food items and estimating quantity and yields comparable results as experienced dietitians when it comes to overall MD adherence estimation.","Conclusions":"","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"gbdbq8","at":1774939742795},"key":"Augmented Dietitian/vasiloglouAssessingMediterraneanDiet2020a.md"},
