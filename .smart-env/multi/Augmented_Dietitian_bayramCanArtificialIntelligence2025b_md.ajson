1,-0.04399534,0.02966241,-0.1034431,-0.00415794,0.02413161,0.19458537,-0.0577276,0.01351158,0.05626536,0.01417213,-0.03835378,0.0396858,-0.00498235,0.00570272,0.01795533,0.10727336,-0.01280021,0.03188562,0.06546609,-0.02253774,-0.04865918,-0.03559387,-0.01007768,0.02983093,0.02786528,-0.02248268,-0.03747694,0.0886102,0.00227235,-0.02605388,-0.05046658,-0.0276886,-0.00731248,0.01369678,-0.00877066,-0.01530717,-0.00255449,0.04853925,-0.03196499,-0.00496447,0.02811322,-0.02104576,-0.05144561,0.03129635,-0.02422284,-0.02809609,0.11602776,-0.05003867],"last_embed":{"hash":"3ooy29","tokens":432}}},"last_read":{"hash":"3ooy29","at":1778067901122},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3502,"at":1778067901123,"hash":"3ooy29"},"blocks":{"#---frontmatter---":[1,18],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?":[20,42],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#{1}":[21,25],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#📝 Benim Notlarım":[26,28],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟡 Genel Bilgiler (Sarı)":[29,31],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔴 Bulgular (Kırmızı)":[35,37],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/27APW4AP","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=3IW7MBGN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=MSK8DKDS","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=N5XFYJL9","line":39}],"metadata":{"Title":"Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?","Authors":"Hatice Merve Bayram, Zehra Margot Çelik, Hatice Kübra Barcın Güzeldere","Year":2025,"DOI":"10.1177/02601060251329070","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"A comparative content analysis was conducted using ChatGPT-4o, and ChatGPT-4 to generate 1800 kcal daily diet plans for a 20-year-old female with obesity. AI models provided recommendations for dietary management, the nutrition care process, and menu planning. Three dietitians evaluated the outputs","Findings":"ChatGPT-generated menus were inconsistent with dietary recommendations. Both ChatGPT-4o and ChatGPT-4 offered 5-day menu samples with low calorie content of “1800 kcal prompt” compared to the TDG-2022 (P < 0.001 for ChatGPT-4o). Additionally, key nutrients, particularly fats (P = 0.003), carbohydrates (%), potassium, and calcium (P < 0.05 for all) were inadequately compared to the TDG-2022. Nutrient analysis revealed that both models underperformed in meeting recommended intakes for critical micronutrients such as calcium, and had an unbalanced distribution of macronutrients","Conclusions":"ChatGPT-4o and ChatGPT-4 have limitations when used to provide accurate dietary management.  While AI chatbots offer useful insights, they cannot replace expertise of dietitians in clinical planning; as a result, caution is advised when using these tools in this context.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"3ooy29","at":1774939763536},"key":"Augmented Dietitian/bayramCanArtificialIntelligence2025b.md"},
