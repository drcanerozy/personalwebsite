-0.05209197,0.03459319,-0.0534431,0.03040677,0.00484201,0.18114066,-0.01212878,0.01041227,0.02722316,0.01412095,-0.01059678,0.05352405,-0.04356985,-0.00304892,0.03052874,0.12210026,0.01484609,0.01880471,0.05524262,-0.02205488,-0.00325191,-0.02275507,-0.01658987,0.06332104,0.01487283,-0.01132955,-0.0290425,0.0978499,0.00807934,-0.02672191,-0.08486866,-0.008378,0.00035889,-0.01355757,0.02045959,0.02640752,-0.01541885,-0.0027439,-0.03984477,-0.00919173,-0.01362356,-0.03132722,-0.03835209,0.01934617,-0.00456495,0.01712006,0.1183672,-0.02404181],"last_embed":{"hash":"17bwf4p","tokens":427}}},"last_read":{"hash":"17bwf4p","at":1778067901106},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":4263,"at":1778067901107,"hash":"17bwf4p"},"blocks":{"#---frontmatter---":[1,18],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives":[20,42],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#{1}":[21,25],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#📝 Benim Notlarım":[26,28],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🟡 Genel Bilgiler (Sarı)":[29,31],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🟡 Genel Bilgiler (Sarı)#{1}":[30,31],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🔴 Bulgular (Kırmızı)":[35,37],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🟠 Limitasyonlar (Turuncu)":[41,42],"#Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/VL9LGH9L","line":22},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/EAM9QYTW?page=10&annotation=9UWEHFJ8","line":30},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/EAM9QYTW?page=1&annotation=CY3F83QG","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/EAM9QYTW?page=1&annotation=PGRZTJML","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/EAM9QYTW?page=1&annotation=PGYRCNKR","line":39},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/EAM9QYTW?page=9&annotation=RKGV9FZ4","line":39},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/EAM9QYTW?page=10&annotation=772UM8VW","line":42}],"metadata":{"Title":"Assessing the Quality of ChatGPT’s Dietary Advice for College Students from Dietitians’ Perspectives","Authors":"Li-Ling Liao, Li-Chun Chang, I-Ju Lai","Year":2024,"DOI":"10.3390/nu16121939","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"Methods: ChatGPT’s performance on dietary advice was evaluated by 30 experienced dietitians and assessed using an objective nutrition literacy (NL) test. The dietitians were recruited to assess the quality of ChatGPT’s dietary advice, including its NL achievement and response quality.","Findings":"The results indicate that ChatGPT’s performance varies across scenarios and is suboptimal for achieving NL with full achievement rates from 7.50% to 37.56%. While the responses excelled in readability, they lacked understandability, practicality, and completeness. In the NL test, ChatGPT showed an 84.38% accuracy rate, surpassing the NL level of Taiwanese college students. The top concern among the dietitians, cited 52 times in 242 feedback entries, was that the “response information lacks thoroughness or rigor, leading to misunderstandings or misuse”","Conclusions":"This study highlights the need for improved AI educational approaches and suggests the potential for developing ChatGPT teaching guides or usage instructions to train college students and support dietitians.These findings underscore AI’s potential as a supplementary tool in nutrition education but also emphasize the need to enhance its performance to manage nuanced and personalized dietary inquiries.","Limitations":"Additionally, the potential misunderstanding of this technology by the dietitians may have introduced bias into their response","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"17bwf4p","at":1774939753075},"key":"Augmented Dietitian/liaoAssessingQualityChatGPTs2024a.md"},
