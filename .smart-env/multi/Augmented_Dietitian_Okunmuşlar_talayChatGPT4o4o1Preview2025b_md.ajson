,-0.00159399,0.03534556,-0.00840603,0.02038652,-0.10358608,0.01665322,-0.01099327,0.15537918,-0.05092561,0.00373866,0.08379828,-0.01026252,-0.01744615,-0.0141731,0.02675595,-0.00163794,0.01556518,0.10980172,0.00756182,0.05115653,0.03098065,-0.05275293,0.01003254,-0.01430636,0.01240098,0.05477218,-0.00728437,-0.01223451,-0.03687833,0.13152829,0.00788627,0.00898508,-0.05662122,-0.00882461,0.0090447,-0.01227147,-0.02886942,-0.01425071,0.02577222,0.03633078,-0.02639749,-0.00534978,0.01219876,0.00833682,-0.0197768,0.03048213,-0.00600937,0.01686903,0.08406179,-0.03483932],"last_embed":{"hash":"1cxljgw","tokens":454}}},"last_read":{"hash":"1cxljgw","at":1774939557199},"class_name":"SmartSource","last_import":{"mtime":1774939523888,"size":3867,"at":1774939536764,"hash":"1cxljgw"},"blocks":{"#---frontmatter---":[1,18],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis":[20,42],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#{1}":[21,25],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#📝 Benim Notlarım":[26,28],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🟡 Genel Bilgiler (Sarı)":[29,31],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🔴 Bulgular (Kırmızı)":[35,37],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/UYLB4QJK","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/EI8GPZB8?page=1&annotation=NK54DFBZ","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/EI8GPZB8?page=1&annotation=UJ5EUTTB","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/EI8GPZB8?page=1&annotation=C2WL6N9V","line":39},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/EI8GPZB8?page=10&annotation=KMIUVE7C","line":39}],"metadata":{"Title":"ChatGPT-4o and 4o1 Preview as Dietary Support Tools in a Real-World Medicated Obesity Program: A Prospective Comparative Analysis","Authors":"Louis Talay, Leif Lagesen, Adela Yip, Matt Vickers, Neera Ahuja","Year":2025,"DOI":"10.3390/healthcare13060647","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study compared responses of two ChatGPT-4o models to those from human dietitians across 10 complex questions (5 broad; 5 narrow) derived from patient–clinician interactions within a real-world medicated digital weight loss service","Findings":"Investigators found that neither ChatGPT-4o nor Chat GPT-4o1 preview were statistically outperformed (p < 0.05) by human dietitians on any of the study’s 10 questions. The same finding was made when scores were aggregated from the ten questions across the following four individual study criteria: scientific correctness, comprehensibility, empathy/relatability, and actionability.","Conclusions":"These results provide preliminary evidence that advanced LLMs may be able to play a significant supporting role in medicated obesity services.They should not, however, be interpreted as evidence that such LLMs can safely replace dietitians or clinical decision makers in DWLSs, as the study did not simulate the back-and-forth dialogue and nuanced decision making that characterize real-world patient–clinician interactions. To better approximate these interactions, future studies should incorporate multi-shot LLM prompting, fine-tuned models trained on patient-dietitian exchanges, and reinforcement learning techniques that adapt to complex consultations","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1cxljgw","at":1774939557020}},"smart_blocks:Augmented Dietitian Okunmuşlar/talayChatGPT4o4o1Preview2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04602801,0.01476698,-0.00340868,0.01582216,-0.01665827,-0.01479412,-0.02267301,0.04623774,0.00653263,-0.0353921,-0.01162393,-0.06061998,0.01666538,0.04271053,0.08911895,0.002606,0.0428695,-0.0203215,-0.04594967,0.0615726,0.03778198,-0.0622518,0.03087936,0.03416692,0.02198051,0.01134357,-0.01973032,-0.02480439,-0.04633232,-0.23581356,0.04144942,-0.00619096,0.07235313,-0.0169908,-0.08911112,0.0605155,0.00050802,0.02791883,-0.05164225,0.01784086,0.04574669,0.02619043,0.02223929,-0.01367255,-0.01330908,-0.04930261,-0.04980125,-0.01636347,-0.09154661,0.01607117,0.01948239,-0.00820263,0.01367205,0.07157324,0.02774697,0.0036309,0.02755401,0.02935786,0.01206616,0.05977058,0.04690337,0.05240501,-0.23437256,0.10782831,0.01467946,0.02879698,-0.05347835,0.0294803,0.01798374,-0.01248284,-0.06533785,-0.02960899,0.00231926,0.02124607,0.01586984,0.0