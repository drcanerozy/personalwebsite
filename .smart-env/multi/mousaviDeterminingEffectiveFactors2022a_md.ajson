":[39,40],"#Determining the effective factors in predicting diet adherence using an intelligent model#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/TPCIRV65","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/WIXNTIHY?page=1&annotation=D9CCKXRR","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/WIXNTIHY?page=1&annotation=DTCPTS4X","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/WIXNTIHY?page=1&annotation=GJ99L8D8","line":39}],"metadata":{"Title":"Determining the effective factors in predicting diet adherence using an intelligent model","Authors":"Hediye Mousavi, Majid Karandish, Amir Jamshidnezhad, Ali Mohammad Hadianfard","Year":2022,"DOI":"10.1038/s41598-022-16680-8","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aimed to predict adherence to the prescribed diets using a hybrid model of artificial neural networks (ANNs) and the genetic algorithm (GA). In this study, 26 factors affecting diet adherence were modeled using ANN and GA(ANGA)","Findings":"The results showed that the accuracy of the proposed ANN and ANGA models for predicting diet adherence was 93.22% and 93.51%, respectively.","Conclusions":"Therefore, applying the proposed model can help dietitians identify people who need more support to adhere to the diet.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"4bzihh","at":1774939665936}},"smart_blocks:mousaviDeterminingEffectiveFactors2022a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04968338,0.02696052,0.00753106,0.01707914,0.01077549,-0.02729383,0.0403815,0.03093852,0.01765126,-0.02847433,-0.01126191,-0.09338254,-0.00746861,0.04002646,0.04805595,-0.0234151,-0.0185096,0.02546949,0.02325087,-0.01760666,0.06388514,-0.01746076,0.00048521,