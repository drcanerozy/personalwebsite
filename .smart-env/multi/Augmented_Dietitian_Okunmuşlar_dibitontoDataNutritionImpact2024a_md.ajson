cial intelligence#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#From data to nutrition: the impact of computing infrastructure and artificial intelligence#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LLEL3HIU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/F48W4HVJ?page=1&annotation=RCUJ9779","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/F48W4HVJ?page=1&annotation=VEKLRIHN","line":33},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/F48W4HVJ?page=10&annotation=YJWFBQJY","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/F48W4HVJ?page=2&annotation=P4V6BXDW","line":39}],"metadata":{"Title":"From data to nutrition: the impact of computing infrastructure and artificial intelligence","Authors":"Pierpaolo Di Bitonto, Michele Magarelli, Pierfrancesco Novielli, Donato Romano, Domenico Diacono, Lorenzo De Trizio, Angelo Mariano, Claudia Zoani, Riccardo Ferrero, Alessandra Manzin, Maria De Angelis, Roberto Bellotti, Sabina Tangaro","Year":2024,"DOI":"10.37349/eff.2024.00063","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This article explores the significant impact that artificial intelligence (AI) could have on food safety and nutrition, with a specific focus on the use of machine learning and neural networks for disease risk prediction, diet personalization, and food product development.The article also discusses the need for ongoing interdisciplinary collaboration between data scientists, nutritionists, and food technologists to effectively addre","Findings":"The success of AI applications in nutrition is highly dependent on interdisciplinary collaboration. In the METROFOOD-IT case study, for example, the cooperation between data scientists, nutritionists, and food technologists has been instrumental in developing accurate predictive models for food authenticity","Conclusions":"Future research should focus on refining AI models to improve their reliability and exploring how to integrate these technologies into everyday nutritional practices for better health outcome","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"vw7l5s","at":1774939542777}},"smart_blocks:Augmented Dietitian Okunmuşlar/dibitontoDataNutritionImpact2024a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07311946,0.00133918,0.03662087,-0.01984188,0.00672609,-0.02465743,0.00132228,0.0580212,0.02775621,-0.01073844,-0.02184078,-0.10377575,0.01160178,0.02551752,0.07032884,-0.02755317,0.00152659,0.02175771,-0.00724056,0.00951305,0.0483931,-0.04959937,-0.00249055,-0.02874957,0.01454107,0.03363831,-0.01666012,-0.01714667,-0.0515944,-0.23112766,0.00314265,0.00640698,0.08506659,-0.04573621,-0.03132057,0.02908234,0.00920563,0.03716534,-0.00369489,0.01171579,0.06277596,0.00078955,0.014383,-0.01762733,-0.00907756,-0.01608951,-0.03978579,-0.01619821,-0.08608886,-0.01696658,-0.03691135,-0.00935936,0.01486137,0.04491257,0.03698365,0.06356023,0.02787795,0.03196955,0.05714011,0.09217957,0.02661954,0.05740516,-0.20426266,0.10600879,0.05434589,0.0171204,-0.08212589,0.03388503,0.02412778,-0.05018505,-0.04841254,0.01830068,0.07922082,0.0164548,0.02891595,0.02948005,0.05175338,-0.04067216,-0.00842092,-0.01585998,0.00650712,0.04732468,-0.05814304,0.00870522,-0.10032286,-0.00811538,-0.00595146,-0.05944987,0.06149006,-0.04788692,-0.05544326,-0.02072159,0.01366219,-0.00468231,0.00763234,0.01495991,-0.01798614,-0.02157775,-0.03465784,0.10141115,-0.0551987,-0.03467839,-0.00555095,0.02273755,0.02061148,-0.04887934,-0.04059567,-0.07524114,-0.01890394,0.05190837,-0.02883991,-0.00830273,-0.01600271,0.02520848,-0.00951285,0.05070339,0.09321343,0.01166596,0.03508581,0.01617981,-0.04153857,0.06715486,0.0589092,0.03246397,0.00099906,0.01458803,0.00279091,0.09053145,-0.01816722,-0.00083