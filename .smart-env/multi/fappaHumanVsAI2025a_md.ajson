71,0.1853779,-0.05324545,-0.00711798,0.03351539,-0.01345609,-0.02023199,0.01603263,-0.01284994,0.00297448,0.01884586,0.14336511,0.0490194,0.03266923,0.05340877,-0.04816158,-0.02842173,-0.01378415,-0.03108248,0.07183163,0.01292278,-0.00892146,0.01885057,0.12308412,0.03980593,-0.01989303,-0.04545318,-0.01940526,-0.0032092,-0.03832328,-0.03850245,-0.00181791,0.00214129,0.00720718,-0.01366852,0.01420137,-0.01996582,-0.00219641,-0.0338933,0.01101395,0.035661,-0.03631441,0.11108037,-0.0360624],"last_embed":{"hash":"r7dbr3","tokens":452}}},"last_read":{"hash":"r7dbr3","at":1774939658423},"class_name":"SmartSource","last_import":{"mtime":1774939638477,"size":4163,"at":1774939651557,"hash":"r7dbr3"},"blocks":{"#---frontmatter---":[1,18],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web":[20,42],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#{1}":[21,25],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#📝 Benim Notlarım":[26,28],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟡 Genel Bilgiler (Sarı)":[29,31],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔴 Bulgular (Kırmızı)":[35,37],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/63MSTVP9","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/364P2SKM?page=1&annotation=RNBJ8CL7","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/364P2SKM?page=1&annotation=A2LDCFCG","line":36},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/364P2SKM?page=10&annotation=PJ6WAWDI","line":36},{"title":"Sayfa 13","target":"zotero://open-pdf/library/items/364P2SKM?page=13&annotation=X4H3ZEWL","line":39}],"metadata":{"Title":"Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web","Authors":"Evaggelia Fappa, Mary Micheli, Dimitris Panaretos, Marios Skordis, Petroula Tsirpanli, George I. Panoutsopoulos","Year":2025,"DOI":"10.3390/info16070526","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The aim of the present study was to compare the quality assessment of online dietary weight loss information conducted by an AI assistant (ChatGPT 4.5) to that of health professionals.","Findings":"Analysis revealed no significant differences in quantitative quality scores between human raters, ChatGPT-4.5, and the AI-derived system (p = 0.528). On the contrary, statistically significant differences were found between the three content accuracy scores (p < 0.001), with scores assigned by ChatGPT-4.5 being higher than those assigned by humans (all p < 0.001). Our findings suggest that ChatGPT-4.5 could complement human experts in evaluating online weight loss information, when using a validated instrument like DISCERN. However, more relevant research is needed before forming any suggestions.In terms of classification, ChatGPT-4.5 rated 22% of webpages as “excellent” using DISCERN, while humans rated only 3%.","Conclusions":"Validated AI-assisted tools could be produced to perform dietary or health information quality assessments specific for each disease (i.e., obesity) or health status (i.e., pregnancy) for text and/or videos. Last, investigating how different versions of the same AI model perform could provide valuable insights into how rapidly evolving LLM capabilities affect assessment accuracy, potentially leading to the development of a gold standard methodology for AI-assisted evaluation of online nutritional information","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"r7dbr3","at":1774939658246}},"smart_blocks:fappaHumanVsAI2025a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.01625663,0.00991087,0.0042095,0.01922836,0.00792768,0.05130303,-0.00103419,0.06401286,0.01538061,-0.0126143,0.00373738,-0.07811163,0.01863005,0.04242946,0.01770565,0.00627537,0.02785585,-0.04360955,-0.01462146,0.02910888,0.07293335,-0.00786708,0.01446402,0.01700227,0.00435895,0.00568096,-0.05170044,-0.07380375,-0.08932401,-0.21503399,0.029141,-0.02662079,0.08931876,-0.02133141,-0.05439871,-0.00322323,0.0008648,0.02288756,-0.00972094,0.01649606,0.01664972,-0.01397971,0.03122963,-0.02324149,0.00853179,0.0192269,-0.0413183,0.0116649,-0.07940254,0.04262363,-0.00040819,0.00478099,0.03110655,0.04159553,0.05544053,0.03740394,0.04280219,0.0515358,0.04283715,0.07709794,0.05286442,0.06800057,-0.22440815,0.08931734,0.00812923,0.03839863,-0.07226326,0.00640956,-0.0338575,-0.0349436,-0.04919036,-0.01964238,0.06345858,0.04580385,0.01267137,0.00322407,0.07616811,-0.0490109,0.01171236,-0.01260199,0.02205385,0.0683646,-0.00594914,-0.01357945,-0.01722401,-0.03339102,0.0088436,-0.01955728,0.04002965,-0.03634491,-0.00246504,-0.02328577,-0.01121902,0.05219565,-0.00044187,-0.02131384,-0.04396838,-0.0308186,-0.04259282,0.10585007,-0.05809965,-0.01703511,-0.00813378,-0.0194254,0.05430058,-0.05468772,-0.04329144,-0.0514997,0.00932642,0.021851