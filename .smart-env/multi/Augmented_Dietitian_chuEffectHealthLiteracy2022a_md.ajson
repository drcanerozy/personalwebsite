ention facilitating weight-loss management decisions#📝 Benim Notlarım#{2}":[29,30],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟡 Genel Bilgiler (Sarı)":[31,33],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔴 Bulgular (Kırmızı)":[37,39],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/3M8BCKUV","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/75R55Z7B?page=1&annotation=H8T8UWEB","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/75R55Z7B?page=1&annotation=P7GCLE3U","line":38},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/75R55Z7B?page=10&annotation=3WRHNW2Z","line":41},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/75R55Z7B?page=10&annotation=6KCJDM58","line":41}],"metadata":{"Title":"Effect of health literacy and shared decision-making on choice of weight-loss plan among overweight or obese participants receiving a prototype artificial intelligence robot intervention facilitating weight-loss management decisions","Authors":"Yi-Tang Chu, Ru-Yi Huang, Tara Tai-Wen Chen, Wei-Hsuan Lin, James TaoQian Tang, Chi-Wei Lin, Chi-Hsien Huang, Chung-Ying Lin, Jung-Sheng Chen, Sabrina Kurtz-Rossi, Kristine Sørensen","Year":2022,"DOI":"10.1177/20552076221136372","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We developed an AI robot intervention prototype with a health literacy-friendly interface that uses interactive voice response (IVR) surveying to assist in decision-making for weight loss.","Findings":"After interacting with the AI robot, 78% of the study population made the decision to lose weight.","Conclusions":"Our findings indicated that our prototype AI Robot can encourage individuals to adopt a healthier lifestyle.In a clinical setting, our AI robot can be used to assist healthcare professionals in patient health education and involve patients in SDM","Limitations":"","User_Notes":"weight-specific health literacy instrument (WSHLI) and Shared Decision-Making Questionnaire (SDMQ) were used to measure factors influencing weight-loss decisions.  prompt ve dyt karşılaştırması yok, gerekli mi doğrulanacak"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"69q5q2","at":1774939760580},"key":"Augmented Dietitian/chuEffectHealthLiteracy2022a.md"},
