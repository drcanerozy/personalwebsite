,-0.02045208,0.0522969,-0.01374245,0.04628291,-0.09755892,0.00112249,0.03893736,0.17622216,-0.03304045,-0.00436009,0.06428845,-0.01203149,-0.0351515,0.03392081,-0.0086575,0.05361804,0.01151729,0.09012894,0.03973996,-0.00388022,0.05739384,-0.02349806,-0.06966629,-0.02510204,0.00499295,0.06095059,-0.01649436,-0.04089163,-0.03496261,0.10532442,-0.0285897,0.02178081,-0.06815552,-0.00731813,-0.00899414,0.04189045,-0.02703041,0.01261726,0.02213361,0.03120384,-0.00988942,0.01533253,-0.0082686,0.02411673,-0.05906297,0.03231954,-0.00053762,-0.01959965,0.07546142,-0.05726076],"last_embed":{"hash":"10kt37a","tokens":421}}},"last_read":{"hash":"10kt37a","at":1774939546697},"class_name":"SmartSource","last_import":{"mtime":1774939523520,"size":4198,"at":1774939536722,"hash":"10kt37a"},"blocks":{"#---frontmatter---":[1,18],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes":[20,42],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#{1}":[21,25],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#📝 Benim Notlarım":[26,28],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟡 Genel Bilgiler (Sarı)":[29,31],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔴 Bulgular (Kırmızı)":[35,37],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/JM7L9I9D","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=48QLTY42","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=BQIJU94Z","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=FUAH5SXV","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=9ZCXQE4E","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=SM2W9RX3","line":39}],"metadata":{"Title":"FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes","Authors":"Jiahui Hu, Xue Wang, Kuanda Yao, Xu Zhang, Wanqing Zhao, Jin Fu, Pei Lou, Wei Chen, An Fang","Year":2026,"DOI":"10.1016/j.ijmedinf.2025.106168","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We aimed to develop and validate an approach that automatically identifies malnutrition risk factors from free-text clinical notes, and assess nutritional status of hospitalized patients rapidly under the situation of limited labeled data.The clinical notes of 1,469 patients used in this study were collected from the Peking Union Medical College HospitalSix natural language processing models were performed and compared. For nutritional status assessment, a semi-supervised learning (SSL) mechanism was applied based on the self-learning algorithm (SLA). The Shapley Additive exPlanations (SHAP) method was further employed to explore the interpretability.","Findings":"For risk factor identification, all pre-trained models outperformed the traditional machine learning models, and the best performance achieved with an F1 score of 0.9142. For nutritional status assessment, the SLA-based SSL improved the performance by introducing high confidence samples, and the area under the receiver operating characteristic curve (AUROC) for the optimized model achieved 0.8234. The unintentional weight loss and decreased food intake were the most impactful features recorded in clinical notes identified by the SHAP analysis.","Conclusions":"study presented a feasible NLP-based approach for nutritional risk assessment, and demonstrated the potential of machine learning for high-performance healthcare artificial intelligence services.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"10kt37a","at":1774939546525}},"smart_blocks:Augmented Dietitian Okunmuşlar/huFANSFrameworkAutomatic2026b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.0820628,0.00810766,-0.01270945,-0.01889342,0.00721188,0.03960492,-0.01541967,0.0353984,0.01362788,-0.00870891,0.02949454,-0.11091197,0.02434221,0.02326186,0.0466376,-0.01240273,0.034196,0.03887362,-0.0486658,0.01202909,0.05123564,-0.02790206,0.0080141,0.03156437,0.08345108,0.02304132,-0.0406783,-0.05308957,-0.06757214,-0.25082642,0.01706985,-0.04546911,0.08003262,-0.05747923,-0.05506791,0.0156893,0.00001069,0.05197144,-0.02336418,0.01715441,0.05227467,0.00530193,0.03432771,0.02892582,0.03761876,-0.04951083,-0.01753793,-0.02796292,-0.03986051,0.00311396,-0.04664475,0.02186835,0.01535783,0.03936309,0.03518936,0.02192876,0.07061172,0.02070755,0.03343938,0.07591842,0.01332675,0.06886687,-0.19586642,0.04730652,0.06532803,0.04168846,-0.05905544,-0.00558257,0.02593934,-0.04309819,-0.03882991,0.048171,0.05498638,0.04373887,-0.00276191,0.00836538,0.06821047,-0.02820715,0.00276474,0.00558699,-0.00130083,0.06854662,-0.03380788,0.00718195,-0.03614