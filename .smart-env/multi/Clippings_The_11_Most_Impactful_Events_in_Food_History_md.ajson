rget":"https://news.harvard.edu/gazette/story/2009/06/invention-of-cooking-drove-evolution-of-the-human-species-new-book-argues/","line":19},{"title":"Cooking | Techniques, Recipes & Nutrition | Britannica","target":"https://www.britannica.com/topic/cooking","line":21},{"title":"The Evolution of Cooking: A Defining Moment in Human History (anthropology.net)","target":"https://www.anthropology.net/p/the-evolution-of-cooking-a-defining","line":23},{"title":"Bing Videos","target":"https://www.bing.com/videos/search?view=detail&q=what+is+the+importance+of+the+invention+of+cooking%3f&mid=61E57D57EDE2C0B4F9A161E57D57EDE2C0B4F9A1&FORM=VIRE","line":25},{"title":"50 percent of women","target":"https://www.karger.com/Article/Abstract/12770","line":27},{"title":"https://www.scientificamerican.com/article/food-for-thought-was-cooking-a-pivotal-step-in-human-evolution/","target":"https://www.scientificamerican.com/article/food-for-thought-was-cooking-a-pivotal-step-in-human-evolution/","line":27}],"class_name":"SmartBlock"},
