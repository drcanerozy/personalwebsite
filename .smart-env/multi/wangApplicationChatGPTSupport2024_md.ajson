139747,0.04013405,-0.02078072,0.18811259,-0.00116046,0.00313857,0.01141925,-0.05329581,-0.02628626,0.01696517,0.02973373,-0.00739013,0.01939313,0.11346991,0.01119098,0.02105665,0.0070953,-0.00766976,-0.01903357,-0.02091729,-0.02296078,0.01388254,-0.00092159,-0.05055062,-0.04638958,0.08330696,0.01150668,-0.00734381,-0.08196183,-0.0059637,0.00393957,0.00869568,0.00935858,-0.00048702,0.00310292,0.05764669,-0.03214747,-0.01341868,0.00112868,0.01263311,-0.0037381,0.02269607,0.0370615,-0.01109787,0.07177532,-0.04747961],"last_embed":{"hash":"51e6wh","tokens":471}}},"last_read":{"hash":"51e6wh","at":1774939672269},"class_name":"SmartSource","last_import":{"mtime":1774939638746,"size":5154,"at":1774939651608,"hash":"51e6wh"},"blocks":{"#---frontmatter---":[1,18],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation":[20,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#{1}":[21,25],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#📝 Benim Notlarım":[26,28],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)":[35,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)":[41,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RWZCNDZU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=S7R4IZHN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=6DKKWP9Z","line":36},{"title":"Sayfa 4","target":"zotero://open-pdf/library/items/RKBFCLYY?page=4&annotation=9LFSML73","line":42}],"metadata":{"Title":"Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation","Authors":"Lin-Chun Wang, Hanjie Zhang, Nancy Ginsberg, Andrea Nandorine Ban, Jeroen P. Kooman, Peter Kotanko","Year":2024,"DOI":"10.1053/j.jrn.2024.09.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We tasked ChatGPT-4 with generating a personalized daily meal plan, including nutritional information. Virtual ‘‘patients’’ were generated through Monte Carlo simulation; data from a randomly selected virtual patient were presented to ChatGPT. We provided to ChatGPT patient demographics, food preferences, laboratory data, clinical characteristics, and available budget, to generate a oneday sample menu with recipes and nutritional analyses. The resulting daily recipe recommendations, cooking instructions, and nutritional analyses were reviewed and rated on a five-point Likert scale by an experienced renal dietitian. In addition, the generated content was rated by a renal dietitian and compared with a U. S. Department of Agriculture–approved nutrient analysis software. ChatGPT also analyzed nutrition information of two recipes published online. We also requested a translation of the output into Spanish, Mandarin, Hungarian, German, and Dutch.","Findings":"The renal dietitian rated the recipes at 3 (3, 3) [median (Q1, Q3)], the cooking instructions at 5 (5,5), and the nutritional analysis at 2 (2, 2) on the five-point Likert scale. ChatGPT’s nutritional analysis underestimated calories by 36% (95% CI: 44-88%), protein by 28% (25-167%), fat 48% (29-81%), phosphorus 54% (15-102%), potassium 49% (40-68%), and sodium 53% (14-139%). The nutritional analysis of online available recipes differed only by 0 to 35%. The translations were rated as reliable by native speakers (4 on the five-point Likert scale).","Conclusions":"","Limitations":"LLMs like ChatGPT show promise for providing personalized nutritional guidance to dialysis patients, but significant improvements are necessary. At present, ChatGPT’s nutritional recommendations are not a substitute for personalized medical advice. However, it can be a useful tool for generating meal plans that renal dietitians can then evaluate and adjust according to reference values from validated sources.","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"51e6wh","at":1774939672129}},"smart_blocks:wangApplicationChatGPTSupport2024.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02772104,0.0419606,0.00418266,-0.03201661,-0.04139236,0.02368443,-0.02360093,0.06258743,-0.02754443,-0.00953067,-0.01933547,-0.09027324,0.02564341,0.05873549,0.03937289,0.0031005,0.03682183,-0.02851293,-0.0448574,-0.01295991,0.09289568,-0.07444619,0.00677589,-0.01792351,0.07448582,-0.00924319,0.00052166,-0.02781558,-0.04339702,-0.20057221,0.00962959,-0.00202405,0.04297937,-0.02237852,-