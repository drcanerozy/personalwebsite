3,-0.00722069,0.00358627,0.08465504,-0.04774073,0.05759086,-0.10575713,0.02353983,0.04397771,0.16777191,-0.02789542,-0.03935777,0.04453029,0.00319155,-0.00569133,0.05286482,0.00591428,0.02685463,0.00460502,0.08604796,0.04000238,0.05479606,0.04314047,-0.05760007,0.0068057,-0.04241711,-0.00084617,0.0252366,-0.00030528,-0.03046441,-0.02329175,0.09020191,-0.01446034,0.0071799,-0.07598434,-0.04702422,-0.02520964,-0.02646985,-0.00344681,0.01050857,0.00531802,0.04118383,-0.0351133,0.0038196,-0.01203239,-0.0258269,-0.02368567,0.02630701,0.00315621,-0.04529683,0.09587521,-0.03538849],"last_embed":{"hash":"1ne9u44","tokens":493}}},"last_read":{"hash":"1ne9u44","at":1778067901030},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3628,"at":1778067901030,"hash":"1ne9u44"},"blocks":{"#---frontmatter---":[1,18],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4":[20,44],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#{1}":[21,25],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#📝 Benim Notlarım":[26,30],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#📝 Benim Notlarım#{1}":[27,28],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#📝 Benim Notlarım#{2}":[29,30],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🟡 Genel Bilgiler (Sarı)":[31,33],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🔴 Bulgular (Kırmızı)":[37,39],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/46PN75MC","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/DTTESBR7?page=1&annotation=KFDTTH6S","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/DTTESBR7?page=1&annotation=XJBYH9LT","line":38},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/DTTESBR7?page=1&annotation=S2HEKSEC","line":41}],"metadata":{"Title":"Examining the Accuracy and Reproducibility of Responses to Nutrition Questions Related to Inflammatory Bowel Disease by Generative Pre-trained Transformer-4","Authors":"Jamil S Samaan, Kelly Issokson, Erin Feldman, Christina Fasulo, Nithya Rajeev, Wee Han Ng, Barbara Hollander, Yee Hui Yeo, Eric Vasiliauskas","Year":2024,"DOI":"10.1093/crocol/otae077","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study examines the accuracy, comprehensiveness, and reproducibility of responses by GPT-4 to patient nutrition questions related to IBD.","Findings":"selected. The model correctly responded to 73/88 questions (83.0%), with 61 (69.0%) graded as comprehensive. 15/88 (17%) responses were graded as mixed with correct and incorrect/outdated data. The model comprehensively responded to 10 (62.5%) questions related to “Nutrition and diet needs for surgery,” 12 (92.3%) “Tube feeding and parenteral nutrition,” 11 (64.7%) “General diet questions,” 10 (50%) “Diet for reducing symptoms/inflammation,” and 18 (81.8%) “Micronutrients/supplementation needs.” The model provided reproducible responses to 81/88 (92.0%) questions.","Conclusions":"GPT-4 comprehensively answered most questions, demonstrating the promising potential of LLMs as supplementary tools for IBD patients seeking nutrition-related information. However, 17% of responses contained incorrect information, highlighting the need for continuous refinement prior to incorporation into clinical practice.","Limitations":"","User_Notes":"dyt değerlendirmesi var  promptlar verilmemiş"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1ne9u44","at":1774939745686},"key":"Augmented Dietitian/samaanExaminingAccuracyReproducibility2024.md"},
