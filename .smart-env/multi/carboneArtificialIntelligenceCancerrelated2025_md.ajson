74,-0.04172382,0.01739277,-0.10219047,0.01181552,0.03946173,0.17863448,-0.02984194,0.0079249,0.05530411,-0.03231832,-0.01038947,0.02204999,-0.00304413,0.02653437,0.06162252,0.03302404,0.0368553,0.04662741,0.03037134,-0.00843621,-0.0138109,-0.0209235,0.0249343,0.05545282,0.03579939,0.00096274,-0.05280744,0.09553614,-0.0263837,0.03403889,-0.06447292,-0.0022279,0.00254094,-0.00069834,-0.03336736,-0.00904278,0.00466825,0.01690153,-0.04815799,0.00196147,-0.01035547,-0.01457347,-0.0630821,0.03051062,0.00532524,-0.04001103,0.08744424,-0.09299927],"last_embed":{"hash":"a2pfxr","tokens":390}}},"last_read":{"hash":"a2pfxr","at":1774939655352},"class_name":"SmartSource","last_import":{"mtime":1774939638431,"size":5023,"at":1774939651547,"hash":"a2pfxr"},"blocks":{"#---frontmatter---":[1,18],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition":[20,42],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#{1}":[21,25],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#📝 Benim Notlarım":[26,28],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🟡 Genel Bilgiler (Sarı)":[29,31],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🔴 Bulgular (Kırmızı)":[35,37],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🟠 Limitasyonlar (Turuncu)":[41,42],"#Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/V5GDYBSA","line":22},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/X7PL48KS?page=2&annotation=EJYCI7VX","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/X7PL48KS?page=1&annotation=9IP3PJUI","line":39},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/X7PL48KS?page=2&annotation=GUI7QLQN","line":39},{"title":"Sayfa 3","target":"zotero://open-pdf/library/items/X7PL48KS?page=3&annotation=FKUQW54M","line":39},{"title":"Sayfa 3","target":"zotero://open-pdf/library/items/X7PL48KS?page=3&annotation=YAFJK563","line":39},{"title":"Sayfa 3","target":"zotero://open-pdf/library/items/X7PL48KS?page=3&annotation=BZ9M8VHQ","line":42}],"metadata":{"Title":"Artificial intelligence in cancer-related malnutrition and cachexia: a transformative tool in clinical nutrition","Authors":"Salvatore Carbone","Year":2025,"DOI":"10.1016/j.advnut.2025.100447","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"","Findings":"The effects of the practical application of AI in oncology nutrition on clinical outcomes have been largely unexplored; however, we could speculate that by improving adherence to dietary interventions, patients will experience improvements in clinical outcomes","Conclusions":"These results suggest that integrating AI into clinical workflows has the potential to simplify the early identification of malnutrition, but also to reduce the burden on clinical staff responsible for conducting malnutrition screening.Although conclusive evidence on the impact of AI-driven virtual dietitian systems on hard clinical outcomes, such as survival and length of stay, is still being investigated, improvements in nutritional status, adherence to interventions, patient satisfaction, and timely support are clearly required steps to improve patient outcomes.The future of oncology nutrition will require a synergistic partnership between clinicians and AI. AI tools can empower registered dietitian nutritionists and other nutrition specialists with enhanced analytical capabilities and predictive insights, allowing them to focus on patients who are more likely to respond to a nutrition intervention, ultimately providing a more personalized and effective carehe goal of AI is not to replace the clinician and their clinical judgment, but to support their ability to identify and treat malnutrition, cachexia, and other nutrition status abnormalities, to ultimately improve the lives of our patients.","Limitations":"This level of heterogeneity makes it hard to replicate these findings across centers with different characteristics. Moreover, the use of AI in clinical practice requires critical ethical considerations, including data privacy and the potential for algorithmic bias, requiring utmost attention to build trust and ensure equitable application of AI technologies","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"a2pfxr","at":1774939655155}},"smart_blocks:carboneArtificialIntelligenceCancerrelated2025.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07898725,0.01541704,0.01427583,-0.00533326,-0.03599607,0.00913155,-0.01017657,0.03052501,0.02531403,-0.0212084,0.02726791,-0.0612124,0.01116928,0.04107356,0.0214858,-0.0146245,0.00573981,0.03442635,-0.02035232,0.00765457,-0.00071034,-0.05686986,0.00066845,0.02272082,-0.00174577,0.00897213,-0.04657288,-0.05741352,-0.0705367,-0.20573007,0.03870611,-0.03346578,0.0