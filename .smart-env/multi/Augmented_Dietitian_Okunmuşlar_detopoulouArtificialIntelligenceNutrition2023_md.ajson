.02298412,0.09679912,-0.00290315,-0.01458862,0.01220762,0.03607429,-0.03298553,0.03134095,-0.0987443,0.00581409,0.02825548,0.18481791,-0.060599,-0.04200456,0.03280453,-0.01906244,-0.01984689,-0.01457256,-0.02497342,0.00641828,0.0140597,0.06884869,0.00124276,0.04867023,0.03714724,-0.0550853,-0.05754657,-0.0011202,0.00176153,-0.002785,-0.0126616,0.04971725,0.00664762,0.08884781,0.00580886,-0.04185429,-0.01019705,-0.01511182,0.0294938,0.02706568,-0.02199689,-0.0055499,0.01828599,0.02840548,-0.02892891,0.01691597,-0.00776911,0.00029049,-0.06609686,0.03675911,0.01219358,-0.08585265,0.07249205,-0.04032494],"last_embed":{"hash":"1dqvvdv","tokens":468}}},"last_read":{"hash":"1dqvvdv","at":1774939542767},"class_name":"SmartSource","last_import":{"mtime":1774939523438,"size":3722,"at":1774939536704,"hash":"1dqvvdv"},"blocks":{"#---frontmatter---":[1,18],"#Artificial intelligence, nutrition, and ethical issues: A mini-review":[20,42],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#{1}":[21,25],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#📝 Benim Notlarım":[26,28],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🟡 Genel Bilgiler (Sarı)":[29,31],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔴 Bulgular (Kırmızı)":[35,37],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LMQDZ2F2","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/S3YM6NTI?page=1&annotation=VUR9NI76","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/S3YM6NTI?page=2&annotation=73ZJY7WQ","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/S3YM6NTI?page=2&annotation=R5CPEPST","line":39}],"metadata":{"Title":"Artificial intelligence, nutrition, and ethical issues: A mini-review","Authors":"Paraskevi Detopoulou, Gavriela Voulgaridou, Panagiotis Moschos, Despoina Levidi, Thelma Anastasiou, Vasilios Dedes, Eirini- Maria Diplari, Nikoleta Fourfouri, Constantinos Giaginis, Georgios I. Panoutsopoulos, Sousana K. Papadopoulou","Year":2023,"DOI":"10.1016/j.nutos.2023.07.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"","Findings":"In general, AI should do no harm and contribute to human well-being, while AI professionals should be honest, trustful, and fair. Privacy and confidentiality should be protected. Other concerns include the “dehumanization” of care, social disparities, responsibility assignment in case of errors or malfunctions, and bias in training models and delivering care. Moreover, the prediction of disease onset in high-risk individuals may be connected to stigma, over-medicalization, and stress. There is also a serious concern that AI systems in the field of nutrition and dietetics may cause a partial replacement of dietitians; however, health professionals can usesuch technologies as part of their work. The use of AI applications for persons with mental diseases or eating disorders is also crucial","Conclusions":"In conclusion, AI-assisted personalized nutrition needs further justification, while the regulatory framework requires a constant update to keep up with scientific advancements and address ethical issues. Coordinated global focus on these domains could effectively lead to a more embraced AI implementation in individuals and populations.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1dqvvdv","at":1774939542598}},"smart_blocks:Augmented Dietitian Okunmuşlar/detopoulouArtificialIntelligenceNutrition2023.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04033528,0.00059175,0.01112397,-0.02866092,-0.0166573,-0.02368765,0.04125532,0.05874158,0.02997139,-0.00473298,-0.02151155,-0.09000149,-0.00255592,0.0383246,0.06672975,0.00473421,0.01907841,0.0222475,-0.02409585,0.00412894,0.05598612,-0.04326288,0.0113306,-0.02677517,-0.03357473,0.02171926,-0.02674169,-0.03307524,-0.05487358,-0.18459566,0.01876328,-0.01479447,0.06720547,-0.01811715,-0.04343173,0.04175162,-0.01045322,0.03870511,-0.03326,0.0517119,0.02192532,-0.0120664,-0.00493431,-0.03594131,-0.00908157,-0.00014412,-0.06396405,-0.00786328,-0.0906603,-0.01374762,-0.0268191,0.01190869,0.00819475,0.0588258,0.05331157,0.02524085,0.04803784,0.03119211,0.0194776,0.09817194,0.0490664,0.0571592,-0.19454272,0.11452609,0.03454589,0.06301129,-0.04356837,-0.02773869,0.00157721,-0.05578456,-0.0541155,0.02170886,0.05877012,0.03119749,0.01914375,0.04140385,0.03836654,-0.04706651,0.01677801,-0.01900573,0.01615517,0.06723933,-0.03873865,0.02718663,-0.0755459,-0.00620102,0.01906949,-0.08871709,0.05283464,-0.04556976,-0.03845266,-0.03883232,0.04647801,0.01909202,0.04053091,-0.00514485,-0.02614489,-0.0113667,-0.07043613,0.08295566,-0.03178356,-0.03777941,0.00141024,0.02892267,0.0353177,-0.02706654,-0.04118563,-0.09209678,-0.01491966,0.04115815,-0.01975498,-0.0051063,0.03986564,0.02908429,-0.02874691,0.08590415,0.0951394,0.00639948,0.02559497,-0.00648181,-0.01318248,0.01942477,0.0791465,0.02980691,-0.00536784,-0.01507571,0.00080926,0.09318478,-0.00396654,-0.00909559,0.10604338,-0.01244789,-0.03284464,-0.0217781,-0.00014353,-0.03239477,0.03021495,-0.02867268,-0.02276465,0.03110089,-0.04266139,-0.00605644,0.00499143,-0.11336256,-0.01988092,0.1664304,0.06418727,0.03699967,-0.01953739,-0.04298738,0.041