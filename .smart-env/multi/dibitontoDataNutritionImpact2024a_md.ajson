,40],"#From data to nutrition: the impact of computing infrastructure and artificial intelligence#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LLEL3HIU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/F48W4HVJ?page=1&annotation=RCUJ9779","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/F48W4HVJ?page=1&annotation=VEKLRIHN","line":33},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/F48W4HVJ?page=10&annotation=YJWFBQJY","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/F48W4HVJ?page=2&annotation=P4V6BXDW","line":39}],"metadata":{"Title":"From data to nutrition: the impact of computing infrastructure and artificial intelligence","Authors":"Pierpaolo Di Bitonto, Michele Magarelli, Pierfrancesco Novielli, Donato Romano, Domenico Diacono, Lorenzo De Trizio, Angelo Mariano, Claudia Zoani, Riccardo Ferrero, Alessandra Manzin, Maria De Angelis, Roberto Bellotti, Sabina Tangaro","Year":2024,"DOI":"10.37349/eff.2024.00063","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This article explores the significant impact that artificial intelligence (AI) could have on food safety and nutrition, with a specific focus on the use of machine learning and neural networks for disease risk prediction, diet personalization, and food product development.The article also discusses the need for ongoing interdisciplinary collaboration between data scientists, nutritionists, and food technologists to effectively addre","Findings":"The success of AI applications in nutrition is highly dependent on interdisciplinary collaboration. In the METROFOOD-IT case study, for example, the cooperation between data scientists, nutritionists, and food technologists has been instrumental in developing accurate predictive models for food authenticity","Conclusions":"Future research should focus on refining AI models to improve their reliability and exploring how to integrate these technologies into everyday nutritional practices for better health outcome","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"vw7l5s","at":1774939657508}},"smart_blocks:dibitontoDataNutritionImpact2024a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06330752,0.02264149,0.04484888,-0.02723814,0.01872879,-0.02215272,0.000146,0.05786851,0.01949736,-0.01899396,-0.01607448,-0.08949083,0.01231849,0.02731639,0.05704096,-0.03429196,-0.00404969,0.01260158,-0.00881003,0.0256546,0.04978312,-0.05140577,-0.00665749,-0.05068571,0.01167184,0.02286347,-0.01234255,-0.01178608,-0.0501729,-0.23428726,-0.00015002,0.00862423,0.07298777,-0.044317,-0.01886709,0.02084681,0.01808971,0.0275357,0.02174575,0.01713602,0.06061514,-0.00902975,0.01435618,-0.02410928,-0.01447887,-0.01692478,-0.04220601,0.00472277,-0.08161055,-0.02334626,-0.03327617,-0.01672278,0.01259596,0.04709058,0.0319255,0.06639557,0.02824779,0.02695416,0.06081621,0.08206916,0.03156612,0.05480709,-0.20125788,0.09718009,0.08031814,0.02780609,-0.08293626,0.04570577,0.02381118,-0.04492528,-0.03877,0.02236464,0.0764835,0.01445435,0.03024228,0.01875127,0.06032922,-0.03109667,-0.01921818,-0.02089899,0.01296814,0.04164802,-0.05797762,0.00562963,-0.10597725,-0.01645989,-0.00809332,-0.05333435,0.06474238,-0.05382783,-0.05673636,-0.01495539,0.00539558,0.00472583,0.00544916,0.02689061,-0.02618173,-0.00870058,-0.03648972,0.08965578,-0.05756738,-0.03019552,-0.01662054,0.01198155,0.01869419,-0.05029581,-0.03507219,-0.0715884,0.002954,0.04601002,-0.01836176,-0.01201396,0.00544209,0.02020975,-0.01530182,0.03401296,0.08515494,0.0307103,0.03629847,0.01726805,-0.05567542,0.08844549,0.0603816,0.03024579,0.00780528,0.02460995,-0.00550442,0.09604055,-0.02079557,0.00723249,0.07710591,-0.01058356,-0.04375374,0.01680142,0.00887701,0.00648935,0.05823104,-0.04693146,-