56574,0.04173587,-0.00783056,0.01978212,-0.09510835,0.06662767,0.03352799,0.22510985,-0.06216323,0.00442768,0.06324207,-0.02327844,-0.0225967,0.01629265,-0.02683419,0.03484052,0.05667428,0.0948192,-0.00217625,-0.00513841,0.0673983,-0.05882485,-0.04285727,0.02499576,0.01267734,-0.00178152,-0.033508,-0.06896986,0.00471908,0.10035199,-0.03998519,-0.03803381,-0.07697459,-0.02369472,0.02118542,0.01922223,-0.02829502,-0.02243603,-0.01806614,0.03706661,0.02363853,0.01214039,-0.01501855,-0.02750282,-0.06656357,0.01619953,-0.01789173,-0.00207758,0.0858071,-0.05984739],"last_embed":{"hash":"1h2cg4r","tokens":418}}},"last_read":{"hash":"1h2cg4r","at":1778067900873},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3272,"at":1778067900874,"hash":"1h2cg4r"},"blocks":{"#---frontmatter---":[1,18],"#Fuzzy Deep Daily Nutrients Requirements Representation":[20,42],"#Fuzzy Deep Daily Nutrients Requirements Representation#{1}":[21,25],"#Fuzzy Deep Daily Nutrients Requirements Representation#📝 Benim Notlarım":[26,28],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔴 Bulgular (Kırmızı)":[35,37],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/7IUNWJMS","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=3Q7WL4QP","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=D6HE3VQA","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=TNUGFXXA","line":39}],"metadata":{"Title":"Fuzzy Deep Daily Nutrients Requirements Representation","Authors":"Karim El Moutaouakil, Abdellah Ahourag, Saliha Chellak, Hicham Baїzri, Mouna Cheggour","Year":2022,"DOI":"10.18280/ria.360210","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"First, we collect the expert's nutrients recommendations from different expert research papers. These recommendations are, then, represented in terms of trapezoidal numbers by adopting appropriate rules that encourage the consumption of the favorable nutrients and limit consumption of the unfavorable nutrients in daily diets. Then, we generate large data sets basing on the trapezoidal representation. To transform the expert's recommendations into significant crisp values, we call the auto-encoder neural network, and we propose an original regulation term that controls all the auto-encoder units. To select the best autoencoder architecture, we use the fuzzy genetic algorithm basing on a simple fuzzy rule to determine the crossover percent, the mutation percent, and the population size at each iteration","Findings":"Compared to the random systems, the proposed method has shown a great capacity to generalize its experience to unseen recommendations.","Conclusions":"In a clinical setting, our system can be used by a dietician to accurately determine the daily nutrient requirements of a given individual.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1h2cg4r","at":1774939759301},"key":"Augmented Dietitian/elmoutaouakilFuzzyDeepDaily2022.md"},
