07,0.02007804,0.05825483,0.04878766,0.0240293,-0.08440708,0.01489062,0.03620523,0.19046696,0.01454679,0.01846513,0.02982937,-0.01087773,0.04168981,0.03481926,0.00853981,0.01402756,-0.01053019,0.0731338,0.00383886,-0.01137899,0.05002657,-0.02539371,0.05027533,0.0011803,-0.03357458,-0.01524148,-0.01289635,-0.0215636,-0.01672654,0.09989244,-0.06242406,-0.01431769,-0.01782873,0.00167644,-0.00598254,0.04013929,-0.02723326,0.0476786,-0.0105855,0.00937131,-0.0045371,-0.02468567,-0.05612807,-0.06008824,-0.0003475,0.02600708,0.00788998,0.03122656,0.08279173,0.01204247],"last_embed":{"hash":"x40vn2","tokens":480}}},"last_read":{"hash":"x40vn2","at":1778067901221},"class_name":"SmartSource","last_import":{"mtime":1755065004000,"size":14972,"at":1778067901222,"hash":"x40vn2"},"blocks":{"#---frontmatter---":[1,9],"#":[10,13],"##Conditioned Hunger":[14,15],"##Hunger is a Habit":[16,114],"##Hunger is a Habit#{1}":[18,55],"##Hunger is a Habit##Tip -Don't Eat all the Time. Give your body a chance to use the calories you ate.":[56,81],"##Hunger is a Habit##Tip -Don't Eat all the Time. Give your body a chance to use the calories you ate.#{1}":[58,81],"##Hunger is a Habit##Tip — Regular fasting reduces expectations for eating and hunger":[82,83],"##Hunger is a Habit##(Don't) Finish your Plate":[84,99],"##Hunger is a Habit##(Don't) Finish your Plate#{1}":[86,99],"##Hunger is a Habit##Tip — Manage your expectations. Get used to fewer courses per meal, no snacks between or after meals, smaller plates and portions.":[100,101],"##Hunger is a Habit##Eat Slowly":[102,114],"##Hunger is a Habit##Eat Slowly#{1}":[104,114]},"outlinks":[{"title":"< Go to the original","target":"https://drjasonfung.medium.com/conditioned-hunger-a0e263dff155#bypass","line":10},{"title":"Preview image","target":"https://miro.medium.com/v2/resize:fit:700/1*IaoVvkM8nJbv5nji_XPFRA.jpeg","line":12,"embedded":true},{"title":"![Dr. Jason Fung","target":"https://miro.medium.com/v2/resize:fill:88:88/1*Ca_QnhuA4ImUPxHNcE7Mcw.jpeg","line":18},{"title":"Dr. Jason Fung","target":"https://medium.com/@drjasonfung \"Nephrologist. New York Times best selling author. Interest in type 2 diabetes reversal and intermittent fasting. Founder www.TheFastingMethod.com.\"","line":20},{"title":"Cephalic Hunger","target":"https://drjasonfung.medium.com/cephalic-hunger-1a8dbe4ee83b","line":26},{"title":"View original","target":"https://drjasonfung.medium.com/cephalic-hunger-1a8dbe4ee83b","line":32},{"title":"None","target":"https://miro.medium.com/v2/resize:fit:700/1*_CwrnsCO__Rhu114uN8m4A.jpeg","line":36,"embedded":true},{"title":"hunger hormone ghrelin changes over the day. In the average person, it spikes three times a day,","target":"https://pubmed.ncbi.nlm.nih.gov/15941923/","line":38},{"title":"None","target":"https://miro.medium.com/v2/resize:fit:700/1*zo0nBx-65AwsvJwZvx-vDA.jpeg","line":42,"embedded":true},{"title":"three times a day, the average American was eating more than 5 times per day","target":"https://pubmed.ncbi.nlm.nih.gov/25088521/","line":44},{"title":"supported this belief","target":"https://www.dietaryguidelines.gov/sites/default/files/2020-07/ScientificReport_of_the_2020DietaryGuidelinesAdvisoryCommittee_first-print.pdf","line":44},{"title":"people more, not less hungry","target":"https://pubmed.ncbi.nlm.nih.gov/23404961/","line":46},{"title":"None","target":"https://miro.medium.com/v2/resize:fit:700/1*Oq5x-WFvzSxei52aCSEx8Q.jpeg","line":66,"embedded":true},{"title":"25% lower than normal after 3 days of fasting","target":"https://pubmed.ncbi.nlm.nih.gov/15941923/","line":74},{"title":"2–5 times their original sizes","target":"https://pubmed.ncbi.nlm.nih.gov/11818300/","line":90},{"title":"3 inches in diameter in the 1990s compared to 6 inches today","target":"https://www.nhlbi.nih.gov/health/educational/wecan/news-events/matte1.htm","line":90},{"title":"None","target":"https://miro.medium.com/v2/resize:fit:700/1*IaoVvkM8nJbv5nji_XPFRA.jpeg","line":92,"embedded":true},{"title":"Europe are considerably smaller than those in the United States","target":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10855354/","line":96},{"title":"Eating slowly is even more important when eating energy dense foods","target":"https://pubmed.ncbi.nlm.nih.gov/23592679/","line":106},{"title":"eating slowly ate fewer calories but felt more full afterwards","target":"https://pubmed.ncbi.nlm.nih.gov/24388483/","line":106},{"title":"fullness which reduces future snacking by 25%","target":"https://pubmed.ncbi.nlm.nih.gov/30591684/","line":106},{"title":"None","target":"https://miro.medium.com/v2/resize:fit:700/0*rzljrqqwusp5nZAK.jpeg","line":110,"embedded":true},{"title":"my books","target":"https://www.doctorjasonfung.com/","line":114},{"title":"TheFastingMethod.com","target":"https://www.thefastingmethod.com/","line":114},{"title":"YouTube channel","target":"https://www.youtube.com/channel/UCoyL4iGArWn5Hu0V_sAhK2w","line":114}],"metadata":{"title":"Conditioned Hunger | by Dr. Jason Fung - Freedium","source":"https://freedium.cfd/https://drjasonfung.medium.com/conditioned-hunger-a0e263dff155","author":null,"published":null,"created":"2025-08-13","description":"Hunger is a Habit","tags":null},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"x40vn2","at":1768747602222},"key":"Bookmarks/Conditioned Hunger  by Dr. Jason Fung - Freedium.md"},
