07,-0.09156778,0.00636516,-0.01171752,0.17807202,0.01636016,-0.01094739,0.02142189,0.02962652,-0.01985267,0.0312121,0.00341001,0.07590408,0.03056962,0.06260763,-0.00936624,0.00036138,0.04776609,-0.00824584,-0.01381129,-0.03078046,-0.00269834,0.06051002,-0.00680099,-0.00887743,-0.03067223,0.12716614,-0.03442397,0.00377045,-0.01633738,0.00908113,0.00564856,0.00964248,0.04676699,0.00438807,0.00229899,0.0052513,0.02358231,-0.02669391,-0.00599098,0.01281052,-0.03572731,0.04518808,-0.00556137,-0.0499652,0.07303809,-0.05502466],"last_embed":{"hash":"yrypb","tokens":447}}},"last_read":{"hash":"yrypb","at":1774939660153},"class_name":"SmartSource","last_import":{"mtime":1774939638525,"size":4191,"at":1774939651562,"hash":"yrypb"},"blocks":{"#---frontmatter---":[1,18],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery":[20,42],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#{1}":[21,25],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#📝 Benim Notlarım":[26,28],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🟡 Genel Bilgiler (Sarı)":[29,31],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🔴 Bulgular (Kırmızı)":[35,37],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/ATF4A373","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/7C72MIAZ?page=1&annotation=45N8LMFZ","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/7C72MIAZ?page=1&annotation=KU9USS2N","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/7C72MIAZ?page=1&annotation=RFS949HI","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/7C72MIAZ?page=1&annotation=5IX5648F","line":39}],"metadata":{"Title":"Development and validation of a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection after radical colorectal cancer surgery","Authors":"Jingxiang Han, Tian Yao, Linna Gao, Huiyang Gao, Yuhao Chen, Yanli Wang, Yinglei Cao, Chengfei Liu, Fubin Qiu, Kai Jia, He Huang","Year":2025,"DOI":"10.1136/bmjopen-2024-087426","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"To develop and validate a risk prediction model related to inflammatory and nutritional indexes for postoperative pulmonary infection (POI) after radical colorectal cancer (CRC) surgery.Univariable and multivariable logistic regression (LR) analyses were used to explore influence factors of POI. Predictive models were constructed using LR, random forest, support vector machine, K-nearest neighbours, naive Bayes and XGBoost. The LR model was used to generate a nomogram for POI prediction.  The discrimination and calibration of the nomogram were assessed using receiver operating characteristic (ROC) curves and calibration curve","Findings":"Independent factors identified from multivariable LR for prediction POI included age, respiratory disease, Systemic Inflammation Response Index, albumin-toglobulin ratio, operative method and operative duration.  The LR model demonstrated the best performance, with an area under the ROC curve of 0.773 (95% CI: 0.674 to 0.872). The nomogram has good differentiation ability, calibration and net benefit. Incorporating inflammatory and nutritional indexes into the nomogram enhanced predictive value compared with models excluding either factor.","Conclusions":"The nomogram related to inflammatory and nutritional indexes may represent a promising tool for predicting POI after radical surgery in CRC patients.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"yrypb","at":1774939659972}},"smart_blocks:hanDevelopmentValidationRisk2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04457926,-0.00509866,0.01139088,-0.02363076,0.01863643,0.01588119,-0.01601224,0.11154964,0.00526644,-0.01848768,0.04385741,-0.07596564,0.01439239,0.00377228,-0.01688052,-0.03831483,0.01050777,0.06580728,-0.099