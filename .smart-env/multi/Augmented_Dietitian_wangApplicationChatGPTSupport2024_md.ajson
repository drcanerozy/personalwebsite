0356,0.01612508,-0.02103955,0.00288163,-0.07359235,0.04060119,-0.01525734,0.18044449,-0.0233871,-0.00554369,0.01700498,-0.04683917,-0.03302518,0.01223474,0.02362824,-0.00553621,0.0191559,0.10728639,0.01257513,0.02071602,0.01448946,-0.01193277,-0.0200581,-0.02486676,-0.0239114,0.01807069,-0.00685953,-0.04542691,-0.0386712,0.07920114,0.01204888,-0.00863616,-0.09091388,-0.0033308,0.00048765,0.00505207,0.01947921,-0.00483767,0.00413821,0.05645257,-0.0394608,-0.01364435,0.0009451,0.01701148,-0.00672614,0.02706625,0.04226685,-0.00950114,0.06233449,-0.03754089],"last_embed":{"hash":"51e6wh","tokens":472}}},"last_read":{"hash":"51e6wh","at":1778067914625},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":5154,"at":1778067901044,"hash":"51e6wh"},"blocks":{"#---frontmatter---":[1,18],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation":[20,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#{1}":[21,25],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#📝 Benim Notlarım":[26,28],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)":[35,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)":[41,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RWZCNDZU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=S7R4IZHN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=6DKKWP9Z","line":36},{"title":"Sayfa 4","target":"zotero://open-pdf/library/items/RKBFCLYY?page=4&annotation=9LFSML73","line":42}],"metadata":{"Title":"Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation","Authors":"Lin-Chun Wang, Hanjie Zhang, Nancy Ginsberg, Andrea Nandorine Ban, Jeroen P. Kooman, Peter Kotanko","Year":2024,"DOI":"10.1053/j.jrn.2024.09.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We tasked ChatGPT-4 with generating a personalized daily meal plan, including nutritional information. Virtual ‘‘patients’’ were generated through Monte Carlo simulation; data from a randomly selected virtual patient were presented to ChatGPT. We provided to ChatGPT patient demographics, food preferences, laboratory data, clinical characteristics, and available budget, to generate a oneday sample menu with recipes and nutritional analyses. The resulting daily recipe recommendations, cooking instructions, and nutritional analyses were reviewed and rated on a five-point Likert scale by an experienced renal dietitian. In addition, the generated content was rated by a renal dietitian and compared with a U. S. Department of Agriculture–approved nutrient analysis software. ChatGPT also analyzed nutrition information of two recipes published online. We also requested a translation of the output into Spanish, Mandarin, Hungarian, German, and Dutch.","Findings":"The renal dietitian rated the recipes at 3 (3, 3) [median (Q1, Q3)], the cooking instructions at 5 (5,5), and the nutritional analysis at 2 (2, 2) on the five-point Likert scale. ChatGPT’s nutritional analysis underestimated calories by 36% (95% CI: 44-88%), protein by 28% (25-167%), fat 48% (29-81%), phosphorus 54% (15-102%), potassium 49% (40-68%), and sodium 53% (14-139%). The nutritional analysis of online available recipes differed only by 0 to 35%. The translations were rated as reliable by native speakers (4 on the five-point Likert scale).","Conclusions":"","Limitations":"LLMs like ChatGPT show promise for providing personalized nutritional guidance to dialysis patients, but significant improvements are necessary. At present, ChatGPT’s nutritional recommendations are not a substitute for personalized medical advice. However, it can be a useful tool for generating meal plans that renal dietitians can then evaluate and adjust according to reference values from validated sources.","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"51e6wh","at":1774939742649},"key":"Augmented Dietitian/wangApplicationChatGPTSupport2024.md"},
