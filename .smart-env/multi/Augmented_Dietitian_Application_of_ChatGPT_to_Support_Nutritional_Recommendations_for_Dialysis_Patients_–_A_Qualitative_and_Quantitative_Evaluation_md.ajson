5932986,0.06878839,-0.04183629,-0.00768444,0.00128829,-0.02623052,0.00749408,-0.02944107,-0.01998367,-0.01274294,0.05399669,-0.01004819,0.09566057,-0.06091354,-0.00424895,0.00350112,0.00686836,-0.02858266,0.00404635,-0.0750901,0.04420718,-0.02033203,0.18005429,-0.02472167,0.01858216,0.0086392,-0.04395879,-0.04246307,-0.00091103,0.02204163,0.00474856,0.01498957,0.10668945,0.00581154,0.02339083,0.01246269,-0.01752004,-0.02087706,-0.02049116,-0.00769954,0.03130402,-0.00286051,-0.04349287,-0.03484518,0.08401688,0.00804337,-0.00686828,-0.08202752,0.00061105,-0.00120495,-0.00339948,0.0318259,-0.00626315,0.00118684,0.06437895,-0.05012893,-0.01621657,0.00573775,0.03020177,-0.00415372,0.02640159,0.04095476,0.00200278,0.06068492,-0.04109398],"last_embed":{"hash":"51e6wh","tokens":465}}},"last_read":{"hash":"51e6wh","at":1769866000927},"class_name":"SmartSource","last_import":{"mtime":1769791401257,"size":5154,"at":1769865999506,"hash":"51e6wh"},"blocks":{"#---frontmatter---":[1,18],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation":[20,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#{1}":[21,25],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#📝 Benim Notlarım":[26,28],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)":[35,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)":[41,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RWZCNDZU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=S7R4IZHN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=6DKKWP9Z","line":36},{"title":"Sayfa 4","target":"zotero://open-pdf/library/items/RKBFCLYY?page=4&annotation=9LFSML73","line":42}],"metadata":{"Title":"Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation","Authors":"Lin-Chun Wang, Hanjie Zhang, Nancy Ginsberg, Andrea Nandorine Ban, Jeroen P. Kooman, Peter Kotanko","Year":2024,"DOI":"10.1053/j.jrn.2024.09.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We tasked ChatGPT-4 with generating a personalized daily meal plan, including nutritional information. Virtual ‘‘patients’’ were generated through Monte Carlo simulation; data from a randomly selected virtual patient were presented to ChatGPT. We provided to ChatGPT patient demographics, food preferences, laboratory data, clinical characteristics, and available budget, to generate a oneday sample menu with recipes and nutritional analyses. The resulting daily recipe recommendations, cooking instructions, and nutritional analyses were reviewed and rated on a five-point Likert scale by an experienced renal dietitian. In addition, the generated content was rated by a renal dietitian and compared with a U. S. Department of Agriculture–approved nutrient analysis software. ChatGPT also analyzed nutrition information of two recipes published online. We also requested a translation of the output into Spanish, Mandarin, Hungarian, German, and Dutch.","Findings":"The renal dietitian rated the recipes at 3 (3, 3) [median (Q1, Q3)], the cooking instructions at 5 (5,5), and the nutritional analysis at 2 (2, 2) on the five-point Likert scale. ChatGPT’s nutritional analysis underestimated calories by 36% (95% CI: 44-88%), protein by 28% (25-167%), fat 48% (29-81%), phosphorus 54% (15-102%), potassium 49% (40-68%), and sodium 53% (14-139%). The nutritional analysis of online available recipes differed only by 0 to 35%. The translations were rated as reliable by native speakers (4 on the five-point Likert scale).","Conclusions":"","Limitations":"LLMs like ChatGPT show promise for providing personalized nutritional guidance to dialysis patients, but significant improvements are necessary. At present, ChatGPT’s nutritional recommendations are not a substitute for personalized medical advice. However, it can be a useful tool for generating meal plans that renal dietitians can then evaluate and adjust according to reference values from validated sources.","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"51e6wh","at":1769866000778}},"smart_blocks:Augmented Dietitian/Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03580076,0.0254332,-0.00498255,-0.03731139,-0.048504