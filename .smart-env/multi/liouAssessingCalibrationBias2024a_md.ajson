-0.11866356,-0.00931494,-0.0319618,0.14763486,-0.04567116,0.00263605,0.0662031,-0.01496634,0.01829945,0.06809992,-0.01682545,0.04336708,-0.02120384,0.1091551,0.04869057,0.01203592,0.09000885,-0.04830197,-0.05122807,0.02673762,0.03869538,0.07092883,-0.00934094,0.00406925,-0.0190064,0.13166668,-0.02929189,0.01235056,-0.0639016,0.03267916,0.00639457,0.0205713,0.01344084,-0.02619164,0.01884791,0.02217281,-0.00820782,-0.02422384,-0.05378078,-0.03009089,-0.08037927,0.03775065,-0.01999573,-0.03423925,0.00148842,-0.06625321],"last_embed":{"hash":"l0l42f","tokens":481}}},"last_read":{"hash":"l0l42f","at":1774939664387},"class_name":"SmartSource","last_import":{"mtime":1774939638567,"size":3659,"at":1774939651578,"hash":"l0l42f"},"blocks":{"#---frontmatter---":[1,18],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system":[20,42],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#{1}":[21,25],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#📝 Benim Notlarım":[26,28],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🟡 Genel Bilgiler (Sarı)":[29,31],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🔴 Bulgular (Kırmızı)":[35,37],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/GK93YMP7","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/4FRZ4BH5?page=1&annotation=T2KEQZCB","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/4FRZ4BH5?page=1&annotation=NQGQJWJ3","line":36}],"metadata":{"Title":"Assessing calibration and bias of a deployed machine learning malnutrition prediction model within a large healthcare system","Authors":"Lathan Liou, Erick Scott, Prathamesh Parchure, Yuxia Ouyang, Natalia Egorova, Robert Freeman, Ira S. Hofer, Girish N. Nadkarni, Prem Timsina, Arash Kia, Matthew A. Levin","Year":2024,"DOI":"10.1038/s41746-024-01141-5","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"costs. The Mount Sinai Health System (MSHS) deployed a machine learning model (MUSTPlus) to detect malnutrition upon hospital admission. However, in diverse patient groups, a poorly calibrated model may lead to misdiagnosis, exacerbating health care disparities. We explored the model’s calibration across different variables and methods to improve calibration. Data from adult patients admitted to five MSHS hospitals from January 1, 2021 - December 31, 2022, were analyzed.  We compared MUST-Plus prediction to the registered dietitian’s formal assessment. Hierarchical calibration was assessed and compared between the recalibration sample (N = 49,562) of patients admitted between January 1, 2021 - December 31, 2022, and the hold-out sample (N = 17,278) of patients admitted between January 1, 2023 - September 30, 20","Findings":"The original MUST-Plus model showed significant differences in calibration between White vs. Black patients. It also overestimated malnutrition in females compared to males. Logistic recalibration effectively reduced miscalibration across all patient subgroups. Continual monitoring and timely recalibration can improve model accuracy.","Conclusions":"","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"l0l42f","at":1774939664232}},"smart_blocks:liouAssessingCalibrationBias2024a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.0499801,-0.00934452,0.01017576,-0.01424461,0.00330257,-0.00581015,-0.04904549,0.06242263,0.03617699,0.03583354,0.02841481,-0.10373697,-0.01242154,0.05955179,0.03435275,-0.00883575,0.0095636,0.0409974,-0.02662944,0.01972712,0.03379042,0.00228879,-0.00564857,0.02093653,0.06866173,-0.01342535,-0.04215337,-0.04894971,-0.08165552,-0.25523701,0.01226022,-0.05945179,0.05178729,-0.07174432,-0.01670648,-0.01699463,0.01642212,0.04899231,-0.03188924,0.05840188,0.04325523,0.04885281,0.01896628,-0.00747707,-0.00500726,-0.03930172,-0.03101818,0.0388333,-0.05425673,0.02930873,-0.07018242,-0.07506061,0.02022661,0.05397624,0.03439585,0.00353489,0.05793905,0.02772385,0.03824019,0.01634811,0.06421904,0.04681082,-0.2261751,0.02539438,0.08619888,0.02433132,0.01322857,-0.05545593,-0.02181475,-0.0105013,-0.04408686,0.01092296,0.04162206,0.04266293,-0.00572425,-0.01248223,0.06300616,-0.01020176,0.01144306,-0.02776958,-0.00408669,0.06359366,-0.00861826,-0.00799712,0.01518058,-0.05467242,-0.04801514,-0.03273899,0.05637369,-0.05168134,-0.02654085,-0.04247053,0.00287592,0.00924255,-0.0690761,0.02556344,0.00445894,0.00718832,-0.05607658,0.09818842,-0.02444848,0.01088027,-0.005512,-0.00851786,0.06252526,-0.07749717,-0.04137043,-0.03140343,-0.01338291,-0.0091678,-0.01146366,-0.0095724,0.04774486,-0.03437156,-0.06943987,0.04204756,0.07584742,0.0528986,0.02341284,-0.01815415,-0.06112774,-0.000394