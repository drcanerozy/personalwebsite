.00151618,-0.00279266,0.01627643,-0.02230254,0.00468185,-0.07469044,0.0443155,-0.01571441,0.1780872,-0.02579483,-0.00269152,0.0177944,-0.04453802,-0.03359358,0.00621243,0.02172604,0.00282596,0.02160649,0.10521021,0.01059488,0.02659492,0.01049776,-0.01545899,-0.01994498,-0.02816091,-0.02450242,0.02307765,-0.01193559,-0.04660226,-0.03627475,0.0818324,0.00848011,-0.00705493,-0.09421986,-0.00283151,-0.00192933,0.00623328,0.01821156,-0.00861216,0.0086866,0.05563394,-0.03434377,-0.01664005,0.00278555,0.02040588,-0.01012235,0.02591338,0.03763897,-0.0071209,0.06814207,-0.0318],"last_embed":{"hash":"51e6wh","tokens":475}}},"last_read":{"hash":"51e6wh","at":1774939558270},"class_name":"SmartSource","last_import":{"mtime":1774939523933,"size":5154,"at":1774939536768,"hash":"51e6wh"},"blocks":{"#---frontmatter---":[1,18],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation":[20,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#{1}":[21,25],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#📝 Benim Notlarım":[26,28],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)":[35,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)":[41,42],"#Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RWZCNDZU","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=S7R4IZHN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/RKBFCLYY?page=1&annotation=6DKKWP9Z","line":36},{"title":"Sayfa 4","target":"zotero://open-pdf/library/items/RKBFCLYY?page=4&annotation=9LFSML73","line":42}],"metadata":{"Title":"Application of ChatGPT to Support Nutritional Recommendations for Dialysis Patients – A Qualitative and Quantitative Evaluation","Authors":"Lin-Chun Wang, Hanjie Zhang, Nancy Ginsberg, Andrea Nandorine Ban, Jeroen P. Kooman, Peter Kotanko","Year":2024,"DOI":"10.1053/j.jrn.2024.09.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We tasked ChatGPT-4 with generating a personalized daily meal plan, including nutritional information. Virtual ‘‘patients’’ were generated through Monte Carlo simulation; data from a randomly selected virtual patient were presented to ChatGPT. We provided to ChatGPT patient demographics, food preferences, laboratory data, clinical characteristics, and available budget, to generate a oneday sample menu with recipes and nutritional analyses. The resulting daily recipe recommendations, cooking instructions, and nutritional analyses were reviewed and rated on a five-point Likert scale by an experienced renal dietitian. In addition, the generated content was rated by a renal dietitian and compared with a U. S. Department of Agriculture–approved nutrient analysis software. ChatGPT also analyzed nutrition information of two recipes published online. We also requested a translation of the output into Spanish, Mandarin, Hungarian, German, and Dutch.","Findings":"The renal dietitian rated the recipes at 3 (3, 3) [median (Q1, Q3)], the cooking instructions at 5 (5,5), and the nutritional analysis at 2 (2, 2) on the five-point Likert scale. ChatGPT’s nutritional analysis underestimated calories by 36% (95% CI: 44-88%), protein by 28% (25-167%), fat 48% (29-81%), phosphorus 54% (15-102%), potassium 49% (40-68%), and sodium 53% (14-139%). The nutritional analysis of online available recipes differed only by 0 to 35%. The translations were rated as reliable by native speakers (4 on the five-point Likert scale).","Conclusions":"","Limitations":"LLMs like ChatGPT show promise for providing personalized nutritional guidance to dialysis patients, but significant improvements are necessary. At present, ChatGPT’s nutritional recommendations are not a substitute for personalized medical advice. However, it can be a useful tool for generating meal plans that renal dietitians can then evaluate and adjust according to reference values from validated sources.","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"51e6wh","at":1774939558118}},"smart_blocks:Augmented Dietitian Okunmuşlar/wangApplicationChatGPTSupport2024.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03666728,0.02095098,0.0023638,-0.03067654,-0.04020188,0.02181049,-0.01718579,0.05599029,-0.02423942,0.00846687,-0.02473019,-0.09486655,0.02282684,0.05774977,0.05082032,0.00669048,0.04540978,-0.01858129,-0.04139566,-0.017894,0.09069458,-0.07389398,0.01324838,-0.01456986,0.0794795,0.00096951,-0.0029095