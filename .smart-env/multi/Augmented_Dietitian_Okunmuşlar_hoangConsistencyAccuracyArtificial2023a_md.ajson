0.03972996,-0.0415975,-0.01244048,0.03119209,-0.07630441,0.01704984,-0.07639083,0.01201791,0.04438061,0.21319489,-0.05927441,0.00229002,0.04146611,-0.00743537,-0.02099993,0.02392776,-0.01847076,-0.0082666,0.01974984,0.07283776,0.02245586,0.02629057,0.05604969,-0.06468411,-0.05675468,-0.02645659,-0.01802294,0.03045687,0.0152166,-0.01865221,-0.04995188,0.12420713,0.02018503,-0.03638633,-0.04880168,-0.03033582,-0.01347558,0.01604784,-0.02018383,-0.01815308,-0.00496648,0.02426848,-0.04295703,-0.01580991,-0.00901653,-0.03317611,-0.01983889,0.02814589,0.00842626,-0.03029003,0.09456997,-0.06377096],"last_embed":{"hash":"d6yh3q","tokens":481}}},"last_read":{"hash":"d6yh3q","at":1774939546053},"class_name":"SmartSource","last_import":{"mtime":1774939523511,"size":5101,"at":1774939536719,"hash":"d6yh3q"},"blocks":{"#---frontmatter---":[1,18],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information":[20,50],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#{1}":[21,25],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#📝 Benim Notlarım":[26,36],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#📝 Benim Notlarım#{1}":[27,28],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#📝 Benim Notlarım#{2}":[29,36],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟡 Genel Bilgiler (Sarı)":[37,39],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟢 Yöntem & Örneklem (Yeşil)":[40,42],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟢 Yöntem & Örneklem (Yeşil)#{1}":[41,42],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔴 Bulgular (Kırmızı)":[43,45],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔴 Bulgular (Kırmızı)#{1}":[44,45],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔵 Sonuç / Conclusions (Mavi)":[46,48],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔵 Sonuç / Conclusions (Mavi)#{1}":[47,48],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟠 Limitasyonlar (Turuncu)":[49,50]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/MQ79MFR2","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/SUBMMTDE?page=1&annotation=2ZVYDDM3","line":41},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/SUBMMTDE?page=1&annotation=FGC2SDGU","line":41},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/SUBMMTDE?page=1&annotation=KQDSLFZR","line":44},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/SUBMMTDE?page=2&annotation=LQIWCHKC","line":47}],"metadata":{"Title":"Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information","Authors":"Yen Nhi Hoang, Ya-Ling Chen, Dang Khanh Ngan Ho, Wan-Chun Chiu, Khang-Jin Cheah, Noor Rohmah Mayasari, Jung-Su Chang","Year":2023,"DOI":"10.1001/jamanetworkopen.2023.50367","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The aim of the study was to compare the reliability of ChatGPT-3.5 (chatbot 1) and ChatGPT-4 (chatbot 2) in providing information on the calorie and macronutrient content (carbohydrates, fats, and proteins) for 8 menus designed for adults (222 food items)A search was performed between September and October 2023 using the following prompt: “As a dietitian, please draw a table to calculate line by line the energy (kcal)/carbohydrates (g)/lipids (g)/proteins (g) of the following food items (raw, not cooked).” The consistency of AI responses was determined on the basis of the coefficient variation (CV) for each food item across 5 repeated measurements. To assess the accuracy of responses, we cross-referenced the AI answers with nutritionists’ recommendations based on the food composition database of the Taiwanese Food and Drug Administration.","Findings":"No significant differences were observed between nutritionist and AI estimations of energy, carbohydrate, and fat contents of 8 menus designed for adults, but there was a significant difference in protein estimation. Both chatbots provided accurate energy contents for approximately 35% to 48% of the 222 food items within ±10%, with a CV of less than 10% (Table). Chatbot 2 performed better than chatbot 1, but it overestimated protein.","Conclusions":"Although AI chatbots are designed to be probabilistic, the results of this cross-sectional study suggest that AI can be a useful and convenient tool for people who want to know the energy and macronutrient information of their foods. Although AI chatbots cannot replace nutritionists, they may provide real-time analysis of foods, and the capacity to harness AI technology in a supportive role may fundamentally transform the way nutritionists communicate with patients.5","Limitations":"","User_Notes":"letter  dyt karşılaştırması var  dyt= ai çıkmış  prompt var  dyt ile ai yer değiştiremez beyanı var"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"d6yh3q","at":1774939545894}},"smart_blocks:Augmented Dietitian Okunmuşlar/hoangConsistencyAccuracyArtificial2023a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05360024,0.01204464,0.00372764,0.00287511,0.01515682,-0.00910836,0.01734426,0.03823458,-0.01014171,-0.00059445,-0.00846743,-0.14026509,0.03209027,0.0419493,0.04985488,-0.0114632,0.04000063,-0.00933325,-0.02734124,0.01370188,0.08655906,-0.0747778,0.02131619,-0.0083299,0.03737044,0.0277467,-0.02785957,0.00311206,-0.04325026,-0.23441231,0.03714132,-0.02457701,0.08598404,-0.05525182,-0.05689459,0.05363246,0.