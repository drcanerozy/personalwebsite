[36,37],"#Development of deep-learning tool to predict appropriate height and weight from chest radiographs in bedridden patients#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Development of deep-learning tool to predict appropriate height and weight from chest radiographs in bedridden patients#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Development of deep-learning tool to predict appropriate height and weight from chest radiographs in bedridden patients#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/55QME7ZY","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/NKZAY27V?page=1&annotation=H2DKV6TX","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/NKZAY27V?page=1&annotation=SCLYD6PR","line":33},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/NKZAY27V?page=2&annotation=W6AA79V7","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/NKZAY27V?page=2&annotation=2T7NKGM6","line":39}],"metadata":{"Title":"Development of deep-learning tool to predict appropriate height and weight from chest radiographs in bedridden patients","Authors":"Yasuhiko Nakao, Ryo Sasaki, Fumihiro Mawatari, Kotaro Harakawa, Minoru Okita, Norisato Mitsutake, Kazuhiko Nakao","Year":2023,"DOI":"10.1016/j.nutos.2023.08.005","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aimed to illustrate the potential of a convolutional neural network model to assess the height and weight based on chest radiographs.A convolutional neural network was used to predict the height and weight of the patients (Juzen NST). A ResNet152 classifier was trained using Fastai (V1.0) running on PyTorch to predict the height and weight. Training was performed for four epochs using validation without augmentation.","Findings":"Our chest radiographic prediction model has a high correlation with actual height and weight and can be combined with information regarding clinical nutrition factors for rapid assessment of risk for malnutrition","Conclusions":"area. Importantly, our model is an illustration of the potential of automated imaging artificial intelligence for proper nutrition prediction models in older adults.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"b6ab6w","at":1774939750757},"key":"Augmented Dietitian/nakaoDevelopmentDeeplearningTool2023a.md"},
