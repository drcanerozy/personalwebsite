2455,-0.03092794,-0.0299834,0.01166084,-0.04609079,0.03038246,-0.10409637,-0.00065539,0.02434384,0.19124845,-0.06064859,0.01457074,0.05737668,0.01518845,-0.03747866,0.03845122,-0.00396316,0.0124934,0.0181584,0.1038169,-0.0106092,0.03732485,0.0631285,-0.02216581,-0.04669098,-0.0321904,-0.00955159,0.03063671,0.02388026,-0.0242652,-0.03466343,0.09035639,0.00440776,-0.0264817,-0.04994222,-0.02593184,-0.00668586,0.01594831,-0.01352863,-0.01476855,-0.00049129,0.04520794,-0.03047821,-0.00637202,0.02766125,-0.02023399,-0.04968593,0.0305958,-0.02559114,-0.02841149,0.11798796,-0.04555892],"last_embed":{"hash":"3ooy29","tokens":434}}},"last_read":{"hash":"3ooy29","at":1774939539104},"class_name":"SmartSource","last_import":{"mtime":1774939523315,"size":3502,"at":1774939536683,"hash":"3ooy29"},"blocks":{"#---frontmatter---":[1,18],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?":[20,42],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#{1}":[21,25],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#📝 Benim Notlarım":[26,28],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟡 Genel Bilgiler (Sarı)":[29,31],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔴 Bulgular (Kırmızı)":[35,37],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/27APW4AP","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=3IW7MBGN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=MSK8DKDS","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=N5XFYJL9","line":39}],"metadata":{"Title":"Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?","Authors":"Hatice Merve Bayram, Zehra Margot Çelik, Hatice Kübra Barcın Güzeldere","Year":2025,"DOI":"10.1177/02601060251329070","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"A comparative content analysis was conducted using ChatGPT-4o, and ChatGPT-4 to generate 1800 kcal daily diet plans for a 20-year-old female with obesity. AI models provided recommendations for dietary management, the nutrition care process, and menu planning. Three dietitians evaluated the outputs","Findings":"ChatGPT-generated menus were inconsistent with dietary recommendations. Both ChatGPT-4o and ChatGPT-4 offered 5-day menu samples with low calorie content of “1800 kcal prompt” compared to the TDG-2022 (P < 0.001 for ChatGPT-4o). Additionally, key nutrients, particularly fats (P = 0.003), carbohydrates (%), potassium, and calcium (P < 0.05 for all) were inadequately compared to the TDG-2022. Nutrient analysis revealed that both models underperformed in meeting recommended intakes for critical micronutrients such as calcium, and had an unbalanced distribution of macronutrients","Conclusions":"ChatGPT-4o and ChatGPT-4 have limitations when used to provide accurate dietary management.  While AI chatbots offer useful insights, they cannot replace expertise of dietitians in clinical planning; as a result, caution is advised when using these tools in this context.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"3ooy29","at":1774939538944}},"smart_blocks:Augmented Dietitian Okunmuşlar/bayramCanArtificialIntelligence2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03621345,0.01046236,0.03106538,0.00842942,-0.01990812,0.00084405,-0.01663435,0.06513359,-0.02146192,0.00237656,-0.00437533,-0.10890535,0.00393577,0.03991907,0.0765259,-0.00493563,0.0193582,-0.02347945,0.00488464,0.00005622,0.09988776,-0.02818287,-0.01431488,0.02866123,0.02176085,0.03560648,-0.02469271,-0.0223193,-0.05514113,-0.20860596,0.03558868,-0.01557721,0.09931099,-0.03548913,-0.08157649,0.06948401,-0.0001397,0.03238229,-0.05861279,0.02671023,0.05954364,0.0094552,0.05414959,-0.0005334,0.03490682,-0.01396969,-0.02813638,0.01120972,-0.06916691,0.0168728,0.00124506,0.00769298,0.03376438,0.02411306,0.01052286,0.02765461,0.03865139,0.04478721,0.04558308,0.05841298,0.01612962,0.07240277,-0.19714193,0.08997025,-0.00927372,0.04354428,-0.07012944,0.01771585,0.00936876,-0.01107503,-0.02246808,-0.01087157,0.05881702,0.00398109,0.02847084,0.00861414,0.05267442,-0.04618745,0.01626623,-0.00080513,-0.02936759,0.0450244,-0.0333105,-0.00670655,-0.04820829,-0.04770993,-0.04374531,-0.03274591,0.06349032,0.01588499,-0.01824895,-0.03485775,0.00211502,0.01091183,-0.00799042,-0.00911389,-0.00837159,-0.00697846,-0.08536972,0.11278241,-0.01162358,-0.02197132,-0.01527701,0.02899138,0.03037494,-0.0600865,-0.07821041,-0.05388178,0.00126229,0.07496189,-0.03951209,0.01487228,0.01043114,0.00953785,-0.0306737,0.03976253,0.09737616,-0.01376408,0.03586