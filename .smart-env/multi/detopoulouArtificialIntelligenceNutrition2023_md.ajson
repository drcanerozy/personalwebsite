-0.04164693,0.03015766,-0.09828003,-0.00706681,0.01883566,0.18862426,-0.03355629,-0.03338533,0.02752193,-0.02851712,-0.00892233,-0.0103211,-0.02027081,0.00450279,0.01673901,0.0724663,-0.00383742,0.04415592,0.04588157,-0.04572622,-0.0588907,0.01262821,0.00360473,-0.00308599,-0.0055905,0.05720482,-0.00211026,0.09218737,-0.00015087,-0.04299488,0.00709507,-0.01471688,0.0358184,0.02960107,-0.02941778,0.0025143,0.01590877,0.03784763,-0.03050361,0.02484386,-0.00922103,-0.00661697,-0.07317603,0.02696692,-0.00096326,-0.09096126,0.07704312,-0.04605052],"last_embed":{"hash":"1dqvvdv","tokens":471}}},"last_read":{"hash":"1dqvvdv","at":1774939657495},"class_name":"SmartSource","last_import":{"mtime":1774939638475,"size":3722,"at":1774939651554,"hash":"1dqvvdv"},"blocks":{"#---frontmatter---":[1,18],"#Artificial intelligence, nutrition, and ethical issues: A mini-review":[20,42],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#{1}":[21,25],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#📝 Benim Notlarım":[26,28],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🟡 Genel Bilgiler (Sarı)":[29,31],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔴 Bulgular (Kırmızı)":[35,37],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Artificial intelligence, nutrition, and ethical issues: A mini-review#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LMQDZ2F2","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/S3YM6NTI?page=1&annotation=VUR9NI76","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/S3YM6NTI?page=2&annotation=73ZJY7WQ","line":36},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/S3YM6NTI?page=2&annotation=R5CPEPST","line":39}],"metadata":{"Title":"Artificial intelligence, nutrition, and ethical issues: A mini-review","Authors":"Paraskevi Detopoulou, Gavriela Voulgaridou, Panagiotis Moschos, Despoina Levidi, Thelma Anastasiou, Vasilios Dedes, Eirini- Maria Diplari, Nikoleta Fourfouri, Constantinos Giaginis, Georgios I. Panoutsopoulos, Sousana K. Papadopoulou","Year":2023,"DOI":"10.1016/j.nutos.2023.07.001","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"","Findings":"In general, AI should do no harm and contribute to human well-being, while AI professionals should be honest, trustful, and fair. Privacy and confidentiality should be protected. Other concerns include the “dehumanization” of care, social disparities, responsibility assignment in case of errors or malfunctions, and bias in training models and delivering care. Moreover, the prediction of disease onset in high-risk individuals may be connected to stigma, over-medicalization, and stress. There is also a serious concern that AI systems in the field of nutrition and dietetics may cause a partial replacement of dietitians; however, health professionals can usesuch technologies as part of their work. The use of AI applications for persons with mental diseases or eating disorders is also crucial","Conclusions":"In conclusion, AI-assisted personalized nutrition needs further justification, while the regulatory framework requires a constant update to keep up with scientific advancements and address ethical issues. Coordinated global focus on these domains could effectively lead to a more embraced AI implementation in individuals and populations.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1dqvvdv","at":1774939657315}},"smart_blocks:detopoulouArtificialIntelligenceNutrition2023.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02152555,0.02341427,0.01389121,-0.0360527,-0.00608191,-0.01628673,0.04181344,0.06684117,0.02224579,-0.01461922,-0.01736771,-0.07621273,0.00526397,0.03838303,0.05567256,-0.00399588,0.01477193,0.01323198,-0.04173046,0.00910881,0.05576717,-0.04553833,0.00441132,-0.03483816,-0.0415371,0.00598029,-0.02760245,-0.0393649,-0.06322257,-0.18758324,0.02321259,-0.00995541,0.0604872,-0.01941443,-0.03187826,0.03156268,0.00896839,0.02902227,-0.01466677,0.06718209,0.0197055,-0.02685376,-0.00850965,-0.04283702,-0.01498758,0.00059826,-0.0652361,0.00344899,-0.09135953,-0.01596665,-0.03423415,0.00976363,0.00338985,0.06046314,0.05206615,0.03015507,0.05496822,0.03004309,0.01867832,0.08967575,0.04858683,0.05094417,-0.19284296,0.10412007,0.06077692,0.07709128,-0.04157871,-0.0239959,-0.00063519,-0.05634323,-0.04925745,0.02626196,0.05439057,0.04083752,0.02079436,0.03753112,0.03738295,-0.04414232,0.00810391,-0.02141417,0.03085066,0.06770174,-0.02709966,0.02707274,-0.08114441,-0.00653188,0.01807286,-0.08262184,0.0476821,-0.05896417,-0.03744607,-0.03753627,0.04347714,0.03844244,0.03587065,-0.00264585,-0.03629382,-0.00736613,-0.07461628,0.07602915,-0.04089157,-0.03224784,-0.00738616,0.01452551,0.02853329,-0.02405669,-0.03080431,-0.0873467,0.00052952,0.04249886,-0.01405686,-0.00807832,0.04915962,0.02525187,-0.03835421,0.08078345,0.08520477,0.01625912,0.01912393,-0.01346075,-0.02475139,0.03316689,0.08695561,0.02861959,-0.00390246,-0.0009129,-0.00563635,0.09598617,-0.00312457,-0.00459186,0.09528217,-0.00659362,-0.02183186,-0.01201876,-0.00210581,-0.03114785,0.02763925,-0.01864671,-0.02848357,0.03627535,-0.03333001,-0.01036239,0.00109308,-0.11099089,-0.04381927,0.15927167,0.05627385,0.03575276,0.000318,-0.03053358,0.03608744,0.03428429,-0.04950879,0.00012165,0.01657472,0.01996967,0.00491004,0.03480