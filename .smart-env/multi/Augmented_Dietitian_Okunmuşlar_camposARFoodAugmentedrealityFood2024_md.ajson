41,0.04633029,0.05529799,-0.02459798,0.04381285,-0.09814271,0.01539307,0.04484445,0.17403843,-0.10184242,-0.04843004,0.06055854,0.0198562,-0.02266536,0.01102315,0.03083568,-0.0130505,-0.00866611,0.06127952,0.03280542,0.02478198,0.00825936,-0.01202845,-0.04216113,-0.02391216,0.00754694,0.05579119,0.02387704,-0.02580845,-0.03614496,0.08649496,0.02242927,0.01256282,-0.05652782,-0.00733561,-0.01559342,-0.00899966,-0.07455663,-0.00044182,0.02542293,0.05266863,0.03818597,-0.00422337,0.0065384,0.00161021,-0.01453126,0.04459939,0.03482057,0.00189745,0.02726844,-0.02375538],"last_embed":{"hash":"io5lnr","tokens":427}}},"last_read":{"hash":"io5lnr","at":1774939540447},"class_name":"SmartSource","last_import":{"mtime":1774939523342,"size":4012,"at":1774939536692,"hash":"io5lnr"},"blocks":{"#---frontmatter---":[1,18],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction":[20,42],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#{1}":[21,25],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#📝 Benim Notlarım":[26,28],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🟡 Genel Bilgiler (Sarı)":[29,31],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🔴 Bulgular (Kırmızı)":[35,37],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🟠 Limitasyonlar (Turuncu)":[41,42],"#ARFood: an augmented-reality food diary app for asynchronous collaborative interaction#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/A43UVNAQ","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HN4YIXSB?page=1&annotation=YKJSLB8E","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HN4YIXSB?page=1&annotation=VMPN7B82","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HN4YIXSB?page=1&annotation=RPJUF867","line":39},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/HN4YIXSB?page=9&annotation=7V6UD8B5","line":42},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/HN4YIXSB?page=9&annotation=AMMRRYWK","line":42}],"metadata":{"Title":"ARFood: an augmented-reality food diary app for asynchronous collaborative interaction","Authors":"João Pedro Assunção Campos, Guilherme Afonso Madalozzo, Ana Luisa Sant'Anna Alves, Rafael Rieder","Year":2024,"DOI":"10.5753/jis.2024.4346","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"his work presents the development and evaluation of ARFood, a mobile app for cooperation between nutritionists and patients through records in a food diary, including Augmented Reality resources, Computer Vision and Artificial Intelligence for food recognition, and asynchronous collaboration. We used Unity to create the app, integrating different libraries such as LogMeal for food recognition, EDAMAM for nutritional analysis, Vuforia for augmented reality interaction, and Firebase for cloud data storage. We proceed with a pilot study with six nutritionistpatient pairs to validate the technology acceptan","Findings":"Despite this, nutritionists and patients (83.3%) reported that they would recommend using the application as a tool for recording and monitoring a food diary","Conclusions":"Augmented reality and computer vision proved to be outstanding resources for a Nutrition app, showing a potential usage trend as long as the insertion of more digital content and a food recognition model to recognize regional cuisine.","Limitations":"Some of the limitations of this study are related to the difficulty of identifying foods by the APIs found. We could not analyze the hit rate of paid APIs, thus limiting the choice of this type of technoloThe low hit rate of the API tested showed that this functionality needs to consider better AI models for food recogni","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"io5lnr","at":1774939540320}},"smart_blocks:Augmented Dietitian Okunmuşlar/camposARFoodAugmentedrealityFood2024.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06857462,0.00379684,-0.01995711,-0.00813,0.0088726,-0.01475761,-0.02343774,-0.0020057,-0.01467425,0.02087411,-0.01035224,-0.07641873,0.02575934,0.0466739,0.08033639,-0.03747555,0.01957287,-0.00087251,-0.0107278,-0.00940003,0.07280279,-0.05491666,0.01716669,0.0132533,0.018966,0.09619186,-0.03924889,-0.03284388,-0.03700647,-0.20355086,0.02623555,-0.01634767,0.09649202,-0.01996384,-0.0828835,0.02866645,0.00556696,0.03702709,-0.04009561,0.02545283,0.0441681,-0.00229911,0.00834176,-0.00208475,-0.01771795,-0.03142658,-0.04473835,-0.01363002,-0.07269175,-0.00534849,-0.02391171,-0.00164907,0.00869078,-0.01391166,0.00852574,0.06360351,0.03721498,0.01654243,0.04382781,0.09174225,0.05641717,0.02723981,-0.16223836,0.10558943,0.02269503,-0.01951944,-0.06172371,-0.01578625,0.01188344,-0.08838406,-0.05100977,0.02657086,0.05903077,0.0384248,0.05549115,-0.02210172,0.05755621,-0.06498926,-0.03002978,-0.02304715,-0.03367146,0.07060241,-0.05482429,0.01096406,-0.0469536,-0.00486627,0.0255849,-0.03465423,0.0582867,-0.03607049,-0.06875962,-0.0207425,0.01