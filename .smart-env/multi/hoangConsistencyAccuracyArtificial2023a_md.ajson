.0116384,-0.07061958,0.01210203,0.0372442,0.21828617,-0.04884737,0.00675089,0.03979222,-0.01713539,-0.01018895,0.02592344,-0.01385071,-0.01844333,0.01794239,0.06864294,0.01264558,0.02291414,0.05826582,-0.05997252,-0.05829432,-0.01778949,-0.01693012,0.02338254,0.02343577,-0.0268604,-0.05750686,0.12834574,0.02124438,-0.04255764,-0.0448006,-0.02930124,-0.01121047,0.01019504,-0.03048914,-0.01396604,-0.00524963,0.02730303,-0.02906526,-0.01224697,-0.00868443,-0.04261526,-0.01827188,0.02877063,0.00498274,-0.03025923,0.09719798,-0.06721842],"last_embed":{"hash":"d6yh3q","tokens":478}}},"last_read":{"hash":"d6yh3q","at":1774939660673},"class_name":"SmartSource","last_import":{"mtime":1774939638527,"size":5101,"at":1774939651565,"hash":"d6yh3q"},"blocks":{"#---frontmatter---":[1,18],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information":[20,50],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#{1}":[21,25],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#📝 Benim Notlarım":[26,36],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#📝 Benim Notlarım#{1}":[27,28],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#📝 Benim Notlarım#{2}":[29,36],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟡 Genel Bilgiler (Sarı)":[37,39],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟢 Yöntem & Örneklem (Yeşil)":[40,42],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟢 Yöntem & Örneklem (Yeşil)#{1}":[41,42],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔴 Bulgular (Kırmızı)":[43,45],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔴 Bulgular (Kırmızı)#{1}":[44,45],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔵 Sonuç / Conclusions (Mavi)":[46,48],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🔵 Sonuç / Conclusions (Mavi)#{1}":[47,48],"#Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information#🟠 Limitasyonlar (Turuncu)":[49,50]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/MQ79MFR2","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/SUBMMTDE?page=1&annotation=2ZVYDDM3","line":41},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/SUBMMTDE?page=1&annotation=FGC2SDGU","line":41},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/SUBMMTDE?page=1&annotation=KQDSLFZR","line":44},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/SUBMMTDE?page=2&annotation=LQIWCHKC","line":47}],"metadata":{"Title":"Consistency and Accuracy of Artificial Intelligence for Providing Nutritional Information","Authors":"Yen Nhi Hoang, Ya-Ling Chen, Dang Khanh Ngan Ho, Wan-Chun Chiu, Khang-Jin Cheah, Noor Rohmah Mayasari, Jung-Su Chang","Year":2023,"DOI":"10.1001/jamanetworkopen.2023.50367","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The aim of the study was to compare the reliability of ChatGPT-3.5 (chatbot 1) and ChatGPT-4 (chatbot 2) in providing information on the calorie and macronutrient content (carbohydrates, fats, and proteins) for 8 menus designed for adults (222 food items)A search was performed between September and October 2023 using the following prompt: “As a dietitian, please draw a table to calculate line by line the energy (kcal)/carbohydrates (g)/lipids (g)/proteins (g) of the following food items (raw, not cooked).” The consistency of AI responses was determined on the basis of the coefficient variation (CV) for each food item across 5 repeated measurements. To assess the accuracy of responses, we cross-referenced the AI answers with nutritionists’ recommendations based on the food composition database of the Taiwanese Food and Drug Administration.","Findings":"No significant differences were observed between nutritionist and AI estimations of energy, carbohydrate, and fat contents of 8 menus designed for adults, but there was a significant difference in protein estimation. Both chatbots provided accurate energy contents for approximately 35% to 48% of the 222 food items within ±10%, with a CV of less than 10% (Table). Chatbot 2 performed better than chatbot 1, but it overestimated protein.","Conclusions":"Although AI chatbots are designed to be probabilistic, the results of this cross-sectional study suggest that AI can be a useful and convenient tool for people who want to know the energy and macronutrient information of their foods. Although AI chatbots cannot replace nutritionists, they may provide real-time analysis of foods, and the capacity to harness AI technology in a supportive role may fundamentally transform the way nutritionists communicate with patients.5","Limitations":"","User_Notes":"letter  dyt karşılaştırması var  dyt= ai çıkmış  prompt var  dyt ile ai yer değiştiremez beyanı var"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"d6yh3q","at":1774939660470}},"smart_blocks:hoangConsistencyAccuracyArtificial2023a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04094824,0.02527716,0.00682528,0.00181381,0.02457932,-0.00384645,0.0176522,0.03562414,-0.01846042,-0.00920417,-0.00570786,-0.13905422,0.03716198,0.04493574,0.04437886,-0.00918653,0.03692058,-0.01183553,-0.03547486,0.02116681,0.08603565,-0.07880503,0.01883495,-0.01845859,0.04184074,0.02250029,-0.02890017,0.00697209,-0.04049734,-0.24024074,0.03653885,-0.02399012,0.07732794,-0.05129391,-0.04838327,0.04433078,0.02273252,0.02489963,-0.01432175,0.01918309,0.04956858,0.00712025,0.03544629,-0.02294015