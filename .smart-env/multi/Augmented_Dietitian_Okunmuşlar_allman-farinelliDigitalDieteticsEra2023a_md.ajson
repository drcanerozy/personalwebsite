&annotation=TJDM3WGQ","line":39}],"metadata":{"Title":"Digital dietetics and the era of artificial intelligence","Authors":"Margaret Allman‐Farinelli","Year":2023,"DOI":"10.1111/1747-0080.12841","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"","Findings":"","Conclusions":"The best artificial intelligence chatbot may recognise human emotions but cannot develop its own emotions that are so important when we counsel patients. As with all technologies, dietitians will need to explore the benefits, beware the detriments, and develop ethics around responsible uses in their future practice.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"6nlhtl","at":1774939537577}},"smart_blocks:Augmented Dietitian Okunmuşlar/allman-farinelliDigitalDieteticsEra2023a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04835479,0.0031611,0.03678799,0.01615395,-0.03736912,-0.03689233,0.03419844,0.04194584,0.00542758,-0.00693732,-0.00436183,-0.0604271,-0.00049472,0.03303593,0.07895241,0.04990638,0.05906926,0.00568794,0.00389559,0.01619659,0.06474341,-0.05428291,0.01422793,0.00606486,-0.01196825,0.01981274,-0.0291591,-0.02353928,-0.03468601,-0.17755274,0.03112303,-0.01530441,0.12228788,-0.02092183,-0.02318155,0.0319196,-0.02025434,0.0222443,-0.03910131,0.02009396,-0.01003733,-0.02521195,0.03319157,-0.01604299,0.01606631,-0.01422946,-0.01065579,-0.00538834,-0.09264762,-0.03189496,-0.02214297,-0.00220747,0.03708427,0.03164654,0.01841848,0.01581553,0.03255649,0.06888443,0.02249916,0.03982644,0.02751795,0.08054599,-0.18633008,0.09469231,-0.01182796,0.04644655,-0.06877091,-0.02298318,0.04448775,0.00361242,-0.02994488,-0.02381704,0.0509354,-0.01506242,0.03675796,0.01807404,0.05908608,-0.06029714,0.06499261,0.0004642,-0.00705969,0.08186704,-0.06948514,0.00750841,-0.03781319,-0.03643941,0.04269706,-0.06010397,0.01638559,0.03044