4,0.0097064,0.030154,-0.01624615,0.06785481,-0.08382915,-0.01117225,0.00232075,0.18553968,-0.05690461,-0.05272051,0.03806375,0.01802552,-0.04626332,0.03098842,0.01197198,0.02459177,0.02371172,0.08449187,0.01510784,0.06660654,0.06353544,-0.03486541,-0.0318132,-0.01073117,-0.00667482,0.03608222,0.00496394,-0.03005049,0.00433297,0.07860418,0.00618377,0.02705863,-0.06995384,-0.0158709,-0.0159703,0.00659266,-0.05898925,-0.01685775,0.00982257,0.08122217,-0.02568306,-0.00415042,0.00928158,-0.05648319,-0.03127408,0.03764892,-0.00462857,-0.02908561,0.07225016,-0.05865161],"last_embed":{"hash":"1h74dpm","tokens":454}}},"last_read":{"hash":"1h74dpm","at":1778067901118},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":4500,"at":1778067901119,"hash":"1h74dpm"},"blocks":{"#---frontmatter---":[1,18],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?":[20,42],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#{1}":[21,25],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#📝 Benim Notlarım":[26,28],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🟡 Genel Bilgiler (Sarı)":[29,31],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🔴 Bulgular (Kırmızı)":[35,37],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/ARYPBYEG","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FHJFEGG4?page=1&annotation=5INMVYTJ","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FHJFEGG4?page=1&annotation=PIQUML5J","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FHJFEGG4?page=1&annotation=YJA6FLAP","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FHJFEGG4?page=1&annotation=D3CLRHA8","line":39},{"title":"Sayfa 7","target":"zotero://open-pdf/library/items/FHJFEGG4?page=7&annotation=ME655I6D","line":39}],"metadata":{"Title":"Carbohydrate counting in traditional Turkish fast foods for individuals with type 1 diabetes: Can artificial intelligence models replace dietitians?","Authors":"Volkan Özkaya, Erdal Eren, Şebnem Özgen Özkaya, Güven Özkaya","Year":2026,"DOI":"10.1016/j.nut.2025.112986","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aimed to compare the accuracy of carbohydrate content estimations for traditional Turkish fast foods made by artificial intelligence (AI) models and dietitianStandardized recipes were developed for these meals, and the meals were photographed under standardized angular and lighting conditions. The photos were then uploaded to AI applications (ChatGPT4.0, DeepSeek, Gemini, and CarbManager) and each model was prompted to estimate the carbohydrate content of the respective food items. Dietitians were asked to estimate the carbohydrate content based on these photographs.","Findings":"The intraclass correlation coefficient (ICC) between the AI models was 0.3554 (95% confidence interval [CI]: 0.0974 0.6801), indicating low reliability. The highest agreement with the estimates of dietitians who provided carbohydrate counting training (ICC = 0.417, 95% CI: 0.247 0.685) and those who did not (ICC = 0.307, 95% CI: 0.163 0.578) was observed with ChatGPT.","Conclusions":"AI models can assist individuals with diabetes and healthcare professionals in estimating the carbohydrate content of foods, and consequently, can make a significant contribution to diabetes selfmanagement.The moderate agreement observed between AI tools and dietitians suggests a potential role for these applications as supplementary educational tools. They could be integrated into structured carbohydrate counting training programs to provide immediate feedback. However, they should not replace expert dietetic guidance due to their limitations with culturally complex foods.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1h74dpm","at":1774939749775},"key":"Augmented Dietitian/ozkayaCarbohydrateCountingTraditional2026b.md"},
