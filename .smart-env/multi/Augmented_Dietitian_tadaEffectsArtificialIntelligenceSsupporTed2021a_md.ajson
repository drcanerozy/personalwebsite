],"#Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial#🟡 Genel Bilgiler (Sarı)":[35,37],"#Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial#🟢 Yöntem & Örneklem (Yeşil)":[38,40],"#Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial#🟢 Yöntem & Örneklem (Yeşil)#{1}":[39,40],"#Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial#🔴 Bulgular (Kırmızı)":[41,43],"#Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial#🔵 Sonuç / Conclusions (Mavi)":[44,46],"#Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial#🟠 Limitasyonlar (Turuncu)":[47,48]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/YDTQ28FB","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/KDUKPF2C?page=1&annotation=F9QC97G9","line":39},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/KDUKPF2C?page=1&annotation=RZXDQM4P","line":39}],"metadata":{"Title":"Effects of artificial intelligence-SsupporTed Automated NutRiTional Intervention on LDL cholesterol Control in Patients with Familial Hypercholesterolaemia (iSTART-FH): protocol for a randomised controlled trial","Authors":"Hayato Tada, Hirofumi Okada, Akihiro Nomura, Soichiro Usui, Kenji Sakata, Kenshi Hayashi, Noboru Fujino, Ayaka Yasugi, Shizuko Takahara, Yasuhito Imai, Masayuki Takamura, Masa-aki Kawashiri","Year":2021,"DOI":"10.1136/bmjopen-2021-053453","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aims to test the hypothesis that AI-supported nutritional counselling is more effective in reducing LDL cholesterol than the in-person, face-to-face method in terms of improving LDL cholesterol control in patients with FH.This is a single-centre, unblinded, cross-over, randomised controlled study comparing the efficacy of AI-supported automated nutrition therapy with that of conventional human nutrition counselling in patients with FH.","Findings":"","Conclusions":"","Limitations":"","User_Notes":"yöntem makalesi  dyt karlılaştırması var  bulgular yayımlanmış mı bak  prompt yok, gerekli mi doğrula"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"p3swko","at":1774939744440},"key":"Augmented Dietitian/tadaEffectsArtificialIntelligenceSsupporTed2021a.md"},
