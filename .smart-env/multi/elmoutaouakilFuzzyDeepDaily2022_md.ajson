0.06507972,0.0319566,0.22931762,-0.0509616,0.01525084,0.06305774,-0.02932785,-0.01581823,0.02238978,-0.02854891,0.03338528,0.05576211,0.09509483,-0.00559658,-0.00407839,0.06570265,-0.05613149,-0.04159235,0.02755621,0.01251781,-0.00699417,-0.03096518,-0.07142258,0.00245379,0.10337722,-0.04138051,-0.03964869,-0.07552602,-0.02350065,0.02296112,0.01999873,-0.03199108,-0.02033128,-0.02180725,0.03350974,0.03055785,0.01451473,-0.01665113,-0.02928548,-0.06679051,0.01087477,-0.03299739,0.00446232,0.08940417,-0.06566118],"last_embed":{"hash":"1h2cg4r","tokens":433}}},"last_read":{"hash":"1h2cg4r","at":1774939658031},"class_name":"SmartSource","last_import":{"mtime":1774939638476,"size":3272,"at":1774939651555,"hash":"1h2cg4r"},"blocks":{"#---frontmatter---":[1,18],"#Fuzzy Deep Daily Nutrients Requirements Representation":[20,42],"#Fuzzy Deep Daily Nutrients Requirements Representation#{1}":[21,25],"#Fuzzy Deep Daily Nutrients Requirements Representation#📝 Benim Notlarım":[26,28],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔴 Bulgular (Kırmızı)":[35,37],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/7IUNWJMS","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=3Q7WL4QP","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=D6HE3VQA","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=TNUGFXXA","line":39}],"metadata":{"Title":"Fuzzy Deep Daily Nutrients Requirements Representation","Authors":"Karim El Moutaouakil, Abdellah Ahourag, Saliha Chellak, Hicham Baїzri, Mouna Cheggour","Year":2022,"DOI":"10.18280/ria.360210","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"First, we collect the expert's nutrients recommendations from different expert research papers. These recommendations are, then, represented in terms of trapezoidal numbers by adopting appropriate rules that encourage the consumption of the favorable nutrients and limit consumption of the unfavorable nutrients in daily diets. Then, we generate large data sets basing on the trapezoidal representation. To transform the expert's recommendations into significant crisp values, we call the auto-encoder neural network, and we propose an original regulation term that controls all the auto-encoder units. To select the best autoencoder architecture, we use the fuzzy genetic algorithm basing on a simple fuzzy rule to determine the crossover percent, the mutation percent, and the population size at each iteration","Findings":"Compared to the random systems, the proposed method has shown a great capacity to generalize its experience to unseen recommendations.","Conclusions":"In a clinical setting, our system can be used by a dietician to accurately determine the daily nutrient requirements of a given individual.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1h2cg4r","at":1774939657865}},"smart_blocks:elmoutaouakilFuzzyDeepDaily2022.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.09591807,0.00751321,-0.03397948,-0.00543475,0.0106483,0.04549336,0.0014535,0.03643383,-0.03170326,0.01657999,-0.008