877,-0.02804754,0.00621187,0.06353901,-0.00533312,0.08205973,-0.04858604,0.01860255,0.03904457,0.19272612,-0.03764488,-0.05512704,0.01648827,-0.0240714,-0.08474939,0.0077679,-0.0029356,0.03973423,0.04556183,0.09196178,0.02104464,0.00965652,0.11509421,-0.00840904,-0.0264756,-0.02018522,-0.0157515,0.05472635,-0.02235986,-0.0388602,-0.06338251,0.09284762,-0.02869401,0.02862927,-0.03107458,-0.03367839,0.02236043,0.02251223,-0.06449294,-0.03118369,0.00421321,0.06143564,-0.01450821,-0.04857871,-0.01728184,-0.01029617,0.00224412,0.06898601,-0.0247482,-0.00927363,0.04195697,-0.05774584],"last_embed":{"hash":"1ilg6fe","tokens":455}}},"last_read":{"hash":"1ilg6fe","at":1774939543133},"class_name":"SmartSource","last_import":{"mtime":1774939523444,"size":4472,"at":1774939536706,"hash":"1ilg6fe"},"blocks":{"#---frontmatter---":[1,18],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images":[20,42],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#{1}":[21,25],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#📝 Benim Notlarım":[26,28],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟡 Genel Bilgiler (Sarı)":[29,31],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔴 Bulgular (Kırmızı)":[35,37],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/TYKDWSJ6","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FEZRC5SB?page=1&annotation=764D4L2W","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FEZRC5SB?page=1&annotation=IDNBQQAW","line":36},{"title":"Sayfa 12","target":"zotero://open-pdf/library/items/FEZRC5SB?page=12&annotation=FZNDCCR5","line":39}],"metadata":{"Title":"DeepNOVA: A Deep Learning NOVA Classifier for Food Images","Authors":"Shady Elbassuoni, Hala Ghattas, Jalila El Ati, Zoulfikar Shmayssani, Sarah Katerji, Yorgo Zoughbi, Aline Semaan, Christelle Akl, Houda Ben Gharbia, Sonia Sassi","Year":2022,"DOI":"10.1109/ACCESS.2022.3227769","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"we propose an end-to-end deep learning approach that can detect and localize various food items in a given food image using a customized object detection model. Our approach then assesses how healthy each detected food item is by classifying it into one or more of the four NOVA groups (Unprocessed Food, Processed Culinary Ingredients, Processed Food, and Ultra-processed Food). To train our food item detection model, we used two public datasets and a custom one we created ourselves and which contains images of food taken using wearable cameras. To train the NOVA food classifier, we use the custom dataset we created ourselves and that was manually labeled by expert nutritionists.","Findings":"Our food item detection model achieved a mAP of 0.90 and the NOVA food classifier achieved an average F1-score of 0.86 on test da","Conclusions":"Our approach can be used by nutritionists to study the dietary intake of a target population, which is traditionally done using interviews and questionnaires, and is known to suffer from recall bias. Our approach consists of two main models, a food item detection model followed by a NOVA classification model. The food item detection model is a custom object detection model that is trained to detect and localize any food item in an image, while the NOVA classification model is a multi-label classification model that assigns a food item to one or more of the NOVA food groups based on its processing level. Both models were trained using a combination of public datasets and a custom dataset that we generated using wearable cameras and that was annotated by trained nutritionists.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1ilg6fe","at":1774939542941}},"smart_blocks:Augmented Dietitian Okunmuşlar/elbassuoniDeepNOVADeepLearning2022a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.01536827,0.01373637,0.01651246,0.00350841,0.06138378,0.01575587,0.00744473,-0.00240389,-0.00412032,-0.00710092,-0.00145059,-0.09938361,-0.03004784,0.02049457,0.0673519,-0.05667257,0.04207184,0.02159994,-0.05089154,-0.03033465,0.04621648,-0.0124027,-0.00822134,-0.00808912,0.06251782,0.04748385,0.01783656,-0.03554325,-0.07093192,-0.2513929,0.03469907,-0.00862685,0.08637732,-0.03983248,-0.04041588,-0.04356888,0.00482776,-0.02862319,-0.07227787,0.0057068,0.07864883,0.00581936,-0.02820171,-0.00323676,0.00913311,-0.05354827,-0.04631029,-0.07860102,-0.06049844,-0.02656663,-0.00454606,-0.06612466,-0.00290932,0.05056423,0.01366351,0.01136552,0.08796001,-0.00102498,0.0853845,0.05689208,0.03400725,0.06243383,-0.19005434,0.03179507,0.02138112,-0.0014555,-0.03602527,-0.01418826,-0.02115374,-0.04127255,0.01967955,0.04779664,0.04916475,0.03170834,-0.00611902,0.04660349,0.10252424,-0.06167836,-0.0181961,-0.02483498,-0.0006787,0.10610418,0.00848909,-0.06240608,-0.00836029,-0.01918698,0.00136018,-0.06037186,0.06175046,-0.02225769,-0.05720387,-0.01329043,0.01665021,0.00604424,0.01767553,-0.01222916,-0.03093199,-0.01575652,-0.02373307,0.13097066,-0.06535129,0.01709541,0.0333957,0.01014495,0.02421349,-0.01486438,-0.06310227,-0.03265249,-0.00505182,0.06733586,-0.00801781,0.02835929,-0.06104709,-0.02253066,-0.01425441,0.03269007,0.10160573,-0.00028398,-0.00594256,-0.01871233,-