      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/postscript</dc:format>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>EC2</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Figure 2</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Figure 2: Mean values (Â± standard error) of the area under the curve (AUC) for cholecystokinin (CCK). The AUC for CCK was significantly different between the three different macronutrient meals (carbohydrate, protein, and fat) at different temperatures (cold, warm, and hot) (Kruskalâ€“Wallis H test, P &lt; 0.001). CHO=Carbohydrate, AUC=Area under the curve, GLP-1=Glucagon-like polypeptide-1</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
