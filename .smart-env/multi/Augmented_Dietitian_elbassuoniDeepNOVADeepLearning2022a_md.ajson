27571,-0.00179934,0.08190515,-0.04873686,0.01635688,0.03818253,0.19274895,-0.03557035,-0.05709388,0.0147653,-0.03053957,-0.08210033,0.0049315,-0.00340146,0.03656315,0.04757068,0.09330477,0.02260018,0.00634802,0.11903434,-0.00943331,-0.02839806,-0.01848851,-0.01427216,0.05744076,-0.02056168,-0.03799327,-0.06451558,0.09396412,-0.0266165,0.02826659,-0.0314342,-0.03404034,0.02073915,0.02290984,-0.06165516,-0.03077989,0.00196053,0.06073562,-0.0173759,-0.04952217,-0.01960419,-0.01171395,0.00043551,0.06783439,-0.02390323,-0.00880858,0.04146208,-0.05947615],"last_embed":{"hash":"1ilg6fe","tokens":452}}},"last_read":{"hash":"1ilg6fe","at":1778067900895},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":4472,"at":1778067900895,"hash":"1ilg6fe"},"blocks":{"#---frontmatter---":[1,18],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images":[20,42],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#{1}":[21,25],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#📝 Benim Notlarım":[26,28],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟡 Genel Bilgiler (Sarı)":[29,31],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔴 Bulgular (Kırmızı)":[35,37],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/TYKDWSJ6","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FEZRC5SB?page=1&annotation=764D4L2W","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FEZRC5SB?page=1&annotation=IDNBQQAW","line":36},{"title":"Sayfa 12","target":"zotero://open-pdf/library/items/FEZRC5SB?page=12&annotation=FZNDCCR5","line":39}],"metadata":{"Title":"DeepNOVA: A Deep Learning NOVA Classifier for Food Images","Authors":"Shady Elbassuoni, Hala Ghattas, Jalila El Ati, Zoulfikar Shmayssani, Sarah Katerji, Yorgo Zoughbi, Aline Semaan, Christelle Akl, Houda Ben Gharbia, Sonia Sassi","Year":2022,"DOI":"10.1109/ACCESS.2022.3227769","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"we propose an end-to-end deep learning approach that can detect and localize various food items in a given food image using a customized object detection model. Our approach then assesses how healthy each detected food item is by classifying it into one or more of the four NOVA groups (Unprocessed Food, Processed Culinary Ingredients, Processed Food, and Ultra-processed Food). To train our food item detection model, we used two public datasets and a custom one we created ourselves and which contains images of food taken using wearable cameras. To train the NOVA food classifier, we use the custom dataset we created ourselves and that was manually labeled by expert nutritionists.","Findings":"Our food item detection model achieved a mAP of 0.90 and the NOVA food classifier achieved an average F1-score of 0.86 on test da","Conclusions":"Our approach can be used by nutritionists to study the dietary intake of a target population, which is traditionally done using interviews and questionnaires, and is known to suffer from recall bias. Our approach consists of two main models, a food item detection model followed by a NOVA classification model. The food item detection model is a custom object detection model that is trained to detect and localize any food item in an image, while the NOVA classification model is a multi-label classification model that assigns a food item to one or more of the NOVA food groups based on its processing level. Both models were trained using a combination of public datasets and a custom dataset that we generated using wearable cameras and that was annotated by trained nutritionists.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1ilg6fe","at":1774939759457},"key":"Augmented Dietitian/elbassuoniDeepNOVADeepLearning2022a.md"},
