.014764,0.03125719,-0.03701091,0.04605934,-0.0846929,0.02228494,0.00619519,0.15612502,-0.05556107,0.0076844,0.01055622,-0.00788753,-0.00821551,0.05770057,-0.0198663,0.00782286,0.01218262,0.09039775,0.01460003,0.05983408,0.0260049,-0.03321839,-0.02796564,-0.02082969,-0.02026816,0.02701101,-0.00615035,-0.02099684,-0.05362856,0.08938287,0.00494886,-0.03033589,-0.07948053,-0.02845638,-0.03665893,0.00319579,0.03025908,0.01480553,0.00349783,0.01882401,-0.05222769,0.01479573,-0.03959293,-0.02166614,-0.01595218,0.03243766,0.01589433,0.00415136,0.09330016,-0.04526785],"last_embed":{"hash":"agbc8c","tokens":434}}},"last_read":{"hash":"agbc8c","at":1778067901090},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3364,"at":1778067901090,"hash":"agbc8c"},"blocks":{"#---frontmatter---":[1,18],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions":[20,42],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#{1}":[21,25],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#📝 Benim Notlarım":[26,28],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🟡 Genel Bilgiler (Sarı)":[29,31],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🔴 Bulgular (Kırmızı)":[35,37],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/5GVYLHYQ","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D98W25NX?page=1&annotation=JZCAGQCD","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D98W25NX?page=1&annotation=Z5T2JPXS","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D98W25NX?page=1&annotation=BHHMH7VA","line":39}],"metadata":{"Title":"Comparing ChatGPT with healthcare provider responses to home parenteral nutrition questions","Authors":"Regina Barrera, Heather Stanner, Nancy Stoner, Kristy Poindexter, Anushka Sharma, Marion F. Winkler, Hassan S. Dashti","Year":2025,"DOI":"10.1002/ncp.70060","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"Responses to 20 HPN‐related questions spanning five content themes were generated by ChatGPT and provided by HPN expert clinicians.","Findings":"Among 23 participants (73.9% registered dietitians; mean HPN experience: 14.0 years), ChatGPT's responses were rated more favorably for accuracy (median [IQR] = 1.80 [0.79] vs 2.15 [0.62], P = 0.003), appropriateness (1.80 [0.70] vs 2.15 [0.53], P = 0.013), and empathy (1.95 [0.66] vs 2.25 [0.65], P = 0.007). Participants preferred ChatGPT responses in 48.5% of cases, clinician responses in 33.9%, and had no clear preference in 17.6%. ChatGPT outperformed clinicians across content themes for “best practices, care, and safety of HPN use/infection risk” and scored more favorably for empathy in “symptoms” and for accuracy and appropriateness in “lifestyle stressors.” Clinicians scored more favorably for appropriateness in “biochemical test concerns","Conclusions":"ChatGPT may support HPN care and patient education, particularly for broad medical and lifestyle topics. However, complex clinical issues require medical expertise","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"agbc8c","at":1774939763702},"key":"Augmented Dietitian/barreraComparingChatGPTHealthcare2025c.md"},
