2,0.01540914,0.00411724,0.04110117,-0.08202739,-0.00493542,0.03965898,0.2147702,-0.0626185,-0.02944939,0.01608422,0.00441285,-0.06403719,-0.00338232,-0.0197183,0.02376212,0.00160619,0.08704498,-0.00169971,0.03355991,0.06012079,-0.0555495,-0.0397222,-0.01000626,-0.00140451,0.02140295,-0.01073101,-0.02097928,0.00035294,0.11145925,0.01476958,0.02899151,-0.02508945,-0.01819884,0.02218817,0.00675352,0.01258136,-0.00327228,-0.02494689,0.04627609,0.01037504,-0.00374755,-0.04127464,-0.04571744,-0.03738676,0.03443174,-0.02565155,-0.01972341,0.01655884,-0.02862215],"last_embed":{"hash":"ujfgdh","tokens":439}}},"last_read":{"hash":"ujfgdh","at":1778067901038},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":2873,"at":1778067901038,"hash":"ujfgdh"},"blocks":{"#---frontmatter---":[1,18],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System":[20,42],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#{1}":[21,25],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#📝 Benim Notlarım":[26,28],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🟡 Genel Bilgiler (Sarı)":[29,31],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🔴 Bulgular (Kırmızı)":[35,37],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RXRH6VED","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/G8NIQQE7?page=1&annotation=TIKZZW7Z","line":33},{"title":"Sayfa 19","target":"zotero://open-pdf/library/items/G8NIQQE7?page=19&annotation=UAIAIL9A","line":39}],"metadata":{"Title":"Human-Mimetic Estimation of Food Volume from a Single-View RGB Image Using an AI System","Authors":"Zhengeng Yang, Hongshan Yu, Shunxin Cao, Qi Xu, Ding Yuan, Hong Zhang, Wenyan Jia, Zhi-Hong Mao, Mingui Sun","Year":2021,"DOI":"10.3390/electronics10131556","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"In this work, we present a novel Artificial Intelligent (AI) system to mimic the thinking of dietitians who use a set of common objects as gauges (e.g., a teaspoon, a golf ball, a cup, and so on) to estimate the portion size. Specifically, our human-mimetic system “mentally” gauges the volume of food using a set of internal reference volumes that have been learned previously. At the output, our system produces a vector of probabilities of the food with respect to the internal reference volumes. The estimation is then completed by an “intelligent guess”, implemented by an inner product between the probability vector and the reference volume vector","Findings":"","Conclusions":"We took advantage of recently developed AI technology and developed a human-mimetic system that imitates a dietitian’s mental process by comparing the food size with the sizes of commonly known objects","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"ujfgdh","at":1774939741593},"key":"Augmented Dietitian/yangHumanMimeticEstimationFood2021b.md"},
