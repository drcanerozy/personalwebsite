0.04151532,0.03163681,-0.04648861,-0.00640385,0.03094898,0.18231031,-0.06817951,-0.01433988,0.03686515,-0.00409159,-0.026324,0.00900283,-0.01561543,0.01439426,0.0270374,0.13747248,0.04894245,0.03698143,0.05743675,-0.05737691,-0.02826608,-0.02048916,-0.02672132,0.07455677,0.00571742,-0.00853353,0.02124979,0.11770655,0.03936768,-0.01632089,-0.04839139,-0.01700713,-0.00428686,-0.03508912,-0.02652701,-0.0078423,0.00752215,0.00367548,-0.01667882,0.01184338,-0.01336242,0.00412831,-0.02534144,0.01790574,0.04102683,-0.03589734,0.10981528,-0.03029381],"last_embed":{"hash":"r7dbr3","tokens":447}}},"last_read":{"hash":"r7dbr3","at":1774939543714},"class_name":"SmartSource","last_import":{"mtime":1774939523453,"size":4163,"at":1774939536709,"hash":"r7dbr3"},"blocks":{"#---frontmatter---":[1,18],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web":[20,42],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#{1}":[21,25],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#📝 Benim Notlarım":[26,28],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟡 Genel Bilgiler (Sarı)":[29,31],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔴 Bulgular (Kırmızı)":[35,37],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/63MSTVP9","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/364P2SKM?page=1&annotation=RNBJ8CL7","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/364P2SKM?page=1&annotation=A2LDCFCG","line":36},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/364P2SKM?page=10&annotation=PJ6WAWDI","line":36},{"title":"Sayfa 13","target":"zotero://open-pdf/library/items/364P2SKM?page=13&annotation=X4H3ZEWL","line":39}],"metadata":{"Title":"Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web","Authors":"Evaggelia Fappa, Mary Micheli, Dimitris Panaretos, Marios Skordis, Petroula Tsirpanli, George I. Panoutsopoulos","Year":2025,"DOI":"10.3390/info16070526","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The aim of the present study was to compare the quality assessment of online dietary weight loss information conducted by an AI assistant (ChatGPT 4.5) to that of health professionals.","Findings":"Analysis revealed no significant differences in quantitative quality scores between human raters, ChatGPT-4.5, and the AI-derived system (p = 0.528). On the contrary, statistically significant differences were found between the three content accuracy scores (p < 0.001), with scores assigned by ChatGPT-4.5 being higher than those assigned by humans (all p < 0.001). Our findings suggest that ChatGPT-4.5 could complement human experts in evaluating online weight loss information, when using a validated instrument like DISCERN. However, more relevant research is needed before forming any suggestions.In terms of classification, ChatGPT-4.5 rated 22% of webpages as “excellent” using DISCERN, while humans rated only 3%.","Conclusions":"Validated AI-assisted tools could be produced to perform dietary or health information quality assessments specific for each disease (i.e., obesity) or health status (i.e., pregnancy) for text and/or videos. Last, investigating how different versions of the same AI model perform could provide valuable insights into how rapidly evolving LLM capabilities affect assessment accuracy, potentially leading to the development of a gold standard methodology for AI-assisted evaluation of online nutritional information","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"r7dbr3","at":1774939543568}},"smart_blocks:Augmented Dietitian Okunmuşlar/fappaHumanVsAI2025a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02770795,0.00189915,0.00382378,0.01717257,0.00294256,0.04774749,0.00242267,0.05816722,0.01868895,-0.00785429,-0.00414115,-0.0805927,0.01537953,0.03537064,0.02955083,0.00847112,0.03090569,-0.03930473,-0.01605916,0.02455272,0.07741649,-0.01185919,0.01442573,0.02929223,0.01506225,0.01070574,-0.04718978,-0.0718708,-0.08520208,-0.21287537,0.02116676,-0.02730321,0.09255573,-0.02242767,-0.05752946,0.00647828,-0.01028528,0.02812406,-0.02969235,0.01185732,0.02353096,-0.00897689,0.0359338,-0.02119065,0.00800562,0.01877205,-0.04463492,-0.00178312,-0.08198883,0.04137465,0.00591725,0.0122923,0.03109577,0.03915437,0.05508886,0.03794192,0.03225185,0.05212163,0.04547545,0.08281896,0.04822712,0.07121554,-0.22675908,0.09413556,-0.00178006,0.03016947,-0.07344958,0.00361042,-0.02891771,-0.03927394,-0.05247451,-0.02298862,0.06740811,0.04693453,0.01629082,0.01114841,0.07715482,-0.05451252,0.01798758,-0.01392635,0.01404532,0.0668591,-0.01774036,-0.00753295,-0.02200067,-0.03670486,0.00956911,-0.02639458,0.04358049,-0.03197871,-0.00675149,-0.02860804,-0.00912276,0.04420895,0.00196217,-0.02085199,-0.04039161,-0.03665101,-0.04712487,0.11146154,-0.05193075,-0.