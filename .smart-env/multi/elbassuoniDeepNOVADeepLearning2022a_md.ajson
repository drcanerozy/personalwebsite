68,0.0144948,0.03562269,0.19207644,-0.02228258,-0.04975182,0.0062113,-0.03800996,-0.07992696,0.00930612,-0.00228386,0.03417004,0.04607475,0.09620132,0.01406483,0.0091133,0.12207473,0.00063744,-0.02365365,-0.01891814,-0.0162672,0.05332997,-0.02321062,-0.03510382,-0.06781954,0.09779846,-0.02711626,0.02186662,-0.02164006,-0.03257248,0.02508952,0.02500526,-0.06756758,-0.03328355,-0.00563928,0.05929898,-0.00431958,-0.04954265,-0.02504635,-0.02078599,0.00442775,0.07258242,-0.03317031,-0.00766036,0.03743286,-0.05925906],"last_embed":{"hash":"1ilg6fe","tokens":451}}},"last_read":{"hash":"1ilg6fe","at":1774939657849},"class_name":"SmartSource","last_import":{"mtime":1774939638475,"size":4472,"at":1774939651555,"hash":"1ilg6fe"},"blocks":{"#---frontmatter---":[1,18],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images":[20,42],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#{1}":[21,25],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#📝 Benim Notlarım":[26,28],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟡 Genel Bilgiler (Sarı)":[29,31],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔴 Bulgular (Kırmızı)":[35,37],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#DeepNOVA: A Deep Learning NOVA Classifier for Food Images#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/TYKDWSJ6","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FEZRC5SB?page=1&annotation=764D4L2W","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FEZRC5SB?page=1&annotation=IDNBQQAW","line":36},{"title":"Sayfa 12","target":"zotero://open-pdf/library/items/FEZRC5SB?page=12&annotation=FZNDCCR5","line":39}],"metadata":{"Title":"DeepNOVA: A Deep Learning NOVA Classifier for Food Images","Authors":"Shady Elbassuoni, Hala Ghattas, Jalila El Ati, Zoulfikar Shmayssani, Sarah Katerji, Yorgo Zoughbi, Aline Semaan, Christelle Akl, Houda Ben Gharbia, Sonia Sassi","Year":2022,"DOI":"10.1109/ACCESS.2022.3227769","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"we propose an end-to-end deep learning approach that can detect and localize various food items in a given food image using a customized object detection model. Our approach then assesses how healthy each detected food item is by classifying it into one or more of the four NOVA groups (Unprocessed Food, Processed Culinary Ingredients, Processed Food, and Ultra-processed Food). To train our food item detection model, we used two public datasets and a custom one we created ourselves and which contains images of food taken using wearable cameras. To train the NOVA food classifier, we use the custom dataset we created ourselves and that was manually labeled by expert nutritionists.","Findings":"Our food item detection model achieved a mAP of 0.90 and the NOVA food classifier achieved an average F1-score of 0.86 on test da","Conclusions":"Our approach can be used by nutritionists to study the dietary intake of a target population, which is traditionally done using interviews and questionnaires, and is known to suffer from recall bias. Our approach consists of two main models, a food item detection model followed by a NOVA classification model. The food item detection model is a custom object detection model that is trained to detect and localize any food item in an image, while the NOVA classification model is a multi-label classification model that assigns a food item to one or more of the NOVA food groups based on its processing level. Both models were trained using a combination of public datasets and a custom dataset that we generated using wearable cameras and that was annotated by trained nutritionists.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1ilg6fe","at":1774939657668}},"smart_blocks:elbassuoniDeepNOVADeepLearning2022a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.00735834,0.02007669,0.02190853,0.00059098,0.07662679,0.02056887,0.00682082,-0.00171171,-0.00558258,-0.0145893,-0.00276297,-0.094142,-0.02794553,0.02389413,0.06226557,-0.06642728,0.03450507,0.02241371,-0.05755988,-0.02868202,0.04012426,-0.01379924,-0.01071544,-0.02455498,0.05471158,0.04102828,0.0196436,-0.03579476,-0.07165576,-0.25297937,0.03435622,-0.00899021,0.08484206,-0.03755951,-0.03651344,-0.0509617,0.01171407,-0.0417399,-0.06897917,0.01499664,0.08085839,-0.00279149,-0.03289971,-0.00507924,0.00540165,-0.04822144,-0.04335945,-0.07256046,-0.05995666,-0.03601098,0.00045095,-0.07329892,-0.00497831,0.04726477,0.00428216,0.01456608,0.08956172,-0.00610012,0.08602652,0.05080284,0.04106428,0.05889254,-0.19192134,0.01806081,0.03132998,0.00355719,-0.03393756,-0.00162721,-0.02276874,-0.03415183,0.02835173,0.05457699,0.04567416,0.03562628,-0.00221902,0.04540829,0.10611357,-0.05661045,-0.01888604,-0.03525306,0.00338425,0.0985253,0.01629296,-0.06597668,-0.00283067,-0.02067938,-0.00024857,-0.05500771,0.05971264,-0.02730838,-0.05779213,-0.00510238,0.01219464,0.01253133,0.01408159,-0.00859318,-0.03941296,-0.00925921,-0.02848716,0.12731281,-0.07152204,0.02020393,0.02960061,-0.00494165,0.02131766,-0.01451073,-0.06520991,-0.02938056,0.00490819,0.06026753,-0.00532555,0.02298935,-0.06120097,-0.02419822,-0.01503262,0.02903574,0.09739993,0.00736213,-0.01128833,-0.02660994,-0.02218904,-0.00469825,0.02276469,-0.0425293,0.00998344,0.01716853,-0.01457692,0.07854242,0.024672