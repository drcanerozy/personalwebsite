-0.09845818,-0.01018329,0.01536156,0.20086506,-0.04027832,0.0195234,0.05081041,0.00956437,-0.033151,0.04833862,0.00008599,0.00619812,0.02065621,0.11300758,-0.01754219,0.03110369,0.06917027,-0.01693495,-0.04890658,-0.03264103,-0.0116017,0.02854106,0.03359691,-0.02846606,-0.04199226,0.0884278,0.00352267,-0.03093782,-0.04735314,-0.02666208,-0.00512024,0.0159715,-0.01747133,-0.01506266,-0.00251863,0.04883415,-0.02365272,0.00041188,0.03237357,-0.02588234,-0.05090191,0.02376675,-0.0307825,-0.02980909,0.11967909,-0.0524976],"last_embed":{"hash":"3ooy29","tokens":429}}},"last_read":{"hash":"3ooy29","at":1774939653831},"class_name":"SmartSource","last_import":{"mtime":1774939638357,"size":3502,"at":1774939651541,"hash":"3ooy29"},"blocks":{"#---frontmatter---":[1,18],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?":[20,42],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#{1}":[21,25],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#📝 Benim Notlarım":[26,28],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟡 Genel Bilgiler (Sarı)":[29,31],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔴 Bulgular (Kırmızı)":[35,37],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/27APW4AP","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=3IW7MBGN","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=MSK8DKDS","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5YYG73V4?page=1&annotation=N5XFYJL9","line":39}],"metadata":{"Title":"Can artificial intelligence (AI) chatbot tools be used effectively for nutritional management in obesity?","Authors":"Hatice Merve Bayram, Zehra Margot Çelik, Hatice Kübra Barcın Güzeldere","Year":2025,"DOI":"10.1177/02601060251329070","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"A comparative content analysis was conducted using ChatGPT-4o, and ChatGPT-4 to generate 1800 kcal daily diet plans for a 20-year-old female with obesity. AI models provided recommendations for dietary management, the nutrition care process, and menu planning. Three dietitians evaluated the outputs","Findings":"ChatGPT-generated menus were inconsistent with dietary recommendations. Both ChatGPT-4o and ChatGPT-4 offered 5-day menu samples with low calorie content of “1800 kcal prompt” compared to the TDG-2022 (P < 0.001 for ChatGPT-4o). Additionally, key nutrients, particularly fats (P = 0.003), carbohydrates (%), potassium, and calcium (P < 0.05 for all) were inadequately compared to the TDG-2022. Nutrient analysis revealed that both models underperformed in meeting recommended intakes for critical micronutrients such as calcium, and had an unbalanced distribution of macronutrients","Conclusions":"ChatGPT-4o and ChatGPT-4 have limitations when used to provide accurate dietary management.  While AI chatbots offer useful insights, they cannot replace expertise of dietitians in clinical planning; as a result, caution is advised when using these tools in this context.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"3ooy29","at":1774939653649}},"smart_blocks:bayramCanArtificialIntelligence2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02728625,0.02314871,0.03398283,0.01016426,-0.01545919,0.00473913,-0.01947276,0.06725632,-0.02660022,-0.00652521,0.00056252,-0.10471421,0.00566885,0.03803286,0.07337275,-0.00687079,0.01712216,-0.03367451,0.00139652,0.00642931,0.10250179,-0.02779205,-0.02401658,0.01993968,0.01678374,0.0280425,-0.0256895,-0.01781046,-0.0627664,-0.21014354,0.03626249,-0.01781174,0.09795213,-0.03506744,-0.07419752,0.06720651,0.00981157,0.02831494,-0.04831262,0.02925267,0.05673853,0.00342152,0.05862866,0.00093909,0.03640253,-0.01156049,-0.02990304,0.01581102,-0.06681902,0.01351868,-0.0027849,0.00595549,0.03473817,0.02037998,0.00584482,0.02829089,0.03933986,0.04124177,0.04545439,0.05502586,0.0116541,0.06986644,-0.19802606,0.07840323,0.00106378,0.04905018,-0.06786591,0.01997478,0.00653729,-0.00807772,-0.01706128,-0.00511835,0.05909397,0.00581925,0.02587529,0.00330993,0.05453138,-0.04089098,0.00949372,-0.00147466,-0.02417128,0.03993476,-0.02437442,-0.01350406,-0.04165687,-0.04690665,-0.05029479,-0.02346696,0.06847247,0.01349659,-0.01592101,-0.03039443,-0.003202,0.0145338,-0.01219631,-0.01153708,-0.01015069,-0.00646353,-0.08730085,0.10926993,-0.01030924,-0.02141912,-0.01755184,0.02123088,0.02715527,-0.06146826,-0.07619006,-0.04787996,0.01129842,0.072249,-0.03889832,0.00983058,0.0147276,0.0134449,-0.03501341,0.02852389,0.09207396,-0.0101617,0.03787258,0.04179314,-0.05497636,0.04206389,0.08057241,0.02457562,0.05905273,0.01620684,0.01839551,0.06