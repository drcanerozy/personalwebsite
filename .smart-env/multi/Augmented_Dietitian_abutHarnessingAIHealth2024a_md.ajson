5541,0.00703161,-0.0663444,0.01450339,0.03828396,0.1602053,-0.09424555,0.01766509,0.05644992,0.02015557,-0.0356498,0.05906144,-0.01066392,0.03650595,-0.00695772,0.09838494,0.00737576,0.05997391,0.13499229,-0.03730492,-0.04328509,0.03577914,-0.02525379,0.06231875,-0.00581238,-0.00273738,0.00281622,0.08544869,-0.01656833,-0.00518871,-0.04041154,-0.06284184,0.01115885,-0.00354654,0.02325431,-0.00227198,-0.00992195,0.02767923,0.00156567,-0.00390198,-0.03587917,-0.05647006,-0.03835746,0.05478509,-0.00142314,0.00410754,0.03388675,-0.07951303],"last_embed":{"hash":"1vqd94g","tokens":403}}},"last_read":{"hash":"1vqd94g","at":1778067901130},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3280,"at":1778067901130,"hash":"1vqd94g"},"blocks":{"#---frontmatter---":[1,18],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction":[20,42],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#{1}":[21,25],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#📝 Benim Notlarım":[26,28],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟡 Genel Bilgiler (Sarı)":[29,31],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔴 Bulgular (Kırmızı)":[35,37],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/ES4E88FQ","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CHWKEDVN?page=1&annotation=2IVUFX9Y","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CHWKEDVN?page=1&annotation=7MASVE96","line":36},{"title":"Sayfa 13","target":"zotero://open-pdf/library/items/CHWKEDVN?page=13&annotation=P9YDWCLS","line":39}],"metadata":{"Title":"Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction","Authors":"Fatih Abut, Ezgi Akça, Mehmet Fatih Akay, Mustafa Irmak, Müzda Irmak, Yildirim Adigüzel","Year":2024,"DOI":"10.1109/ACCESS.2024.3477326","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aims to develop new models for predicting RMR using General Regression Neural Network (GRNN). Additionally, prediction models based on Multi-Layer Perceptron (MLP) will be created for comparison purposes","Findings":"prediction. The GRNN-based models performed better than the ones built by MLP, demonstrating its feasibility as a tool for predicting RMR accurately. The results have also been compared with up-to-date prediction equations from related literature, and our optimized models perform significantly better than those. The proposed best performing GRNN model achieved an R value of 0.85, RMSE of 134.91 kcal/day, and MAPE of 10.20%, significantly outperforming traditional predictive equations such as the Harris-Benedict and Mifflin-St Jeor equations, which showed RMSE values above 400 kcal/day and MAPE values exceeding 12.5%.","Conclusions":"Consequently, the developed software offers dietitians a valuable tool for accurately calculating the RMR of their patients, thereby enhancing personalized dietary planning and wellness management.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1vqd94g","at":1774939741272},"key":"Augmented Dietitian/abutHarnessingAIHealth2024a.md"},
