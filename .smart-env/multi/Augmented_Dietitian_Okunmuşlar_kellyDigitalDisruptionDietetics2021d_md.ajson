6,-0.0155459,-0.02523193,0.06876107,0.07925428,-0.0192762,-0.00227869,-0.11852544,0.01626698,0.02140949,0.14941971,-0.07124955,0.02620248,0.06816726,-0.01658159,0.01835241,-0.00305164,-0.01564148,0.01097691,0.01388555,0.0630082,0.01934152,0.02186986,-0.05969407,-0.00289068,-0.00387368,-0.01640284,-0.0230514,0.04546072,-0.01106763,0.03970527,-0.01044332,0.09932992,-0.0354744,-0.03801588,-0.05583226,0.00299469,0.00958613,0.00316678,-0.02159814,0.00357194,0.05136434,0.03658198,0.02338802,-0.02163405,-0.01215823,-0.04944095,-0.03593959,0.0402998,-0.0127252,-0.02282599,0.07200304,-0.01671753],"last_embed":{"hash":"qopbe9","tokens":415}}},"last_read":{"hash":"qopbe9","at":1774939547859},"class_name":"SmartSource","last_import":{"mtime":1774939523538,"size":4120,"at":1774939536726,"hash":"qopbe9"},"blocks":{"#---frontmatter---":[1,18],"#Digital disruption of dietetics: are we ready?":[20,44],"#Digital disruption of dietetics: are we ready?#{1}":[21,25],"#Digital disruption of dietetics: are we ready?#📝 Benim Notlarım":[26,30],"#Digital disruption of dietetics: are we ready?#📝 Benim Notlarım#{1}":[27,28],"#Digital disruption of dietetics: are we ready?#📝 Benim Notlarım#{2}":[29,30],"#Digital disruption of dietetics: are we ready?#🟡 Genel Bilgiler (Sarı)":[31,33],"#Digital disruption of dietetics: are we ready?#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Digital disruption of dietetics: are we ready?#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Digital disruption of dietetics: are we ready?#🔴 Bulgular (Kırmızı)":[37,39],"#Digital disruption of dietetics: are we ready?#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Digital disruption of dietetics: are we ready?#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Digital disruption of dietetics: are we ready?#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Digital disruption of dietetics: are we ready?#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LVC2MZ65","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D69ETJZ9?page=1&annotation=EAZNG9BM","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D69ETJZ9?page=1&annotation=CG37SR9X","line":38},{"title":"Sayfa 8","target":"zotero://open-pdf/library/items/D69ETJZ9?page=8&annotation=WEXEX32L","line":41}],"metadata":{"Title":"Digital disruption of dietetics: are we ready?","Authors":"J. T. Kelly, P. F. Collins, J. McCamley, L. Ball, S. Roberts, K. L. Campbell","Year":2021,"DOI":"10.1111/jhn.12827","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The digital disruption of traditional dietetic services is occurring worldwide, supporting responsive and high-quality nutrition care. These disruptive technologies include integrated electronic and personal health records, mobile apps, wearables, artificial intelligence and machine learning, conversation agents, chatbots, and social robots. Here, we outline how digital health is disrupting the traditional model of nutrition care delivery and outline the potential for dietitians to not only embrace digital disruption, but also take ownership in shaping it, aiming to enhance patient care","Findings":"It is imperative that dietitians stay abreast of these technological developments and be the leaders of the disruption, not simply subject to it. By doing so, dietitians now, as well as in the future, will maximise their impact and continue to champion evidence-based nutrition practice.","Conclusions":"To achieve widespread adoption of digital nutrition care interventions, issues of data security, policies and regulations, interoperability and remuneration require attention.  The digital disruption of traditional NCP delivery is here, we call on dietitians around the world to be the leaders of this disruption, not the subject of it. It is imperative that dietitians stay abreast of technological developments and understand how digital health can be used to support and improve their current practice, ensuring that dietitians remain effective and are the champions of evidencebased nutrition care.","Limitations":"","User_Notes":"table 1 çok iyi.  notebooklmde bir deş bunu."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"qopbe9","at":1774939547674}},"smart_blocks:Augmented Dietitian Okunmuşlar/kellyDigitalDisruptionDietetics2021d.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03984675,-0.01090196,0.04211323,-0.0060712,-0.02356628,-0.00735335,-0.02215371,0.07360833,0.01476556,-0.0317208,0.00875269,-0.08140969,0.03315946,0.0143831,0.06390151,-0.01710185,0.03399525,-0.00255201,0.00184162,0.02100039,0.03900118,-0.02123876,0.04734908,0.01984505,0.02096263,0.0157705,0.00831297,-0.05394071,-0.03531693,-0.20095666,-0.0000875,-0.0265639,0.02488752,-0.01260809,-0.03183158,0.00026466,-0.00973135,0.02284013,0.02695166,0.03765055,0.00293218,0.0299463,-0.01833832,-0.04524047,-0.04829686,-0.00973446,-0.03666569,0.00882887,-0.0760776,-0.04814021,-0.01383845,-0.02835764,0.04209371,0.05243365,0.05375995,0.02179959,0.05877954,0.02215327,0.06432606,0.08007791,0.0459789,0.05610773,-0.21824159,0.13555682,0.02767126,0.04194923,-0.04079807,-0.01497219,0.0297739,-0.02034822,-0.05382767,-0.03669877,0.00932842,0.03933975,0.01567915,0.02301043,0.06383751,-0.05240966,0.01841967,-0.02421491,0.02713201,0.06073748,-0.04819144,-0.02008699,-0.11726361,-0.02304819,-0.03950302,-0.09543472,0.01191688,-0.04109859,-0.04030694,-0.00469415,0.06494945,-0.01337118,-0.04651094,-0.03861284,0.00096123,-0.02496024,-0.02913012,0.11944424,-0.03930734,-0.00811182,0.01256064,0.00852825,0.0327238,-0.06249415,-0.00655688,-0.11340638,0.0208132,0.06552579,-0.01181508,-0.00852071,0.01184842,0.00394241,0.00359426,0.05934134,0.04400569,0.00624097,0.01924443,-0.00334421,-0.02355592,0.08280066,0.04375339,-0.00014183,-0.01229756,0.00911521,0.04355917,0.10584459,-0.00837516,0.00238384,0.06486843,0.0059156,-0.04059809,-0.