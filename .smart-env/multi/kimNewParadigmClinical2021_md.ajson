467,0.01648531,0.02522053,0.18359789,-0.02227801,0.07017315,0.07353586,-0.02235857,0.01386673,0.01571164,0.00306588,0.03928972,-0.0236949,0.04840797,0.0158172,0.03609261,0.0006153,0.02195474,-0.04990302,-0.01658617,-0.01247809,0.02402055,-0.01853535,-0.05104036,-0.03446458,0.13779643,-0.00184249,-0.04092514,-0.08653841,0.02516576,0.02225875,-0.0291115,-0.00612975,-0.0006814,0.05826231,0.04263239,0.01131759,-0.02546301,-0.01507648,-0.02283814,-0.06696713,0.04767252,-0.05842639,-0.05570654,0.11420353,-0.03895151],"last_embed":{"hash":"wlhdxd","tokens":378}}},"last_read":{"hash":"wlhdxd","at":1774939662438},"class_name":"SmartSource","last_import":{"mtime":1774939638547,"size":4181,"at":1774939651571,"hash":"wlhdxd"},"blocks":{"#---frontmatter---":[1,18],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution":[20,42],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#{1}":[21,25],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#📝 Benim Notlarım":[26,28],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🟡 Genel Bilgiler (Sarı)":[29,31],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🔴 Bulgular (Kırmızı)":[35,37],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/8U3NCHQA","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/GL5TUZQD?page=1&annotation=XXNNGK8T","line":33},{"title":"Sayfa 2","target":"zotero://open-pdf/library/items/GL5TUZQD?page=2&annotation=J5FF5AGF","line":33},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/GL5TUZQD?page=9&annotation=YZ8HGJSL","line":36},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/GL5TUZQD?page=9&annotation=WGEXE62I","line":39}],"metadata":{"Title":"A New Paradigm for Clinical Nutrition Services in the Era of the Fourth Industrial Revolution","Authors":"Ga Young Kim, Jung-Sook Seo","Year":2021,"DOI":"10.7762/cnr.2021.10.2.95","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The purpose of this review is to examine the core technologies of the fourth industrial revolution affecting clinical nutrition services, and ultimately discuss how clinical nutrition professional should respond to ICT technology-related fields in the era of the new technological innovations.In addition, this review tried to build the roles of clinical nutrition professionals who can anticipate the future of clinical nutrition services and react to the changing situation in the new era of technological revolution.","Findings":"changes. Therefore, clinical nutrition professional must have a sense of mission to create new tasks and roles based on academic evidence by actively cooperating and converging with related fields such as IT, big data, genomics that are necessary to improve the quality of clinical nutrition services. In addition, in order to reflect social demands for health, efforts to seek efficient alternatives that can be linked to the nutrition management service industry specified in the National Nutrition Management Act and to derive industrial development are needed.","Conclusions":"It is difficult to accurately predict how much and how fast the surrounding environment related to clinical nutrition services will be changed in the near future. However, clinical nutrition professionals should recognize this social change as a new opportunity for the development of clinical nutrition, and actively devise new plans for practical use by activating linkage, cooperation, and fusion research with related fields.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"wlhdxd","at":1774939662308}},"smart_blocks:kimNewParadigmClinical2021.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.08207081,0.02709419,0.03237202,-0.02403202,0.02314211,0.04597678,-0.03927933,0.09460745,-0.01173953,-0.02144541,0.03991393,-0.01937642,0.00580948,0.02666103,0.04290642,-0.016659,0.04135591,0.02037365,0.00088983,0.04453095,0.0707927,-0.04414334,0.01729932,0.00864115,0.02561121,-0.00098527,-0.0262816,-0.02860454,-0.04926529,-0.20745312,0.01225629,0.00266645,0.03853695,0.02893038,0.00842635,-0.00137682,0.05899417,0.04005139,0.0255462,0.06467658,0.02284493,-0.00763199,-0.00533363,-0.04175352,-0.01277341,-0.05965641,-0.02828132,0.01012785,-0.05962092,-0.02719358,-0.02939859,-0.05618125,-0.00706638,0.04934899,0.03583867,0.02534582,0.04321801,-0.02300503,0.04852936,0.04353274,0.10982259,0.05984825,-0.22863708,0.09343538,0.05177213,0.05710673,-0.0798209,-0.0293096,0.00086333,0.01994931,-0.09060194,0.00444341,0.00746111,-0.00447133,-0.00416193,0.01037704,-0.00561992,-0.02106197,-0.01010271,-0.0559404,0.0394284,0.04473431,-0.03754456,-0.03781233,-0.10747597,-0.02236159,-0.09647816,-0.07539278,0.02731117,-0.01953249,-0.03373359,-0.04617441,0.00425594,0.01743603,-0.05787826,-0.00008958,-0.02511829,0.01702337,-0.01297744,0.08744025,-0.0555689,-0.02347668,0.00930163,-0