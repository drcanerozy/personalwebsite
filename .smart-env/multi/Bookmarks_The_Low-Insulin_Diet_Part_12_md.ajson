319819,-0.0517378,-0.01765189,-0.00592939,0.16836554,-0.02169711,-0.02892638,0.05146363,0.0108263,0.05196079,-0.0104763,0.06382719,0.02920234,0.08213204,0.07975575,0.0015516,0.01552733,0.04632656,-0.0473813,-0.04347328,0.01636042,0.03612563,0.02037385,0.00182752,-0.0214077,0.02516679,0.10648501,-0.0467594,0.00068415,-0.07510559,0.03053596,-0.02793008,0.03744179,-0.0110873,0.00485322,0.01347071,-0.00977333,-0.02598632,-0.04879703,-0.0067953,-0.05206639,0.01389949,0.0203286,0.00965644,-0.0846027,0.10383853,-0.02916565],"last_embed":{"hash":"1k9p4pz","tokens":494}}},"last_read":{"hash":"1k9p4pz","at":1778088457144},"class_name":"SmartSource","last_import":{"mtime":1778088443289,"size":22184,"at":1778088456917,"hash":"1k9p4pz"},"blocks":{"#---frontmatter---":[1,10],"#":[11,42],"##Speed of Digestion":[43,76],"##Speed of Digestion#{1}":[45,76],"##Tip — Eat less refined (starchy) carbohydrates":[77,82],"##Tip — Eat less refined (starchy) carbohydrates#{1}":[79,82],"##Fast vs Slow Carbs (Glycemic Index)":[83,102],"##Fast vs Slow Carbs (Glycemic Index)#{1}":[85,102],"##Tip — Choose foods with a low Glycemic Index (GI) and Glycemic Load (GL). Avoid rapidly digested starches.":[103,106],"##Tip — Choose foods with a low Glycemic Index (GI) and Glycemic Load (GL). Avoid rapidly digested starches.#{1}":[105,106],"##Amylopectin versus Amylose":[107,116],"##Amylopectin versus Amylose#{1}":[109,116],"##Tip — Choose higher amylose starches. Choose foods higher in Amylopectin C (best) or B (OK) rather than type A.":[117,118],"##Resistant Starch":[119,124],"##Resistant Starch#{1}":[121,124],"##Tip- Eat More Fiber":[125,132],"##Tip- Eat More Fiber#{1}":[127,132],"##The Food Matrix":[133,156],"##The Food Matrix#{1}":[135,156],"##Responses (2)":[157,160],"##Responses (2)#{1}":[159,160],"##More from Dr. Jason Fung":[161,162],"##Recommended from Medium":[163,169],"##Recommended from Medium#{1}":[165,169]},"outlinks":[{"title":"Dersler/Diyet İlkeleri ve Popüler Diyetler","target":"Dersler/Diyet İlkeleri ve Popüler Diyetler","line":11},{"title":"Karbonhidrat İnsülin Modeli","target":"Karbonhidrat İnsülin Modeli","line":12},{"title":"Glisemik İndeks","target":"Glisemik İndeks","line":13},{"title":"load (GL) of the average","target":"https://pubmed.ncbi.nlm.nih.gov/10954760/","line":19},{"title":"https://www.phoenixorganicfeed.com/why-grind-wheat-when-i-can-buy-flour.html)","target":"https://www.phoenixorganicfeed.com/why-grind-wheat-when-i-can-buy-flour.html\\","line":75},{"title":"2.6 kg (5.7 pounds) weight gain over 4 years. Extrapolating over the 20 years, eating more potatoes is associated with an average 22-pound weight gain","target":"https://pubmed.ncbi.nlm.nih.gov/37758268/","line":79},{"title":"total glucose effect of the instant oats was almost **4 times** higher than the omelet, and **almost double** that of the steel cut oats","target":"https://pubmed.ncbi.nlm.nih.gov/10049982/","line":95},{"title":"kids who ate cornflakes and bananas (high GL) versus eggs and strawberries (Low GL) for breakfast ate **65%** more calories at lunch","target":"https://pubmed.ncbi.nlm.nih.gov/21070678/","line":99},{"title":"compact packing and layered crystalline structure resists amylase digestion so the glucose is released more slowly, lowering its insulin effect","target":"https://pubmed.ncbi.nlm.nih.gov/7840071/","line":109},{"title":"Eating the entire grain of rice slows digestion time.","target":"https://pubmed.ncbi.nlm.nih.gov/6364775/","line":111},{"title":"Different type of rice have different concentrations of amylose","target":"https://www.ijpab.com/vol6-iss2a182.php","line":111},{"title":"SCFAs increase secretion of satiety hormones such as GLP1 and Peptide YY.","target":"https://pubmed.ncbi.nlm.nih.gov/18796545/","line":121},{"title":"Cooking, refrigerating then reheating rice increases the resistant starch by almost 2.5-fold","target":"https://pubmed.ncbi.nlm.nih.gov/26693746/","line":127},{"title":"The new partially crystallized structure, called retrograded resistant starch is less susceptible to digestion by amylase","target":"https://pubmed.ncbi.nlm.nih.gov/32959735/","line":127},{"title":"the rice is cooled, even up to 7 day","target":"https://www.sciencedirect.com/science/article/abs/pii/S073352100500144X","line":127},{"title":"old potato salad with vinegar reduces the glycemic index by 43% and the insulin index by 31% compared to fresh potatoes","target":"https://pubmed.ncbi.nlm.nih.gov/16034360/","line":129},{"title":"starches become harder to digest and the glucose and insulin effect is about 40% lower than bread","target":"https://www.researchgate.net/profile/Yvonne-Granfeldt/publication/21372713_On_the_importance_of_processing_conditions_product_thickness_and_egg_addition_for_the_glycaemic_and_hormonal_responses_to_pasta_A_comparison_with_bread_made_from_'pasta_ingredients'/links/568a560f08ae051f9afa4332/On-the-importance-of-processing-conditions-product-thickness-and-egg-addition-for-the-glycaemic-and-hormonal-responses-to-pasta-A-comparison-with-bread-made-from-pasta-ingredients.pdf","line":135},{"title":"parboiled rice with tomato sauce is about 45% lower than white bread","target":"https://pubmed.ncbi.nlm.nih.gov/10822284/","line":137},{"title":"higher viscosity slows down the emptying of the stomach, which slows the rate of digestion and glucose release","target":"https://www.sciencedirect.com/science/article/pii/S2475299123081957","line":141},{"title":"www.TheFastingMethod.com","target":"http://www.thefastingmethod.com/","line":155},{"title":"What are your thoughts?","target":"https://medium.com/m/signin?operation=register&redirect=https%3A%2F%2Fdrjasonfung.medium.com%2Fthe-low-insulin-diet-part-1-2-ad32bf425cee&source=---post_responses--ad32bf425cee---------------------respond_sidebar------------------","line":159},{"title":"\n\nSee more recommendations\n\n","target":"https://medium.com/?source=post_page---read_next_recirc--ad32bf425cee---------------------------------------","line":165}],"metadata":{"title":"The Low-Insulin Diet Part 1/2","source":"https://drjasonfung.medium.com/the-low-insulin-diet-part-1-2-ad32bf425cee","author":[],"published":"2025-04-22","created":"2025-04-24","description":"Refined carbohydrates are the bell-bottom jeans of the nutrition world — great in the 1970s, terrible in the 2020s. The Dietary Guidelines for Americans, first released in 1977 are more fashion than…","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1k9p4pz","at":1778088457096},"key":"Bookmarks/The Low-Insulin Diet Part 12.md"},
