47,0.00887134,-0.02855505,0.00546374,-0.09625078,0.01853113,0.01088647,0.17171445,-0.03455472,0.02025814,0.03423396,-0.005308,-0.0603269,0.04633758,-0.01007586,-0.01845318,-0.00179688,0.13686149,-0.01105732,0.04656933,0.0186144,-0.02271791,-0.02846008,-0.05015763,-0.03973319,0.06465048,0.01697704,-0.01802003,-0.05114307,0.10144554,-0.01723806,-0.00593018,-0.05682159,-0.00412707,-0.00450555,0.01317071,0.02537405,0.01151128,-0.00251304,0.01937245,-0.03142306,-0.01046892,0.00235853,-0.02893142,-0.0486349,0.04137173,-0.00218162,-0.01177335,0.09236033,0.020765],"last_embed":{"hash":"upys66","tokens":498}}},"last_read":{"hash":"upys66","at":1778067901062},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3439,"at":1778067901062,"hash":"upys66"},"blocks":{"#---frontmatter---":[1,18],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey":[20,42],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#{1}":[21,25],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#📝 Benim Notlarım":[26,28],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟡 Genel Bilgiler (Sarı)":[29,31],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔴 Bulgular (Kırmızı)":[35,37],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/GKG5VPAE","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FC9GM34J?page=1&annotation=7BG8WWCF","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FC9GM34J?page=1&annotation=SR3VQ7EL","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/FC9GM34J?page=1&annotation=PUFF46B3","line":39},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/FC9GM34J?page=9&annotation=GG792AJU","line":39}],"metadata":{"Title":"Exploring Taiwanese Dietitians' Acceptance and Use of ChatGPT in Nutrition Practice: A Cross‐Sectional Survey","Authors":"Li‐Ling Liao, I‐Ju Lai, Li‐Chun Chang","Year":2025,"DOI":"10.1111/jhn.70108","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We investigated Taiwanese dietitians' attitudes and usage of ChatGPT using the technology acceptance model (TAM) and identified factors influencing intention and behaviour.","Findings":"Of the 497 respondents (mean age = 38.5 years; 88.6% female), 59.8% had used ChatGPT, primarily for administrative documentation. Younger dietitians with higher educational levels and hospital‐based roles were more likely to use ChatGPT. Among non‐users, subjective norms and technology or social influence significantly predicted the intention to adopt ChatGPT. Among users, job relevance, self‐efficacy, and perceived risk were key predictors of usage frequency.","Conclusions":"The study highlights the necessity to amplify positive environmental influences through awareness campaigns, societal endorsements, and institutional support to enhance ChatGPT integration in dietetic practice.practice. Its findings indicate that although a significant percentage of dietitians have experience using ChatGPT, adoption for professional tasks remains limited, primarily because of concerns regarding AI‐generated information's accuracy and trustworthiness","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"upys66","at":1774939752888},"key":"Augmented Dietitian/liaoExploringTaiwaneseDietitians2025b.md"},
