047,0.00348627,-0.07633375,0.0279612,0.05480336,0.18662581,-0.04612664,0.02115107,0.0485009,-0.01692473,0.00713946,0.04929495,-0.035322,0.01444097,0.01259742,0.06431682,0.01368573,0.05182636,0.03873319,-0.01274966,-0.04122023,0.01742067,0.0011524,0.06525211,0.01002171,-0.01643045,-0.01026785,0.08671367,0.02145369,0.00640715,-0.05442446,-0.00847408,0.01392073,0.0144547,-0.01399673,-0.01926831,0.0209088,0.03437813,-0.00138094,-0.00684087,-0.02884908,-0.00981312,-0.07648662,0.03728672,-0.06648639,-0.05161222,0.09385414,-0.0979946],"last_embed":{"hash":"qmor35","tokens":457}}},"last_read":{"hash":"qmor35","at":1774939671983},"class_name":"SmartSource","last_import":{"mtime":1774939638744,"size":3500,"at":1774939651607,"hash":"qmor35"},"blocks":{"#---frontmatter---":[1,18],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care":[20,42],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#{1}":[21,25],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#📝 Benim Notlarım":[26,28],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🟡 Genel Bilgiler (Sarı)":[29,31],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🔴 Bulgular (Kırmızı)":[35,37],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🟠 Limitasyonlar (Turuncu)":[41,42],"#Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care#🟠 Limitasyonlar (Turuncu)#{1}":[42,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/RVKBKT7F","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/LDMEZWPR?page=1&annotation=V94TXJ2R","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/LDMEZWPR?page=1&annotation=NZ2PDN7N","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/LDMEZWPR?page=1&annotation=GDYEIZ5H","line":42}],"metadata":{"Title":"Artificial Intelligence in Clinical Nutrition: Bridging Data Analytics and Nutritional Care","Authors":"Jithinraj Edakkanambeth Varayil, Suzette J. Bielinski, Manpreet S. Mundi, Sara L. Bonnes, Bradley R. Salonen, Ryan T. Hurt","Year":2025,"DOI":"10.1007/s13668-025-00680-x","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This review explores how artificial intelligence can help advance clinical nutrition and address nutrition education and practice challenges. It highlights the role of AI, mainly through advanced clinical decision-making using generative AI, in supporting clinicians as they develop personalized nutrition interventions for individual patients. Furthermore, the review discusses how AI technologies are helping to close the knowledge gap in nutrition and delivering real-time, evidence-based insights to healthcare professionals","Findings":"AI processes, such as machine learning and natural language processing, have shown promising results in predicting nutritional outcomes and complications, such as malnutrition and central line-associated bloodstream infections. Studies highlight the capability of AI to efficiently process large datasets, identify key risk factors, and provide realtime support to clinicians. Furthermore, AI can personalize educational content, making complex nutritional concepts more accessible.","Conclusions":"","Limitations":"However, much work still needs to be done to evaluate its accuracy, accessibility and ethical considerations.","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"qmor35","at":1774939671824}},"smart_blocks:varayilArtificialIntelligenceClinical2025a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04208767,0.0100486,0.01005717,-0.01486318,0.01485267,-0.00322746,0.00593813,0.0808801,0.02905148,-0.03588323,0.01002306,-0.06546679,0.02760953,0.0461459,0.0570991,-0.024879,0.00164821,0.02778102,-0.04201726,0.02686521,0.04245453,-0.02139567,-0.00380018,-0.02604766,-0.02103391,0.0062656,-0.01716039,-0.07354003,-0.05295975,-0.21709128,0.04030887,-0.03713782,0.07926297,-0.02664961,-0.0349877,0.01853089,-0.00110414,0.05567636,0.01717525,0.04970554,0.04565646,-0.02989175,0.01830762,-0.01280177,0.03356303,-0.02352855,-0.02104237,0.00065455,-0.0566436,-0.00172439,-0.06303211,-0.01879608,0.0360405,0.06591894,0.04763981,0.00567319,0.0207043,0.01501833,0.04667333,0.09220521,0.023192,0.05586993,-0.18514283,0.08028723,0.05278485,0.04244248,-0.05137439,0.01717358,0.0160847,-0.04298493,-0.04130868,0.01639521,0.05026745,0.02522105,0.01019589,0.02311059,0.04917371,-0.03943629,0.00567202,0.00956104,0.00791811,0.0526909,-0.03498577,0.0117022,-0.07307699,-0.01639061,-0.02804496,-0.07020172,0.07691244,-0.04977832,-0.01082919,-0.02729926,-0.03789515,0.04599936,0.02419668,-0.00346649,-0.0261668,-0.02087194,-0.07980285,0.07661351,-0.02297187,-0.04851989,-0.00091879,-0.02005741,0.01635709,-0.064058,-0.05643193,-0.05620577,-0.01037267,0.02869356,-0.03454087,-0.00960603,-0.00621925,0.00993169,-0.04837666,0.06547366,0.10588771,0.02699386,-0.00183425,-0.00909258,-0.01972946,0.04168937,0.04446077,0.02797305,0.01311402,-0.00787495,0.0300667,0.06783283,-0.03293346,-0.02988304,0.0861074,0.02518271,-0.0869984,-0.01275038,0.006198,0.00867046,0.0116334,-0.02959686,-0.03086047,0.03