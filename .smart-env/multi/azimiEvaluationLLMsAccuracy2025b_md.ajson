1,0.07915343,0.17895049,-0.02211991,-0.04530796,0.0580199,0.01713125,-0.0258607,0.05158476,-0.00244419,0.03012528,0.03910365,0.09127152,0.03016163,0.02565075,0.06296816,-0.06127523,-0.0087036,0.00556242,-0.00544506,0.051396,-0.02038276,-0.00354756,-0.04249598,0.12010608,-0.0152482,0.03209274,-0.0853283,-0.00543272,0.01456168,-0.02240275,-0.02643104,-0.00839089,-0.01695536,0.0592622,-0.03573212,0.00282588,-0.01319306,-0.05058648,-0.03512921,0.04932926,-0.02361891,0.0402769,0.04386323,-0.05436219],"last_embed":{"hash":"1botouy","tokens":402}}},"last_read":{"hash":"1botouy","at":1774939652826},"class_name":"SmartSource","last_import":{"mtime":1774939638330,"size":3331,"at":1774939651537,"hash":"1botouy"},"blocks":{"#---frontmatter---":[1,18],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval":[20,44],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#{1}":[21,25],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#📝 Benim Notlarım":[26,30],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#📝 Benim Notlarım#{1}":[27,28],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#📝 Benim Notlarım#{2}":[29,30],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟡 Genel Bilgiler (Sarı)":[31,33],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔴 Bulgular (Kırmızı)":[37,39],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/39JP5FYC","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5MMDHYPG?page=1&annotation=FV4PYSPB","line":35},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/5MMDHYPG?page=10&annotation=7PG9WDTK","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5MMDHYPG?page=1&annotation=XA4KF2D8","line":38},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5MMDHYPG?page=1&annotation=8N6UHE52","line":41}],"metadata":{"Title":"Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval","Authors":"Iman Azimi, Mohan Qi, Li Wang, Amir M. Rahmani, Youlin Li","Year":2025,"DOI":"10.1038/s41598-024-85003-w","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"In this paper, we propose to employ the Registered Dietitian (RD) exam to conduct a standard and comprehensive evaluation of state-of-the-art LLMs, GPT-4o, Claude 3.5 Sonnet, and Gemini 1.5 Pro, assessing both accuracy and consistency in nutrition queries.techniques: 1) Zero Shot prompting (ZS), 2) Chain of Thought (CoT), 3) Chain of Thought with Self Consistency (CoT-SC), and 4) Retrieval Augmented Prompting (RAP) enabled by external nutrition knowledge.","Findings":"Our findings revealed that while these LLMs obtained acceptable overall performance, their results varied considerably with different prompts and question domains.  GPT-4o with CoT-SC prompting outperformed the other approaches, whereas Gemini 1.5 Pro with ZS recorded the highest consistenc","Conclusions":"Consequently, choosing the appropriate LLM and prompting technique, tailored to the proficiency level and specific domain, can mitigate errors and potential risks in diet and nutrition chatbots.","Limitations":"","User_Notes":"prompt görmedim ama gerekli.  dyt karşılaştırmasından emin olamadım."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1botouy","at":1774939652665}},"smart_blocks:azimiEvaluationLLMsAccuracy2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06365856,0.01740527,-0.0218107,0.02059761,-0.01895107,-0.00625661,-0.01511355,0.04473716,0.00961501,-0.04758722,-0.02872403,-0.10501644,0.04696831,0.03426896,0.02346164,-0.00845285,0.02859149,0.02537591,0.00130658,0.04209232,0.04156973,-0.05780543,0.0360906,0.01059061,0.07338713,-0.03008307,-0.03625193,-0.01524376,-0.07109473,-0.27494621,0.05370546,-0.02593368,0.04310056,-0.04223628,-0.06942669,0.02496338,-0.01672293,0.0244239,-0.00517271,-0.00751407,0.06752969,0.03560562,-0.0114052,-0.01556145,-0.02125765,-0.06389949,-0.01907339,0.00108343,-0.05991727,-0.00277162,-0.01327194,-0.04956565,0.06234278,-0.00413945,0.01708149,0.03958474,0.04701288,0.06014129,0.01989597,0.02500771,0.03921047,0.07507648,-0.24631827,0.09163831,0.03560488,0.04708229,-0.03877483,0.0099173,0.00579292,-0.01705,-0.0325815,0.00668517,0.03748817,0.03804114,-0.02030241,0.05175198,0.0475825,-0.03532147,-0.01716829,-0.04841798,-0.00447533