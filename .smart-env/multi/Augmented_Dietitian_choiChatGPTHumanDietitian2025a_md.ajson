.04459043,0.03678842,-0.07473031,0.03088297,0.02387489,0.17637232,-0.06614837,0.00825012,0.00669781,0.00899929,-0.05550665,0.04912276,-0.02323513,-0.01376625,0.01952758,0.11566326,0.01054654,0.01903788,0.03706438,-0.04398111,-0.01601993,-0.02993952,-0.0244984,0.03010866,-0.03495073,-0.04224238,-0.02498022,0.10904916,0.0379793,-0.03891746,-0.1173253,-0.04813528,-0.01298836,-0.00543244,0.00087329,-0.01574995,-0.0024033,0.02490578,-0.04201624,0.00096834,-0.03282336,-0.01719272,-0.01995448,0.02990897,0.02509588,0.00506244,0.08166509,-0.01828043],"last_embed":{"hash":"lwfjmn","tokens":431}}},"last_read":{"hash":"lwfjmn","at":1778067900950},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":3119,"at":1778067900950,"hash":"lwfjmn"},"blocks":{"#---frontmatter---":[1,18],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study":[20,42],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#{1}":[21,25],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#📝 Benim Notlarım":[26,28],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🟡 Genel Bilgiler (Sarı)":[29,31],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🔴 Bulgular (Kırmızı)":[35,37],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/VXVHUHUK","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/JFMH6RLP?page=1&annotation=27V5SRGE","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/JFMH6RLP?page=1&annotation=DQDNC6VQ","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/JFMH6RLP?page=1&annotation=G5J63QK4","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/JFMH6RLP?page=1&annotation=2X5HPL2D","line":39}],"metadata":{"Title":"ChatGPT and human dietitian responses to diet-related questions on an online Q&A platform: A comparative study","Authors":"Seul Ki Choi, Yunseo Moon, Hyunggu Jung","Year":2025,"DOI":"10.1177/20552076251361381","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aimed to assess ChatGPT’s capacity to provide responses to diet-related questions, compared to responses by dietitians.A total of 928 diet-related questions and corresponding responses from dietitians were collected from Naver Knowledge-iN, a Korean online Q&A platfo","Findings":"The average similarity coefficient between ChatGPT and dietitian responses was 0.42. Questions with high response similarity tended to include detailed information, such as specific food items or portions (76.1%), the questioner’s context (69.6%), or personal characteristics (17.4%). Low response similarity was mainly due to ChatGPT providing significantly longer responses than dietitians","Conclusions":"ChatGPT demonstrated content similarity to dietitian responses, but they were not identical. The development of prompt engineering techniques to enhance ChatGPT’s ability to provide more expert-like and personalized information could benefit users seeking dietary information.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"lwfjmn","at":1774939761353},"key":"Augmented Dietitian/choiChatGPTHumanDietitian2025a.md"},
