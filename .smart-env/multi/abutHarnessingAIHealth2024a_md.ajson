439244,0.15835163,-0.08053073,0.03084783,0.05326084,0.01956199,-0.02401523,0.06014854,-0.005202,0.03678995,-0.01132713,0.10496169,-0.0035981,0.06313347,0.14453782,-0.03444288,-0.03697201,0.04224266,-0.01987691,0.05958197,-0.00517868,-0.00357477,-0.00157332,0.09036452,-0.01018049,-0.00960886,-0.03119331,-0.06660298,0.01718375,-0.00536436,0.01280837,0.00026409,-0.0062408,0.02364331,0.01673325,0.00131626,-0.04303582,-0.06093476,-0.0398363,0.04773834,-0.00290147,0.00543126,0.03173861,-0.08064239],"last_embed":{"hash":"1vqd94g","tokens":400}}},"last_read":{"hash":"1vqd94g","at":1774939651830},"class_name":"SmartSource","last_import":{"mtime":1774939638293,"size":3280,"at":1774939651533,"hash":"1vqd94g"},"blocks":{"#---frontmatter---":[1,18],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction":[20,42],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#{1}":[21,25],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#📝 Benim Notlarım":[26,28],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟡 Genel Bilgiler (Sarı)":[29,31],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔴 Bulgular (Kırmızı)":[35,37],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/ES4E88FQ","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CHWKEDVN?page=1&annotation=2IVUFX9Y","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/CHWKEDVN?page=1&annotation=7MASVE96","line":36},{"title":"Sayfa 13","target":"zotero://open-pdf/library/items/CHWKEDVN?page=13&annotation=P9YDWCLS","line":39}],"metadata":{"Title":"Harnessing AI for Health: Optimized Neural Network Models for Resting Metabolic Rate Prediction","Authors":"Fatih Abut, Ezgi Akça, Mehmet Fatih Akay, Mustafa Irmak, Müzda Irmak, Yildirim Adigüzel","Year":2024,"DOI":"10.1109/ACCESS.2024.3477326","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"This study aims to develop new models for predicting RMR using General Regression Neural Network (GRNN). Additionally, prediction models based on Multi-Layer Perceptron (MLP) will be created for comparison purposes","Findings":"prediction. The GRNN-based models performed better than the ones built by MLP, demonstrating its feasibility as a tool for predicting RMR accurately. The results have also been compared with up-to-date prediction equations from related literature, and our optimized models perform significantly better than those. The proposed best performing GRNN model achieved an R value of 0.85, RMSE of 134.91 kcal/day, and MAPE of 10.20%, significantly outperforming traditional predictive equations such as the Harris-Benedict and Mifflin-St Jeor equations, which showed RMSE values above 400 kcal/day and MAPE values exceeding 12.5%.","Conclusions":"Consequently, the developed software offers dietitians a valuable tool for accurately calculating the RMR of their patients, thereby enhancing personalized dietary planning and wellness management.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1vqd94g","at":1774939651617}},"smart_blocks:abutHarnessingAIHealth2024a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03355321,0.01784359,-0.02057236,0.02123569,0.02848682,0.03069986,-0.04626254,0.05646877,0.03897023,-0.03202943,-0.01294717,-0.08056195,0.01238944,0.07789267,0.01171785,-0.03748694,0.00417539,0.01090085,0.02006912,-0.0280446,0.05942183,-0.0154229,0.02139465,-0.05773896,0.0460509,-0.02045497,-0.02212309,-0.01267371,-0.06414805,-0.23868971,0.02636824,-0.04928906,0.063309,-0.00505234,-0.07331467,0.02446114,0.02908554,0.03510611,-0.0521438,0.07451237,-0.0003003,0.01353688,0.01948861,-0.00658172,0.0756036,0.01273756,-0.04040392,-0.0342447,-0.05792117,-0.03669503,-0.02461185,-0.02146574,0.04095252,0.03446081,0.02267513,0.00139818,0.02640622,0.06210855,0.00958616,0.08101496,-0.01649551,0.06424514,-0.22481984,0.01825324,0.01994573,0.04046582,-0.06565879,-0.00476199,0.0049949,0.03194546,-0.02027917,0.00319595,0.00741194,-0.01518322,-0.02710465,0.04195696,0.08001959,0.00062453,-0.01364382,0.00130056,0.04708435,0.05975214,-0.02049326,-0.06208991,0.03567958,0.00790504,-0.01472317,-0.04271781,0.01333751,-0.04108937,-0.0309876,-0.03353062,-0.00316075,0.02380773,-0.01500069,0.01472245,0.03121518,0.01564927,-0.10942297,0.09589991,-0.02045378,0.01132023,-0.01560191,-0.02098372,0.04086727,-0.0493298,-0.06591513,0.00130896,-0.01471924,-0.0097716,-0.01633884,0.00687164,0.01209729,-0.01716269,0.00267627,0.00553989,0.0787592,0.04985701,0.00800285,-0.00126485,-0.05183868,-0.02832914,0.0538702,0.05698496,0.00791409,0.00185594,-0.02645689,0.09599787,0.01060027,0.01656024,0.0711507,0.01504428,-0.06391748,-0.02091707,0.02629418,-0.03145378,0.05828249,-0.00662705,-0.0197315,-0.00213757,-0.05469758,0.00489547,-0.01785432,-0.09294223,-0.11909049,0.16596647,-0.0195198,-0.0097212,-0.01514