942,0.03403706,-0.01240686,0.04345538,-0.01005846,0.01800404,-0.09740819,0.07069317,0.03434361,0.22222291,-0.06788538,0.00663418,0.06267335,-0.02632056,-0.02299018,0.0195502,-0.03034355,0.03515278,0.05435782,0.09558755,-0.00171942,0.00238632,0.06676811,-0.05972701,-0.04264763,0.02239439,0.01298852,0.00355504,-0.03620204,-0.06588088,0.00800502,0.10180874,-0.04256591,-0.04140028,-0.07947622,-0.0209003,0.02070313,0.02022193,-0.02847237,-0.02161259,-0.01358879,0.03173996,0.02429926,0.01132371,-0.01977016,-0.02297734,-0.06375118,0.01393526,-0.02334852,-0.00379693,0.08979037,-0.05966846],"last_embed":{"hash":"1h2cg4r","tokens":414}}},"last_read":{"hash":"1h2cg4r","at":1774939543310},"class_name":"SmartSource","last_import":{"mtime":1774939523445,"size":3272,"at":1774939536707,"hash":"1h2cg4r"},"blocks":{"#---frontmatter---":[1,18],"#Fuzzy Deep Daily Nutrients Requirements Representation":[20,42],"#Fuzzy Deep Daily Nutrients Requirements Representation#{1}":[21,25],"#Fuzzy Deep Daily Nutrients Requirements Representation#📝 Benim Notlarım":[26,28],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟡 Genel Bilgiler (Sarı)":[29,31],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔴 Bulgular (Kırmızı)":[35,37],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Fuzzy Deep Daily Nutrients Requirements Representation#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Fuzzy Deep Daily Nutrients Requirements Representation#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/7IUNWJMS","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=3Q7WL4QP","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=D6HE3VQA","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/HH6X6CPC?page=1&annotation=TNUGFXXA","line":39}],"metadata":{"Title":"Fuzzy Deep Daily Nutrients Requirements Representation","Authors":"Karim El Moutaouakil, Abdellah Ahourag, Saliha Chellak, Hicham Baїzri, Mouna Cheggour","Year":2022,"DOI":"10.18280/ria.360210","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"First, we collect the expert's nutrients recommendations from different expert research papers. These recommendations are, then, represented in terms of trapezoidal numbers by adopting appropriate rules that encourage the consumption of the favorable nutrients and limit consumption of the unfavorable nutrients in daily diets. Then, we generate large data sets basing on the trapezoidal representation. To transform the expert's recommendations into significant crisp values, we call the auto-encoder neural network, and we propose an original regulation term that controls all the auto-encoder units. To select the best autoencoder architecture, we use the fuzzy genetic algorithm basing on a simple fuzzy rule to determine the crossover percent, the mutation percent, and the population size at each iteration","Findings":"Compared to the random systems, the proposed method has shown a great capacity to generalize its experience to unseen recommendations.","Conclusions":"In a clinical setting, our system can be used by a dietician to accurately determine the daily nutrient requirements of a given individual.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1h2cg4r","at":1774939543155}},"smart_blocks:Augmented Dietitian Okunmuşlar/elmoutaouakilFuzzyDeepDaily2022.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.09663201,-0.