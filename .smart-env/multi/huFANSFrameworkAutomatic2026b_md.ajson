03760328,0.18251747,-0.00587859,0.00353782,0.06205437,-0.00902596,-0.02730479,0.04499024,-0.00707625,0.04820065,-0.00282709,0.08793882,0.04800548,-0.01441837,0.0553802,-0.01830224,-0.066089,-0.02212908,0.01358969,0.05882457,-0.01291749,-0.04372698,-0.04061555,0.10725592,-0.03203844,0.02346006,-0.05872369,-0.00332373,-0.01211093,0.04169352,-0.03072322,0.01927987,0.01534118,0.0209935,-0.00743775,0.02098066,-0.01253274,0.02903492,-0.0608124,0.02558969,-0.00515404,-0.02331174,0.07750151,-0.05723709],"last_embed":{"hash":"10kt37a","tokens":421}}},"last_read":{"hash":"10kt37a","at":1774939661236},"class_name":"SmartSource","last_import":{"mtime":1774939638538,"size":4198,"at":1774939651567,"hash":"10kt37a"},"blocks":{"#---frontmatter---":[1,18],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes":[20,42],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#{1}":[21,25],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#📝 Benim Notlarım":[26,28],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟡 Genel Bilgiler (Sarı)":[29,31],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔴 Bulgular (Kırmızı)":[35,37],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/JM7L9I9D","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=48QLTY42","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=BQIJU94Z","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=FUAH5SXV","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=9ZCXQE4E","line":36},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/ADFIFMW7?page=1&annotation=SM2W9RX3","line":39}],"metadata":{"Title":"FANS: A framework for automatic assessment of nutritional status based on free-text clinical notes","Authors":"Jiahui Hu, Xue Wang, Kuanda Yao, Xu Zhang, Wanqing Zhao, Jin Fu, Pei Lou, Wei Chen, An Fang","Year":2026,"DOI":"10.1016/j.ijmedinf.2025.106168","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We aimed to develop and validate an approach that automatically identifies malnutrition risk factors from free-text clinical notes, and assess nutritional status of hospitalized patients rapidly under the situation of limited labeled data.The clinical notes of 1,469 patients used in this study were collected from the Peking Union Medical College HospitalSix natural language processing models were performed and compared. For nutritional status assessment, a semi-supervised learning (SSL) mechanism was applied based on the self-learning algorithm (SLA). The Shapley Additive exPlanations (SHAP) method was further employed to explore the interpretability.","Findings":"For risk factor identification, all pre-trained models outperformed the traditional machine learning models, and the best performance achieved with an F1 score of 0.9142. For nutritional status assessment, the SLA-based SSL improved the performance by introducing high confidence samples, and the area under the receiver operating characteristic curve (AUROC) for the optimized model achieved 0.8234. The unintentional weight loss and decreased food intake were the most impactful features recorded in clinical notes identified by the SHAP analysis.","Conclusions":"study presented a feasible NLP-based approach for nutritional risk assessment, and demonstrated the potential of machine learning for high-performance healthcare artificial intelligence services.","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"10kt37a","at":1774939661087}},"smart_blocks:huFANSFrameworkAutomatic2026b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07488061,0.02341308,-0.00883997,-0.02542786,0.01024684,0.04413317,-0.0181963,0.03991743,0.01674305,-0.02225866,0.0324071,-0.09427319,0.0337707,0.02044855,0.03595212,-0.01794214,0.0262179,0.03407876,-0.05268596,0.02247745,0.04860832,-0.02692558,0.00682731,0.02019707,0.08267821,0.01618954,-0.04361149,-0.05333846,-0.07374483,-0.2540327,0.01192164,-0.04704174,0.0752084,-0.05366429,-0.04590049,0.00302114,0.00794839,0.05523549,-0.01213745,0.0300445,0.04760873,-0.00559058,0.02993334,0.03674166,0.03772743,-0.05398852,-0.01367884,-0.01385056,-0.03420944,0.0091551,-0.05043571,0.02402375,0.00705057,0.04717667,0.02872746,0.01781414,0.07496464,0.00712746,0.0305283,0.06783872,0.01223185,0.06293252,-0.20249283,0.03677635,0.0789617,0.04918941,-0.05869404,-0.00555884,0.02720442,-0.03465441,-0.04151144,0.05132877,0.0536522,0.04217298,-0.00082791,0.00702689,0.0615151,-0.01967691,0.00055546,0.00188131,0.00609114,0.06292652,-0.02908143,0.00503204,-0.03379544,-0.0332085,-0.02906957,-0.05512974,0.07315709,-0.05497343,-0.01502024,-0.02679543,-0.01749974,0.0560