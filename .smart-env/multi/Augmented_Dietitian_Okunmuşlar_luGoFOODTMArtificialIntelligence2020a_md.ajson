351642,0.00016034,0.02923488,-0.00006366,0.05443048,-0.09444906,-0.00198013,0.06440802,0.18566281,-0.08010104,-0.05302073,0.07060904,0.01038602,-0.05334264,0.02494971,-0.00617123,0.02374867,0.02445443,0.08846721,-0.01145602,0.01756079,0.07220934,-0.04502537,-0.05916619,-0.04151757,-0.02427309,0.02800813,0.00374227,-0.03411851,0.00078689,0.10058979,-0.01600146,0.00678354,-0.05511102,-0.03232589,0.03602393,-0.02163454,-0.01814252,-0.02810704,0.00570211,0.06368247,-0.01064661,-0.00782056,-0.00806907,-0.03321539,-0.03648034,0.01164072,-0.01621442,0.02926677,0.069323,-0.04324529],"last_embed":{"hash":"1ahjruv","tokens":409}}},"last_read":{"hash":"1ahjruv","at":1774939550923},"class_name":"SmartSource","last_import":{"mtime":1774939523617,"size":3187,"at":1774939536738,"hash":"1ahjruv"},"blocks":{"#---frontmatter---":[1,18],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment":[20,42],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#{1}":[21,25],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#📝 Benim Notlarım":[26,28],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#📝 Benim Notlarım#{1}":[27,28],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟡 Genel Bilgiler (Sarı)":[29,31],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🔴 Bulgular (Kırmızı)":[35,37],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LFIEJ6MP","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=1&annotation=8IF2F996","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=1&annotation=BGMYH62J","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=1&annotation=BCRPT9VT","line":36},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=9&annotation=JDRACVQS","line":36}],"metadata":{"Title":"goFOODTM: An Artificial Intelligence System for Dietary Assessment","Authors":"Ya Lu, Thomai Stathopoulou, Maria F. Vasiloglou, Lillian F. Pinault, Colleen Kiley, Elias K. Spanakis, Stavroula Mougiakakou","Year":2020,"DOI":"10.3390/s20154283","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We propose a dietary assessment system based on artificial intelligence (AI), named goFOODTM. The system can estimate the calorie and macronutrient content of a meal, on the sole basis of food images captured by a smartphone.The deep neural networks are used to process the two images and implements food detection, segmentation and recognition, while a 3D reconstruction algorithm estimates the food’s volume.","Findings":"The experimental results demonstrate that goFOODTM performed better than experienced dietitians on the non-standardized meal database, and was comparable to them on the fast food database.It should be noted that goFOODTM performed much better than the dietitians’ estimations on the MADiMa database, and was somewhat inferior to the dietitians’ estimations on the Fast Food database. To further support the above findings, the two-sample t-test is conducted on both databases (statistical significance was set to 0.05)","Conclusions":"","Limitations":"","User_Notes":"ai>dyt çıkmış"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1ahjruv","at":1774939550766}},"smart_blocks:Augmented Dietitian Okunmuşlar/lu