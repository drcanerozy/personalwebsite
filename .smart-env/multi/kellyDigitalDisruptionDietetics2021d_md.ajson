-0.00300393,-0.12148256,0.01071409,0.00674066,0.15071645,-0.04351988,0.03378511,0.06782778,-0.02070813,0.03040037,0.01601882,-0.01417135,0.00974074,0.01172309,0.06691635,0.01680614,0.02245613,-0.06251097,0.00563597,-0.0026845,-0.01571739,-0.02919343,0.04969987,0.00360126,0.04097294,-0.01638588,0.09980918,-0.04118456,-0.03560258,-0.04868468,0.00108271,0.00885323,-0.00138312,-0.02461331,0.00814941,0.04965954,0.04602075,0.02255463,-0.01577431,-0.01127385,-0.06023128,-0.03702484,0.02999577,-0.03224202,-0.02368017,0.08476553,-0.02650404],"last_embed":{"hash":"qopbe9","tokens":417}}},"last_read":{"hash":"qopbe9","at":1774939662289},"class_name":"SmartSource","last_import":{"mtime":1774939638547,"size":4120,"at":1774939651570,"hash":"qopbe9"},"blocks":{"#---frontmatter---":[1,18],"#Digital disruption of dietetics: are we ready?":[20,44],"#Digital disruption of dietetics: are we ready?#{1}":[21,25],"#Digital disruption of dietetics: are we ready?#📝 Benim Notlarım":[26,30],"#Digital disruption of dietetics: are we ready?#📝 Benim Notlarım#{1}":[27,28],"#Digital disruption of dietetics: are we ready?#📝 Benim Notlarım#{2}":[29,30],"#Digital disruption of dietetics: are we ready?#🟡 Genel Bilgiler (Sarı)":[31,33],"#Digital disruption of dietetics: are we ready?#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Digital disruption of dietetics: are we ready?#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Digital disruption of dietetics: are we ready?#🔴 Bulgular (Kırmızı)":[37,39],"#Digital disruption of dietetics: are we ready?#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Digital disruption of dietetics: are we ready?#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Digital disruption of dietetics: are we ready?#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Digital disruption of dietetics: are we ready?#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LVC2MZ65","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D69ETJZ9?page=1&annotation=EAZNG9BM","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/D69ETJZ9?page=1&annotation=CG37SR9X","line":38},{"title":"Sayfa 8","target":"zotero://open-pdf/library/items/D69ETJZ9?page=8&annotation=WEXEX32L","line":41}],"metadata":{"Title":"Digital disruption of dietetics: are we ready?","Authors":"J. T. Kelly, P. F. Collins, J. McCamley, L. Ball, S. Roberts, K. L. Campbell","Year":2021,"DOI":"10.1111/jhn.12827","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The digital disruption of traditional dietetic services is occurring worldwide, supporting responsive and high-quality nutrition care. These disruptive technologies include integrated electronic and personal health records, mobile apps, wearables, artificial intelligence and machine learning, conversation agents, chatbots, and social robots. Here, we outline how digital health is disrupting the traditional model of nutrition care delivery and outline the potential for dietitians to not only embrace digital disruption, but also take ownership in shaping it, aiming to enhance patient care","Findings":"It is imperative that dietitians stay abreast of these technological developments and be the leaders of the disruption, not simply subject to it. By doing so, dietitians now, as well as in the future, will maximise their impact and continue to champion evidence-based nutrition practice.","Conclusions":"To achieve widespread adoption of digital nutrition care interventions, issues of data security, policies and regulations, interoperability and remuneration require attention.  The digital disruption of traditional NCP delivery is here, we call on dietitians around the world to be the leaders of this disruption, not the subject of it. It is imperative that dietitians stay abreast of technological developments and understand how digital health can be used to support and improve their current practice, ensuring that dietitians remain effective and are the champions of evidencebased nutrition care.","Limitations":"","User_Notes":"table 1 çok iyi.  notebooklmde bir deş bunu."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"qopbe9","at":1774939662125}},"smart_blocks:kellyDigitalDisruptionDietetics2021d.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02170409,0.00091427,0.05337619,-0.00508598,-0.02541419,-0.00264011,-0.02756965,0.06971515,0.01424185,-0.04751585,0.01394997,-0.0682863,0.03530378,0.01405435,0.04663898,-0.0237308,0.03510485,-0.01684953,-0.00631838,0.0394282,0.03684033,-0.00942588,0.04073811,0.01727324,0.0191305,0.00463322,0.01348046,-0.04646067,-0.04272909,-0.19772816,0.00345214,-0.02397459,0.01476924,-0.02416771,-0.01723737,-0.01009425,0.00449674,0.01013858,0.03926207,0.04046631,-0.01024638,0.03356243,-0.01686295,-0.05495464,-0.05332636,-0.00644268,-0.03969971,0.01918038,-0.07165948,-0.05492118,-0.02395235,-0.02742726,0.0452878,0.05216507,0.04904002,0.02890856,0.06022474,0.01976526,0.06903201,0.06634498,0.05185695,0.05259096,-0.22109455,0.12578773,0.04032452,0.05176269,-0.0306275,-0.01265681,0.04320277,-0.00495612,-0.05376112,-0.04407592,0.00414023,0.04309238,0.01136708,0.01631044,0.06606426,-0.04109168,0.00821859,-0.02775929,0.03504753,0.06046625,-0.03067362,-0.02231922,-0.12638621,-0.01610361,-0.05059114,-0.09055003,0.0026318,-0.03850944,-0.03449684,-0.00617308,0.05779357,-0.00679364,-0.0667792,-0.03291172,-0.00909461,-0.01829348,-0.01534592,0.10878057,-0.04778513,0.00249276,0.01169147,0.00083816,0.03052439,-0.06487419,-0.00157523,-0.11653606,0.03765194,0.05952417,-0.0063296,-0.01781233,0.02817758,0.00342889,0.00250896,0.04590382,0.04211637,0.01392783,0.00965924,-0.00008214,-0.03242512,0.09065688,0.05609895,-0.00406821,-0.00997305,0.02271918,0.03824275,0.11398216,-0.01750172,0.00502374,0.05472031,0.01050903,-0.03232588,0.01255595,0.00346979,-0.03413785,-0.01335241,-0.08673068,-0.01193316,0.03884315,0.001