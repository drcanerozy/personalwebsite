SDM","Limitations":"","User_Notes":"weight-specific health literacy instrument (WSHLI) and Shared Decision-Making Questionnaire (SDMQ) were used to measure factors influencing weight-loss decisions.  prompt ve dyt karşılaştırması yok, gerekli mi doğrulanacak"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"69q5q2","at":1774939541845}},"smart_blocks:Augmented Dietitian Okunmuşlar/chuEffectHealthLiteracy2022a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04343618,-0.01766477,0.00272485,0.02091681,-0.07813424,0.03223974,0.01263727,0.09709769,0.03484285,-0.00509285,-0.00687695,-0.06982231,0.02360412,0.06075464,0.03133772,0.00897345,-0.01218504,0.05569524,-0.03044701,0.03031513,0.06597496,-0.03385929,0.01391435,0.00891931,-0.0260335,0.00002564,-0.00125968,-0.05502058,-0.03171711,-0.17256144,0.06309769,-0.03739417,0.09908606,-0.03990727,-0.07755143,0.06043618,-0.01637776,0.04156793,-0.06244002,0.01419528,-0.01085119,0.00563679,0.04254926,-0.01293302,0.04269314,-0.01274557,-0.02313177,-0.03564692,-0.09095264,0.01779649,-0.01555065,-0.03737926,0.05634631,0.05799429,0.04833672,0.03666694,0.0294314,0.07956594,0.05319949,0.01997958,0.02240377,0.08730002,-0.20107757,0.10067726,0.01568103,0.02383197,-0.08063706,-0.02557479,0.07071053,-0.03408537,-0.00132607,-0.0007645,0.06889639,0.05304026,0.00309953,0.04107923,0.06878078,-0.08110486,0.03540334,-0.03734741,0.00614452,0.04237247,-0.03460102,-0.0039433,-0.04423612,-0.01021592,0.00910518,-0.09746405,0.00832913,-0.0394527,-0.02294816,-0.03298306,-0.04685148,0.02316076,-0.04098269,-0.01696244,-0.01161871,-0.0334616,-0.11946134,0.12981133,-0.06410015,-0.05028262,0.00733157,-0.00527092,0.03453042,-0.04856247,-0.02918702,-0.09798335,0.00767666,0.03928844,-0.00800319,-0.01276632,0.04755166,0.02382582,-0.04007796,0.0850151,0.06910352,0.0598226,0.03097205,0.01987706,-0.0214345,0.0271114,0.05307989,0.02051586,-0.00650631,-0.02143913,0.0387831,0.11070696,-0.02061364,-0.03768581,0