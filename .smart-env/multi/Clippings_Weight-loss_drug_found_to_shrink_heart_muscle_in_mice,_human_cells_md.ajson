rticle/PIIS2213-8587\\(24\\","line":36},{"title":"Carla Prado","target":"https://apps.ualberta.ca/directory/person/cprado","line":38},{"title":"Faculty of Agricultural, Life & Environmental Sciences","target":"https://www.ualberta.ca/en/agriculture-life-environment-sciences/index.html","line":38},{"title":"Institute of Sensory Motor Rehabilitative Technology","target":"https://smartinstitute.ca/","line":62},{"title":"Alberta Diabetes Institute","target":"https://www.ualberta.ca/en/alberta-diabetes/index.html","line":62},{"title":"Alberta Transplant Institute","target":"https://www.ualberta.ca/en/alberta-transplant-institute/index.html","line":62},{"title":"Cancer Research Institute of Northern Alberta","target":"https://www.ualberta.ca/en/cancer-institute/index.html","line":62},{"title":"Women and Children’s Health Research Institute","target":"https://www.wchri.org/","line":62}],"metadata":{"title":"Weight-loss drug found to shrink heart muscle in mice, human cells","source":"https://www.ualberta.ca/en/folio/2024/11/weight-loss-drug-found-to-shrink-heart-muscle.html","author":null,"published":null,"created":"2025-04-28","description":"A U of A team that set out to study why a side-effect of drugs like Ozempic is the loss of skeletal muscle found that other types of muscle, such as cardiac muscle, are also decreased in response to Ozempic — leading them to conclude that if Ozempic also causes a decrease in cardiac mass in humans, it could be detrimental in the long term.","tags":[]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"w0ukbv","at":1768747612188}},"smart_blocks:Clippings/Weight-loss drug found to shrink heart muscle in mice, human cells.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05080003,-0.01950979,0.03328447,0.01472142,-0.01017442,0.07234578,0.00173404,0.04136549,0.02446663,-0.09332051,0.05322877,-0.04831605,0.01656723,0.05662666,0.04075538,-0.06121862,0.02250568,0.02065384,-0.13988033,-0.