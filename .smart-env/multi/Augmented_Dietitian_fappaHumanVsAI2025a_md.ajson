-0.04618241,-0.00970733,0.03153413,0.18460955,-0.06547038,-0.01484332,0.03698054,-0.00638635,-0.02605673,0.00948916,-0.01546733,0.01016427,0.02520071,0.13909373,0.05391405,0.03256258,0.0553461,-0.05558295,-0.02922714,-0.01713996,-0.02519903,0.07281568,0.00901985,-0.00785733,0.02395008,0.11980693,0.03756254,-0.01739872,-0.04942635,-0.0183492,-0.00424807,-0.03647712,-0.02581746,-0.00700509,0.00381568,0.00262931,-0.01913356,0.01157515,-0.01497549,0.00220664,-0.02438261,0.01742592,0.04494097,-0.03469197,0.10889939,-0.03113922],"last_embed":{"hash":"r7dbr3","tokens":450}}},"last_read":{"hash":"r7dbr3","at":1778067901080},"class_name":"SmartSource","last_import":{"mtime":1774939523000,"size":4163,"at":1778067901083,"hash":"r7dbr3"},"blocks":{"#---frontmatter---":[1,18],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web":[20,42],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#{1}":[21,25],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#📝 Benim Notlarım":[26,28],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟡 Genel Bilgiler (Sarı)":[29,31],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔴 Bulgular (Kırmızı)":[35,37],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🔵 Sonuç / Conclusions (Mavi)#{1}":[39,40],"#Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/63MSTVP9","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/364P2SKM?page=1&annotation=RNBJ8CL7","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/364P2SKM?page=1&annotation=A2LDCFCG","line":36},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/364P2SKM?page=10&annotation=PJ6WAWDI","line":36},{"title":"Sayfa 13","target":"zotero://open-pdf/library/items/364P2SKM?page=13&annotation=X4H3ZEWL","line":39}],"metadata":{"Title":"Human vs. AI: Assessing the Quality of Weight Loss Dietary Information Published on the Web","Authors":"Evaggelia Fappa, Mary Micheli, Dimitris Panaretos, Marios Skordis, Petroula Tsirpanli, George I. Panoutsopoulos","Year":2025,"DOI":"10.3390/info16070526","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"The aim of the present study was to compare the quality assessment of online dietary weight loss information conducted by an AI assistant (ChatGPT 4.5) to that of health professionals.","Findings":"Analysis revealed no significant differences in quantitative quality scores between human raters, ChatGPT-4.5, and the AI-derived system (p = 0.528). On the contrary, statistically significant differences were found between the three content accuracy scores (p < 0.001), with scores assigned by ChatGPT-4.5 being higher than those assigned by humans (all p < 0.001). Our findings suggest that ChatGPT-4.5 could complement human experts in evaluating online weight loss information, when using a validated instrument like DISCERN. However, more relevant research is needed before forming any suggestions.In terms of classification, ChatGPT-4.5 rated 22% of webpages as “excellent” using DISCERN, while humans rated only 3%.","Conclusions":"Validated AI-assisted tools could be produced to perform dietary or health information quality assessments specific for each disease (i.e., obesity) or health status (i.e., pregnancy) for text and/or videos. Last, investigating how different versions of the same AI model perform could provide valuable insights into how rapidly evolving LLM capabilities affect assessment accuracy, potentially leading to the development of a gold standard methodology for AI-assisted evaluation of online nutritional information","Limitations":"","User_Notes":""},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"r7dbr3","at":1774939759140},"key":"Augmented Dietitian/fappaHumanVsAI2025a.md"},
