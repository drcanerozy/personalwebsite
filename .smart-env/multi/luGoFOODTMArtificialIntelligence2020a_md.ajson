25146,-0.00803427,0.06635981,0.19134949,-0.05807717,-0.04626661,0.06900834,0.00480942,-0.04230103,0.03753582,0.00386207,0.02615667,0.02488888,0.0877403,-0.01649467,0.01651666,0.07753687,-0.0393282,-0.06220074,-0.03955754,-0.0256391,0.01979051,0.01184008,-0.03997093,-0.00807038,0.0979272,-0.02280862,0.00228144,-0.03826289,-0.03889216,0.0430737,-0.0214142,-0.02991838,-0.02804996,0.00548365,0.06474303,-0.00262856,-0.0047165,-0.01248537,-0.04286187,-0.04191247,0.0073579,-0.02839825,0.03237019,0.07182679,-0.05766807],"last_embed":{"hash":"1ahjruv","tokens":420}}},"last_read":{"hash":"1ahjruv","at":1774939665176},"class_name":"SmartSource","last_import":{"mtime":1774939638599,"size":3187,"at":1774939651580,"hash":"1ahjruv"},"blocks":{"#---frontmatter---":[1,18],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment":[20,42],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#{1}":[21,25],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#📝 Benim Notlarım":[26,28],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#📝 Benim Notlarım#{1}":[27,28],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟡 Genel Bilgiler (Sarı)":[29,31],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟢 Yöntem & Örneklem (Yeşil)":[32,34],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟢 Yöntem & Örneklem (Yeşil)#{1}":[33,34],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🔴 Bulgular (Kırmızı)":[35,37],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🔴 Bulgular (Kırmızı)#{1}":[36,37],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🔵 Sonuç / Conclusions (Mavi)":[38,40],"#goFOODTM: An Artificial Intelligence System for Dietary Assessment#🟠 Limitasyonlar (Turuncu)":[41,42]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/LFIEJ6MP","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=1&annotation=8IF2F996","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=1&annotation=BGMYH62J","line":33},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=1&annotation=BCRPT9VT","line":36},{"title":"Sayfa 9","target":"zotero://open-pdf/library/items/5J5ZQJGZ?page=9&annotation=JDRACVQS","line":36}],"metadata":{"Title":"goFOODTM: An Artificial Intelligence System for Dietary Assessment","Authors":"Ya Lu, Thomai Stathopoulou, Maria F. Vasiloglou, Lillian F. Pinault, Colleen Kiley, Elias K. Spanakis, Stavroula Mougiakakou","Year":2020,"DOI":"10.3390/s20154283","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"We propose a dietary assessment system based on artificial intelligence (AI), named goFOODTM. The system can estimate the calorie and macronutrient content of a meal, on the sole basis of food images captured by a smartphone.The deep neural networks are used to process the two images and implements food detection, segmentation and recognition, while a 3D reconstruction algorithm estimates the food’s volume.","Findings":"The experimental results demonstrate that goFOODTM performed better than experienced dietitians on the non-standardized meal database, and was comparable to them on the fast food database.It should be noted that goFOODTM performed much better than the dietitians’ estimations on the MADiMa database, and was somewhat inferior to the dietitians’ estimations on the Fast Food database. To further support the above findings, the two-sample t-test is conducted on both databases (statistical significance was set to 0.05)","Conclusions":"","Limitations":"","User_Notes":"ai>dyt çıkmış"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1ahjruv","at":1774939665016}},"smart_blocks:luGoFOODTMArtificialIntelligence2020a.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI