,-0.02277499,-0.01054949,0.02548831,-0.07365124,0.01091522,-0.10332485,0.03898545,0.0776401,0.17290533,-0.04735659,-0.05187965,0.06691078,0.0262577,-0.02481638,0.03512426,0.00165911,0.03037135,0.0345118,0.08658017,0.03865113,0.02868007,0.05793625,-0.07104596,-0.00975614,0.00893481,-0.00624011,0.05372698,-0.03075249,0.00031608,-0.03389125,0.11965014,-0.0105956,0.0282056,-0.09270198,-0.00359134,0.01290524,-0.01940317,-0.01820189,-0.00804522,-0.01143565,0.05010622,-0.03412503,-0.00456591,-0.01036297,-0.03832177,-0.03329051,0.05650277,-0.00331425,0.04350932,0.03881015,-0.03484463],"last_embed":{"hash":"1botouy","tokens":410}}},"last_read":{"hash":"1botouy","at":1774939538025},"class_name":"SmartSource","last_import":{"mtime":1774939523281,"size":3331,"at":1774939536675,"hash":"1botouy"},"blocks":{"#---frontmatter---":[1,18],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval":[20,44],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#{1}":[21,25],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#📝 Benim Notlarım":[26,30],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#📝 Benim Notlarım#{1}":[27,28],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#📝 Benim Notlarım#{2}":[29,30],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟡 Genel Bilgiler (Sarı)":[31,33],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟢 Yöntem & Örneklem (Yeşil)":[34,36],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟢 Yöntem & Örneklem (Yeşil)#{1}":[35,36],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔴 Bulgular (Kırmızı)":[37,39],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔴 Bulgular (Kırmızı)#{1}":[38,39],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔵 Sonuç / Conclusions (Mavi)":[40,42],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🔵 Sonuç / Conclusions (Mavi)#{1}":[41,42],"#Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval#🟠 Limitasyonlar (Turuncu)":[43,44]},"outlinks":[{"title":"Görüntüle","target":"zotero://select/library/items/39JP5FYC","line":22},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5MMDHYPG?page=1&annotation=FV4PYSPB","line":35},{"title":"Sayfa 10","target":"zotero://open-pdf/library/items/5MMDHYPG?page=10&annotation=7PG9WDTK","line":35},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5MMDHYPG?page=1&annotation=XA4KF2D8","line":38},{"title":"Sayfa 1","target":"zotero://open-pdf/library/items/5MMDHYPG?page=1&annotation=8N6UHE52","line":41}],"metadata":{"Title":"Evaluation of LLMs accuracy and consistency in the registered dietitian exam through prompt engineering and knowledge retrieval","Authors":"Iman Azimi, Mohan Qi, Li Wang, Amir M. Rahmani, Youlin Li","Year":2025,"DOI":"10.1038/s41598-024-85003-w","Nitelik":null,"Alan":null,"Konu":null,"AI_Methodology":null,"Layer_Focus":null,"Model_Asamasi":null,"Proposed_Tool":null,"Methods":"In this paper, we propose to employ the Registered Dietitian (RD) exam to conduct a standard and comprehensive evaluation of state-of-the-art LLMs, GPT-4o, Claude 3.5 Sonnet, and Gemini 1.5 Pro, assessing both accuracy and consistency in nutrition queries.techniques: 1) Zero Shot prompting (ZS), 2) Chain of Thought (CoT), 3) Chain of Thought with Self Consistency (CoT-SC), and 4) Retrieval Augmented Prompting (RAP) enabled by external nutrition knowledge.","Findings":"Our findings revealed that while these LLMs obtained acceptable overall performance, their results varied considerably with different prompts and question domains.  GPT-4o with CoT-SC prompting outperformed the other approaches, whereas Gemini 1.5 Pro with ZS recorded the highest consistenc","Conclusions":"Consequently, choosing the appropriate LLM and prompting technique, tailored to the proficiency level and specific domain, can mitigate errors and potential risks in diet and nutrition chatbots.","Limitations":"","User_Notes":"prompt görmedim ama gerekli.  dyt karşılaştırmasından emin olamadım."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1botouy","at":1774939537880}},"smart_blocks:Augmented Dietitian Okunmuşlar/azimiEvaluationLLMsAccuracy2025b.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07828602,0.00067168,-0.02348695,0.01565368,-0.01867226,-0.01639588,-0.01557599,0.04288582,0.01830064,-0.03147482,-0.03626957,-0.10669546,0.04096772,0.03679055,0.0349026,-0.00550004,0.03071937,0.03284675,0.00426881,0.02685696,0.04627861,-0.05827411,0.04217844,0.01858997,0.07343568,-0.00922181,-0.02892077,-0.0223909,-0.06249425,-0.26987919,0.04185656,-0.02437801,0.04672069,-0.03547207,-0.08235659,0.03138803,-0.02897812,0.03127087,-0.0135967,-0.00505605,0.07339244,0.03493313,-0.01048275,-0.01223793,-0.02336179,-0.06537736,-0.02599455,-0.009891,-0.06716508,0.00223004,-0.00572014,-0.0401806,0.0599299,0.00122748,0.01964061,0.03386732,0.03942378,0.05449517,0.01536077,0.0353711,0.03855544,0.07810682,-0.24307945,0.10018791,0.02203045,0.03653465,-0.04174853,0.00646364,0.00916093,-0.02587784,-0.02758039